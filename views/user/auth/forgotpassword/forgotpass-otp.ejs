<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTP Verification - Elanora</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #FDF7F0;
            --footer-bg: #F9F1E7;
            --primary-gold: #BC984D;
            --primary-gold-faded: #DCC9A1;
            --text-dark: #333333;
            --text-light: #777777;
            --border-color: #E0E0E0;
            --error-color: #d8000c;
            --success-color: #155724;
            /* Home-page Footer Variables */
            --cream: #f9f5ef;
            --warm-white: #fdfaf5;
            --gold: #c8972a;
            --gold-light: #e4b84a;
            --gold-pale: #f0ddb0;
            --dark: #1a1612;
            --text: #3a3228;
            --muted: #8c7f70;
            --border: #e8ddd0;
            --radius: 12px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .error-message,
        .success-message {
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 0.85rem;
            margin-bottom: 20px;
            text-align: center;
        }

        .error-message {
            background-color: #ffe5e5;
            color: var(--error-color);
        }

        .success-message {
            background-color: #d4edda;
            color: var(--success-color);
        }

        .content-wrapper {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        .otp-card {
            background: white;
            width: 100%;
            max-width: 440px;
            padding: 45px 35px;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
            text-align: center;
        }

        .logo-box {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: var(--primary-gold);
            font-weight: 600;
            margin-bottom: 20px;
        }

        h1 {
            font-size: 1.4rem;
            color: var(--text-dark);
            margin-bottom: 10px;
        }

        .instructions {
            color: var(--text-light);
            font-size: 0.8rem;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .user-email {
            font-weight: 600;
            color: var(--text-dark);
        }

        .otp-inputs {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 30px;
        }

        .otp-field {
            width: 45px;
            height: 50px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            text-align: center;
            font-size: 1.2rem;
            font-weight: 500;
            outline: none;
            transition: border-color 0.2s;
        }

        .otp-field:focus {
            border-color: var(--primary-gold);
        }

        .btn-continue {
            background-color: var(--primary-gold-faded);
            color: white;
            border: none;
            width: 100%;
            padding: 14px;
            border-radius: 30px;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 25px;
        }

        .btn-continue:disabled {
            opacity: 0.75;
            cursor: not-allowed;
        }

        .resend-container {
            font-size: 0.8rem;
            color: var(--text-light);
            margin-bottom: 20px;
        }

        .resend-link {
            color: var(--primary-gold);
            text-decoration: none;
            font-weight: 500;
            cursor: pointer;
        }

        .resend-link.disabled {
            color: #999;
            cursor: not-allowed;
            pointer-events: none;
        }

        .timer {
            color: var(--primary-gold);
            font-weight: 600;
        }

        .different-email {
            font-size: 0.8rem;
            color: var(--text-light);
            text-decoration: none;
        }

        footer {
            background-color: var(--footer-bg);
            padding: 60px 8% 30px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr 1.5fr;
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-col h4 {
            font-size: 0.85rem;
            margin-bottom: 20px;
            color: var(--text-dark);
        }

        .footer-col p,
        .footer-col li {
            font-size: 0.8rem;
            color: var(--text-light);
            list-style: none;
            line-height: 1.6;
            margin-bottom: 10px;
        }

        .social-icons {
            display: flex;
            gap: 12px;
            margin-top: 15px;
        }

        .social-icon {
            width: 30px;
            height: 30px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--border-color);
            font-size: 0.75rem;
        }

        .newsletter-input {
            width: 100%;
            padding: 10px 15px;
            border-radius: 25px;
            border: 1px solid var(--border-color);
            margin-bottom: 10px;
        }

        .btn-subscribe {
            background: var(--primary-gold);
            color: white;
            border: none;
            width: 100%;
            padding: 10px;
            border-radius: 25px;
            cursor: pointer;
        }

        .footer-bottom {
            border-top: 1px solid rgba(0, 0, 0, 0.05);
            padding-top: 20px;
            display: flex;
            justify-content: space-between;
            font-size: 0.7rem;
            color: var(--text-light);
        }

        @media (max-width: 850px) {
            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
</head>

<body>

    <div class="content-wrapper">
        <div class="otp-card">
            <div class="logo-box">
               Elanora
            </div>
            <h1>Reset Password</h1>
            <p class="instructions">Enter the 6-digit code sent to<br><span class="user-email">as***@gmail.com</span>
            </p>



            <form id="otpForm" method="post" action="/forgotpassword-otpverify" novalidate>

                <div class="otp-inputs" id="otpInputs">
                    <input type="text" class="otp-field" maxlength="1" inputmode="numeric">
                    <input type="text" class="otp-field" maxlength="1" inputmode="numeric">
                    <input type="text" class="otp-field" maxlength="1" inputmode="numeric">
                    <input type="text" class="otp-field" maxlength="1" inputmode="numeric">
                    <input type="text" class="otp-field" maxlength="1" inputmode="numeric">
                    <input type="text" class="otp-field" maxlength="1" inputmode="numeric">
                </div>

                <!-- Hidden Input -->
                <input type="hidden" name="otp" id="otpValue">

                <button type="submit" id="submitBtn" class="btn-continue">
                    Continue to Reset <span>→</span>
                </button>

            </form>

            <div class="resend-container">
                Didn't receive the code?
                <span id="resendLink" class="resend-link">Resend OTP</span>
                <span id="timerContainer" style="display: none;"> in <span id="timer" class="timer">60</span>s</span>
            </div>

            <a href="/forgotpassword" class="different-email">Use a different email</a>
        </div>
    </div>

    <%- include('../../../partials/user/footer') %>

    <script>
        const form = document.getElementById('otpForm');
        const otpFields = document.querySelectorAll('.otp-field');
        const submitBtn = document.getElementById('submitBtn');
        const otpValue = document.getElementById('otpValue');

        const resendLink = document.getElementById('resendLink');
        const timerContainer = document.getElementById('timerContainer');
        const timerDisplay = document.getElementById('timer');

        const TIMER_DURATION = 60;
        let timeLeft = TIMER_DURATION;
        let timerInterval = null;

        otpFields.forEach((field, index) => {
            field.addEventListener('input', () => {
                if (field.value.length === 1 && index < otpFields.length - 1) {
                    otpFields[index + 1].focus();
                }
            });

            field.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && field.value === '' && index > 0) {
                    otpFields[index - 1].focus();
                }
            });
        });

        function validateOTP() {
            let isComplete = true;

            otpFields.forEach(field => {
                if (field.value.trim() === '' || isNaN(field.value)) {
                    isComplete = false;
                    field.style.borderColor = '#d8000c';
                } else {
                    field.style.borderColor = '';
                }
            });

            return isComplete;
        }

        function getOTP() {
            let otp = '';
            otpFields.forEach(field => {
                otp += field.value;
            });
            return otp;
        }

        function startTimer(fresh = true) {
            if (fresh) {
                // Store the timestamp when the timer was started
                sessionStorage.setItem('forgotOtpTimerStart', Date.now().toString());
                timeLeft = TIMER_DURATION;
            } else {
                // Calculate remaining time based on when the timer was originally started
                const startTime = parseInt(sessionStorage.getItem('forgotOtpTimerStart') || '0', 10);
                const elapsed = Math.floor((Date.now() - startTime) / 1000);
                timeLeft = Math.max(TIMER_DURATION - elapsed, 0);
            }

            if (timerInterval) clearInterval(timerInterval);

            if (timeLeft <= 0) {
                // Timer already expired — show resend link immediately
                timerContainer.style.display = 'none';
                resendLink.classList.remove('disabled');
                return;
            }

            timerDisplay.textContent = timeLeft;
            timerContainer.style.display = 'inline';
            resendLink.classList.add('disabled');

            timerInterval = setInterval(() => {
                timeLeft--;
                timerDisplay.textContent = timeLeft;

                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    timerContainer.style.display = 'none';
                    resendLink.classList.remove('disabled');
                }
            }, 1000);
        }

        resendLink.addEventListener('click', async () => {
            if (resendLink.classList.contains('disabled')) return;

            try {
                // Show Loading State
                resendLink.textContent = 'Sending...';
                resendLink.classList.add('disabled');

                const response = await fetch('/resend-otp', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                const data = await response.json();

                if (data.success) {
                    if (typeof window.showToast === 'function') {
                        window.showToast("New OTP has been sent!", "success");
                    } else {
                        alert("New OTP has been sent!");
                    }
                    // fresh=true resets the timer (new OTP was sent)
                    startTimer(true);
                } else {
                    throw new Error(data.message || "Failed to resend OTP");
                }
            } catch (err) {
                console.error(err);
                if (typeof window.showToast === 'function') {
                    window.showToast(err.message || "Something went wrong", "error");
                } else {
                    alert(err.message || "Something went wrong");
                }
                resendLink.textContent = 'Resend OTP';
                resendLink.classList.remove('disabled');
            }
        });

        form.addEventListener('submit', function (e) {
            if (!validateOTP()) {
                e.preventDefault();
                return;
            }

            const otp = getOTP();
            otpValue.value = otp;

            submitBtn.disabled = true;
            submitBtn.innerHTML = `Verifying ⟳`;
        });

        document.getElementById('otpInputs').addEventListener('paste', (e) => {
            const pasteData = e.clipboardData.getData('text').trim();

            if (/^\d{6}$/.test(pasteData)) {
                otpFields.forEach((field, i) => {
                    field.value = pasteData[i];
                });
                otpFields[5].focus();
            }
        });

        window.onload = () => {
            // If there's no stored timer start, this is a fresh visit — start fresh.
            // If there is one, resume from wherever the timer left off (e.g. after invalid OTP).
            const hasExistingTimer = sessionStorage.getItem('forgotOtpTimerStart') !== null;
            startTimer(!hasExistingTimer);
        };
    </script>

    <%- include('../../../partials/user/flash') %>
</body>

</html>