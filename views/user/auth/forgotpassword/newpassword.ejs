<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Password - Elanora</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #FDF7F0;
            --footer-bg: #F9F1E7;
            --primary-gold: #BC984D;
            --text-dark: #333333;
            --text-light: #777777;
            --border-color: #E0E0E0;
            --error-color: #d8000c;
            --success-color: #155724;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .error-message,
        .success-message {
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 0.85rem;
            margin-bottom: 20px;
            text-align: center;
        }

        .error-message {
            background-color: #ffe5e5;
            color: var(--error-color);
        }

        .success-message {
            background-color: #d4edda;
            color: var(--success-color);
        }

        .field-error {
            color: var(--error-color);
            font-size: 0.8rem;
            margin-top: 5px;
            display: none;
        }

        .input-error {
            border-color: var(--error-color) !important;
        }

        .content-wrapper {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        .password-card {
            background: white;
            width: 100%;
            max-width: 440px;
            padding: 45px 35px;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.04);
            text-align: center;
        }

        .logo-box {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: var(--primary-gold);
            font-weight: 600;
            margin-bottom: 20px;
        }

        h1 {
            font-size: 1.4rem;
            color: var(--text-dark);
            margin-bottom: 10px;
        }

        .instructions {
            color: var(--text-light);
            font-size: 0.8rem;
            line-height: 1.5;
            margin-bottom: 30px;
            padding: 0 20px;
        }

        .form-group {
            text-align: left;
            margin-bottom: 18px;
        }

        label {
            display: block;
            font-size: 0.75rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--text-dark);
        }

        input {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            outline: none;
            font-size: 0.9rem;
            transition: border-color 0.2s;
        }

        input:focus {
            border-color: var(--primary-gold);
        }

        .btn-reset {
            background-color: var(--primary-gold);
            color: white;
            border: none;
            width: 100%;
            padding: 14px;
            border-radius: 30px;
            font-size: 0.95rem;
            font-weight: 500;
            cursor: pointer;
            margin-top: 15px;
            transition: opacity 0.3s;
        }

        .btn-reset:disabled {
            opacity: 0.75;
            cursor: not-allowed;
        }

        footer {
            background-color: var(--footer-bg);
            padding: 60px 8% 30px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr 1.5fr;
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-col h4 {
            font-size: 0.85rem;
            margin-bottom: 20px;
            color: var(--text-dark);
        }

        .footer-col p,
        .footer-col li {
            font-size: 0.8rem;
            color: var(--text-light);
            list-style: none;
            line-height: 1.6;
            margin-bottom: 10px;
        }

        .social-icons {
            display: flex;
            gap: 12px;
            margin-top: 15px;
        }

        .social-icon {
            width: 30px;
            height: 30px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--border-color);
            font-size: 0.75rem;
        }

        .newsletter-input {
            width: 100%;
            padding: 12px 15px;
            border-radius: 25px;
            border: 1px solid var(--border-color);
            margin-bottom: 10px;
        }

        .btn-subscribe {
            background: var(--primary-gold);
            color: white;
            border: none;
            width: 100%;
            padding: 10px;
            border-radius: 25px;
            cursor: pointer;
        }

        .footer-bottom {
            border-top: 1px solid rgba(0,0,0,0.05);
            padding-top: 20px;
            display: flex;
            justify-content: space-between;
            font-size: 0.7rem;
            color: var(--text-light);
        }

        @media (max-width: 850px) {
            .footer-grid { grid-template-columns: 1fr 1fr; }
        }
    </style>
</head>
<body>

    <div class="content-wrapper">
        <div class="password-card">
            <div class="logo-box">
                <span>💎</span> Elanora
            </div>
            <h1>Create New Password</h1>
            <p class="instructions">Your new password must be different from previously used passwords.</p>



            <form method="post" action="/newpassword" id="passwordForm" novalidate>
                <div class="form-group">
                    <label>New Password</label>
                    <input type="password" 
                           id="newPassword" 
                           name="newPassword" 
                           placeholder="Enter new password"
                           required>
                    <div id="newPasswordError" class="field-error"></div>
                </div>
                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password" 
                           id="confirmPassword" 
                           name="confirmPassword" 
                           placeholder="Confirm new password"
                           required>
                    <div id="confirmPasswordError" class="field-error"></div>
                </div>
                <button type="submit" id="submitBtn" class="btn-reset">Reset Password</button>
            </form>
        </div>
    </div>

    <footer>
        <!-- Your footer remains the same -->
        <div class="footer-grid">
            <div class="footer-col">
                <div class="logo-box" style="justify-content: flex-start; margin-bottom: 15px;">💎 Elanora</div>
                <p>Crafting timeless elegance and radiant refinement for those who appreciate the finer things in life.</p>
                <div class="social-icons">
                    <div class="social-icon">f</div>
                    <div class="social-icon">𝕏</div>
                    <div class="social-icon">📸</div>
                    <div class="social-icon">▶</div>
                </div>
            </div>
            <div class="footer-col">
                <h4>Quick Links</h4>
                <ul><li>Shop Collection</li><li>About Us</li><li>Our Story</li><li>Contact Us</li></ul>
            </div>
            <div class="footer-col">
                <h4>Customer Service</h4>
                <ul><li>FAQ</li><li>Shipping & Returns</li><li>Jewelry Care</li><li>Terms & Conditions</li></ul>
            </div>
            <div class="footer-col">
                <h4>Newsletter</h4>
                <p>Subscribe to receive updates, access to exclusive deals, and more.</p>
                <input type="email" class="newsletter-input" placeholder="Enter your email">
                <button class="btn-subscribe">Subscribe</button>
            </div>
        </div>
        <div class="footer-bottom">
            <div>© 2026 Elanora Jewelry. All rights reserved.</div>
            <div>Privacy Policy &nbsp;&nbsp; Terms of Service</div>
        </div>
    </footer>

    <script>
        const form = document.getElementById('passwordForm');
        const newPassword = document.getElementById('newPassword');
        const confirmPassword = document.getElementById('confirmPassword');
        const newPasswordError = document.getElementById('newPasswordError');
        const confirmPasswordError = document.getElementById('confirmPasswordError');
        const submitBtn = document.getElementById('submitBtn');

        function validateNewPassword() {
            const value = newPassword.value.trim();
            let error = '';

            if (value === '') {
                error = 'New password is required';
            } else if (value.length < 8) {
                error = 'Password must be at least 8 characters long';
            } else if (!/[A-Z]/.test(value)) {
                error = 'Password must contain at least one uppercase letter';
            } else if (!/[a-z]/.test(value)) {
                error = 'Password must contain at least one lowercase letter';
            } else if (!/[0-9]/.test(value)) {
                error = 'Password must contain at least one number';
            }

            if (error) {
                newPasswordError.textContent = error;
                newPasswordError.style.display = 'block';
                newPassword.classList.add('input-error');
                return false;
            } else {
                newPasswordError.style.display = 'none';
                newPassword.classList.remove('input-error');
                return true;
            }
        }

        function validateConfirmPassword() {
            const newPass = newPassword.value.trim();
            const confirmPass = confirmPassword.value.trim();

            if (confirmPass === '') {
                confirmPasswordError.textContent = 'Please confirm your password';
                confirmPasswordError.style.display = 'block';
                confirmPassword.classList.add('input-error');
                return false;
            } else if (confirmPass !== newPass) {
                confirmPasswordError.textContent = 'Passwords do not match';
                confirmPasswordError.style.display = 'block';
                confirmPassword.classList.add('input-error');
                return false;
            } else {
                confirmPasswordError.style.display = 'none';
                confirmPassword.classList.remove('input-error');
                return true;
            }
        }

        // Real-time validation
        newPassword.addEventListener('input', () => {
            validateNewPassword();
            if (confirmPassword.value) validateConfirmPassword();
        });

        confirmPassword.addEventListener('input', validateConfirmPassword);

        // Form Submit
        form.addEventListener('submit', function (e) {
            const isNewValid = validateNewPassword();
            const isConfirmValid = validateConfirmPassword();

            if (!isNewValid || !isConfirmValid) {
                e.preventDefault();   // Stop submission if validation fails
                return;
            }

            // If validation passes, allow normal form submission
            // Do NOT call e.preventDefault() here
            submitBtn.disabled = true;
            submitBtn.textContent = 'Resetting Password...';
        });
    </script>

    <%- include('../../../partials/user/flash') %>
</body>
</html>