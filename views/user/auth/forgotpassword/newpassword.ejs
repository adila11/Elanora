<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Password - Elanora</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #FDF7F0;
            --footer-bg: #F9F1E7;
            --primary-gold: #BC984D;
            --text-dark: #333333;
            --text-light: #777777;
            --border-color: #E0E0E0;
            --error-color: #d8000c;
            --success-color: #155724;
            /* Home-page Footer Variables */
            --cream: #f9f5ef;
            --warm-white: #fdfaf5;
            --gold: #c8972a;
            --gold-light: #e4b84a;
            --gold-pale: #f0ddb0;
            --dark: #1a1612;
            --text: #3a3228;
            --muted: #8c7f70;
            --border: #e8ddd0;
            --radius: 12px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .error-message,
        .success-message {
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 0.85rem;
            margin-bottom: 20px;
            text-align: center;
        }

        .error-message {
            background-color: #ffe5e5;
            color: var(--error-color);
        }

        .success-message {
            background-color: #d4edda;
            color: var(--success-color);
        }

        .field-error {
            color: var(--error-color);
            font-size: 0.8rem;
            margin-top: 5px;
            display: none;
        }

        .input-error {
            border-color: var(--error-color) !important;
        }

        .content-wrapper {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        .password-card {
            background: white;
            width: 100%;
            max-width: 440px;
            padding: 45px 35px;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.04);
            text-align: center;
        }

        .logo-box {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: var(--primary-gold);
            font-weight: 600;
            margin-bottom: 20px;
        }

        h1 {
            font-size: 1.4rem;
            color: var(--text-dark);
            margin-bottom: 10px;
        }

        .instructions {
            color: var(--text-light);
            font-size: 0.8rem;
            line-height: 1.5;
            margin-bottom: 30px;
            padding: 0 20px;
        }

        .form-group {
            text-align: left;
            margin-bottom: 18px;
        }

        label {
            display: block;
            font-size: 0.75rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--text-dark);
        }

        input {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            outline: none;
            font-size: 0.9rem;
            transition: border-color 0.2s;
        }

        input:focus {
            border-color: var(--primary-gold);
        }

        .btn-reset {
            background-color: var(--primary-gold);
            color: white;
            border: none;
            width: 100%;
            padding: 14px;
            border-radius: 30px;
            font-size: 0.95rem;
            font-weight: 500;
            cursor: pointer;
            margin-top: 15px;
            transition: opacity 0.3s;
        }

        .btn-reset:disabled {
            opacity: 0.75;
            cursor: not-allowed;
        }

        /* Password Wrapper + Eye Toggle */
        .pw-wrap {
            position: relative;
        }
        .pw-wrap input {
            padding-right: 44px !important;
        }
        .eye-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
            display: flex;
            align-items: center;
            color: #bbb;
            transition: color 0.2s;
        }
        .eye-btn:hover { color: var(--primary-gold); }
        .eye-btn svg { width: 18px; height: 18px; display: block; }

        footer {
            background-color: var(--footer-bg);
            padding: 60px 8% 30px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr 1.5fr;
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-col h4 {
            font-size: 0.85rem;
            margin-bottom: 20px;
            color: var(--text-dark);
        }

        .footer-col p,
        .footer-col li {
            font-size: 0.8rem;
            color: var(--text-light);
            list-style: none;
            line-height: 1.6;
            margin-bottom: 10px;
        }

        .social-icons {
            display: flex;
            gap: 12px;
            margin-top: 15px;
        }

        .social-icon {
            width: 30px;
            height: 30px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--border-color);
            font-size: 0.75rem;
        }

        .newsletter-input {
            width: 100%;
            padding: 12px 15px;
            border-radius: 25px;
            border: 1px solid var(--border-color);
            margin-bottom: 10px;
        }

        .btn-subscribe {
            background: var(--primary-gold);
            color: white;
            border: none;
            width: 100%;
            padding: 10px;
            border-radius: 25px;
            cursor: pointer;
        }

        .footer-bottom {
            border-top: 1px solid rgba(0,0,0,0.05);
            padding-top: 20px;
            display: flex;
            justify-content: space-between;
            font-size: 0.7rem;
            color: var(--text-light);
        }

        @media (max-width: 850px) {
            .footer-grid { grid-template-columns: 1fr 1fr; }
        }
    </style>
</head>
<body>

    <div class="content-wrapper">
        <div class="password-card">
            <div class="logo-box">
                 Elanora
            </div>
            <h1>Create New Password</h1>
            <p class="instructions">Your new password must be different from previously used passwords.</p>



            <form method="post" action="/newpassword" id="passwordForm" novalidate>
                <div class="form-group">
                    <label>New Password</label>
                    <div class="pw-wrap">
                        <input type="password"
                               id="newPassword"
                               name="newPassword"
                               placeholder="Enter new password"
                               required>
                        <button type="button" class="eye-btn" id="toggleNew" aria-label="Toggle password visibility">
                            <svg id="eyeNew" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                        </button>
                    </div>
                    <div id="newPasswordError" class="field-error"></div>
                </div>
                <div class="form-group">
                    <label>Confirm Password</label>
                    <div class="pw-wrap">
                        <input type="password"
                               id="confirmPassword"
                               name="confirmPassword"
                               placeholder="Confirm new password"
                               required>
                        <button type="button" class="eye-btn" id="toggleConfirm" aria-label="Toggle confirm password visibility">
                            <svg id="eyeConfirm" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                        </button>
                    </div>
                    <div id="confirmPasswordError" class="field-error"></div>
                </div>
                <button type="submit" id="submitBtn" class="btn-reset">Reset Password</button>
            </form>
        </div>
    </div>

    <%- include('../../../partials/user/footer') %>

    <script>
        const form = document.getElementById('passwordForm');
        const newPassword = document.getElementById('newPassword');
        const confirmPassword = document.getElementById('confirmPassword');
        const newPasswordError = document.getElementById('newPasswordError');
        const confirmPasswordError = document.getElementById('confirmPasswordError');
        const submitBtn = document.getElementById('submitBtn');

        function validateNewPassword() {
            const value = newPassword.value.trim();
            let error = '';

            if (value === '') {
                error = 'New password is required';
            } else if (value.length < 8) {
                error = 'Password must be at least 8 characters long';
            } else if (!/[A-Z]/.test(value)) {
                error = 'Password must contain at least one uppercase letter';
            } else if (!/[a-z]/.test(value)) {
                error = 'Password must contain at least one lowercase letter';
            } else if (!/[0-9]/.test(value)) {
                error = 'Password must contain at least one number';
            }

            if (error) {
                newPasswordError.textContent = error;
                newPasswordError.style.display = 'block';
                newPassword.classList.add('input-error');
                return false;
            } else {
                newPasswordError.style.display = 'none';
                newPassword.classList.remove('input-error');
                return true;
            }
        }

        function validateConfirmPassword() {
            const newPass = newPassword.value.trim();
            const confirmPass = confirmPassword.value.trim();

            if (confirmPass === '') {
                confirmPasswordError.textContent = 'Please confirm your password';
                confirmPasswordError.style.display = 'block';
                confirmPassword.classList.add('input-error');
                return false;
            } else if (confirmPass !== newPass) {
                confirmPasswordError.textContent = 'Passwords do not match';
                confirmPasswordError.style.display = 'block';
                confirmPassword.classList.add('input-error');
                return false;
            } else {
                confirmPasswordError.style.display = 'none';
                confirmPassword.classList.remove('input-error');
                return true;
            }
        }

        // Eye Toggles
        const EYE_OPEN  = `<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>`;
        const EYE_SLASH = `<path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88L6.59 6.59m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>`;

        function makeToggle(btnId, inputEl, iconId) {
            let visible = false;
            document.getElementById(btnId).addEventListener('click', () => {
                visible = !visible;
                inputEl.type = visible ? 'text' : 'password';
                document.getElementById(iconId).innerHTML = visible ? EYE_SLASH : EYE_OPEN;
            });
        }
        makeToggle('toggleNew',     newPassword,     'eyeNew');
        makeToggle('toggleConfirm', confirmPassword, 'eyeConfirm');

        // Real-time Validation
        newPassword.addEventListener('input', () => {
            validateNewPassword();
            if (confirmPassword.value) validateConfirmPassword();
        });

        confirmPassword.addEventListener('input', validateConfirmPassword);

        // Form Submit
        form.addEventListener('submit', function (e) {
            const isNewValid = validateNewPassword();
            const isConfirmValid = validateConfirmPassword();

            if (!isNewValid || !isConfirmValid) {
                e.preventDefault();   // Stop submission if validation fails
                return;
            }

            // If Validation Passes, Allow Normal Form Submission Do NOT Call E.preventdefault() Here
            submitBtn.disabled = true;
            submitBtn.textContent = 'Resetting Password...';
        });
    </script>

    <%- include('../../../partials/user/flash') %>
</body>
</html>