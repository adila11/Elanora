<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Email - Elanora</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #FDF7F0;
            --footer-bg: #F9F1E7;
            --primary-gold: #BC984D;
            --primary-gold-light: #DCC9A1;
            --text-dark: #333333;
            --text-light: #777777;
            --border-color: #E0E0E0;
            /* Home-page Footer Variables */
            --cream: #f9f5ef;
            --warm-white: #fdfaf5;
            --gold: #c8972a;
            --gold-light: #e4b84a;
            --gold-pale: #f0ddb0;
            --dark: #1a1612;
            --text: #3a3228;
            --muted: #8c7f70;
            --border: #e8ddd0;
            --radius: 12px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .content-wrapper {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        .otp-card {
            background: white;
            width: 100%;
            max-width: 440px;
            padding: 45px 35px;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.04);
            text-align: center;
        }

        .logo-box {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: var(--primary-gold);
            font-weight: 600;
            margin-bottom: 20px;
        }

        h1 {
            font-size: 1.4rem;
            color: var(--text-dark);
            margin-bottom: 10px;
        }

        .instructions {
            color: var(--text-light);
            font-size: 0.75rem;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .user-email {
            font-weight: 600;
            color: var(--text-dark);
        }

        .otp-inputs {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-bottom: 30px;
        }

        .otp-field {
            width: 42px;
            height: 48px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            text-align: center;
            font-size: 1.2rem;
            outline: none;
            transition: border-color 0.2s;
        }

        .otp-field:focus {
            border-color: var(--primary-gold);
        }

        .btn-verify {
            background-color: var(--primary-gold-light);
            color: white;
            border: none;
            width: 100%;
            padding: 14px;
            border-radius: 30px;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            margin-bottom: 25px;
        }

        .resend-text {
            font-size: 0.7rem;
            color: var(--text-light);
            margin-bottom: 12px;
        }

        .timer {
            color: var(--primary-gold);
            font-weight: 600;
        }

        .wrong-email {
            font-size: 0.7rem;
            color: var(--text-light);
            text-decoration: none;
        }

        .resend-link {
            color: var(--primary-gold);
            font-weight: 600;
            text-decoration: underline;
            cursor: pointer;
        }

        .resend-link:hover {
            color: #A67C3D;
        }


    </style>
</head>

<body>

<div class="content-wrapper">
    <div class="otp-card">
        <div class="logo-box"> Elanora</div>

        <h1>Verify Your Email</h1>
        <p class="instructions">
            We've sent a 6-digit code to<br>
            <span class="user-email">as***@gmail.com</span>
        </p>

        <form method="POST" action="/signup-verification">

            <!-- Hidden Otp -->
            <input type="hidden" name="otp" id="otp">

            <div class="otp-inputs">
                <input type="text" class="otp-field" maxlength="1">
                <input type="text" class="otp-field" maxlength="1">
                <input type="text" class="otp-field" maxlength="1">
                <input type="text" class="otp-field" maxlength="1">
                <input type="text" class="otp-field" maxlength="1">
                <input type="text" class="otp-field" maxlength="1">
            </div>

            <button type="submit" class="btn-verify">Verify →</button>
        </form>

        <div class="resend-text">
            Didn't receive the code? Resend in <span class="timer">25s</span>
        </div>

        <a href="#" class="wrong-email">Wrong email? Contact us</a>
    </div>
</div>

<%- include('../../../partials/user/footer') %>

<!-- ✅ SCRIPT -->
<script>
    const inputs = document.querySelectorAll(".otp-field");
    const form = document.querySelector("form");
    const hiddenOtp = document.getElementById("otp");
    const resendText = document.querySelector(".resend-text");
    let timerInterval = null;
    let timeLeft = 25;

    // OTP Input Handling
    inputs.forEach((input, index) => {
        // Only Numbers
        input.addEventListener("input", (e) => {
            input.value = input.value.replace(/[^0-9]/g, "");

            if (input.value && inputs[index + 1]) {
                inputs[index + 1].focus();
            }
        });

        // Backspace Move
        input.addEventListener("keydown", (e) => {
            if (e.key === "Backspace" && !input.value && inputs[index - 1]) {
                inputs[index - 1].focus();
            }
        });
    });

    // Form Submit - Combine OTP
    form.addEventListener("submit", (e) => {
        let otp = "";

        inputs.forEach(input => {
            otp += input.value;
        });

        if (otp.length !== 6) {
            e.preventDefault();
            if (typeof window.showToast === 'function') {
                window.showToast("Enter full 6-digit OTP", "error");
            } else {
                alert("Enter full 6-digit OTP");
            }
            return;
        }

        hiddenOtp.value = otp;
    });

    // TIMER + RESEND FUNCTIONALITY
    function updateResendUI() {
        if (timeLeft > 0) {
            resendText.innerHTML = `Didn't receive the code? Resend in <span class="timer">${timeLeft}s</span>`;
        } else {
            resendText.innerHTML = `Didn't receive the code? <span class="resend-link" id="resend-btn">Resend OTP</span>`;
            
            const resendBtn = document.getElementById("resend-btn");
            if (resendBtn) {
                resendBtn.addEventListener("click", handleResend);
            }
        }
    }

    function startTimer() {
        // Clear Any Existing Interval
        if (timerInterval) {
            clearInterval(timerInterval);
        }

        timeLeft = 25;
        updateResendUI();

        timerInterval = setInterval(() => {
            timeLeft--;
            updateResendUI();

            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                timerInterval = null;
            }
        }, 1000);
    }

    function handleResend(e) {
        if (e) e.preventDefault();

        // Show Loading State
        resendText.innerHTML = `Sending new OTP...`;
        
        // Call Backend To Resend OTP
        fetch('/resend-otp', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            credentials: 'same-origin'
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                if (typeof window.showToast === 'function') {
                    window.showToast("New OTP has been sent to your email!", "success");
                } else {
                    alert("New OTP has been sent to your email!");
                }
                
                // Restart The 25-second Cooldown
                startTimer();
            } else {
                const errorMsg = data.message || "Failed to resend OTP. Please try again.";
                if (typeof window.showToast === 'function') {
                    window.showToast(errorMsg, "error");
                } else {
                    alert(errorMsg);
                }
                // Restore UI
                updateResendUI();
            }
        })
        .catch(error => {
            console.error("Resend OTP error:", error);
            if (typeof window.showToast === 'function') {
                window.showToast("Something went wrong. Please try again later.", "error");
            } else {
                alert("Something went wrong. Please try again later.");
            }
            // Restore The Resend Button
            updateResendUI();
        });
    }

    // Start The Countdown Timer Immediately When Page Loads
    window.addEventListener("load", () => {
        startTimer();
    });

    // Bonus: Allow Pressing Enter In OTP Fields To Submit
    inputs.forEach((input, index) => {
        input.addEventListener("keypress", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                form.dispatchEvent(new Event("submit"));
            }
        });
    });
</script>

<%- include('../../../partials/user/flash') %>
</body>
</html>