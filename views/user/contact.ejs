<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Contact Us – Elanora Luxury Jewelry</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cream: #f9f5ef;
      --warm-white: #fdfaf5;
      --gold: #c8972a;
      --gold-light: #e4b84a;
      --gold-pale: #f0ddb0;
      --dark: #1a1612;
      --text: #3a3228;
      --muted: #8c7f70;
      --border: #e8ddd0;
      --radius: 12px;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Jost', sans-serif;
      background: var(--warm-white);
      color: var(--text);
      overflow-x: hidden;
    }

    /* HERO */
    .page-hero {
      background: var(--cream);
      padding: 100px 60px 80px;
      text-align: center;
      position: relative;
      overflow: hidden;
      animation: fadeUp .8s ease both;
    }
    .page-hero::before {
      content: '';
      position: absolute;
      top: -60px; left: 50%; transform: translateX(-50%);
      width: 600px; height: 600px; border-radius: 50%;
      background: radial-gradient(circle, var(--gold-pale) 0%, transparent 70%);
      opacity: .4; pointer-events: none;
    }
    .page-hero-breadcrumb {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 12px; color: var(--muted); margin-bottom: 20px;
    }
    .page-hero-breadcrumb span { color: var(--gold); }
    .page-hero-breadcrumb svg { width: 12px; height: 12px; stroke: var(--muted); fill: none; stroke-width: 2; }
    .page-hero h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(42px, 5vw, 64px);
      font-weight: 400; line-height: 1.15;
      color: var(--dark); margin-bottom: 16px;
    }
    .page-hero h1 span { color: var(--gold); font-style: italic; }
    .page-hero p {
      font-size: 13px; color: var(--muted); line-height: 1.9;
      max-width: 480px; margin: 0 auto;
    }

    /* CONTACT CARDS */
    .contact-cards {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      padding: 70px 60px;
      background: var(--warm-white);
    }
    .contact-card {
      background: var(--cream); border-radius: var(--radius);
      border: 1px solid var(--border);
      padding: 40px 30px; text-align: center;
      transition: transform .3s, box-shadow .3s;
    }
    .contact-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(0,0,0,0.08); }
    .contact-card-icon {
      width: 56px; height: 56px; border-radius: 16px;
      background: var(--gold-pale);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 20px;
    }
    .contact-card-icon svg { width: 24px; height: 24px; stroke: var(--gold); fill: none; stroke-width: 1.5; }
    .contact-card h3 { font-size: 15px; font-weight: 500; color: var(--dark); margin-bottom: 10px; }
    .contact-card p { font-size: 12.5px; color: var(--muted); line-height: 1.7; margin-bottom: 16px; }
    .contact-card a {
      font-size: 13px; color: var(--gold); text-decoration: none;
      font-weight: 500; transition: color .2s;
      display: block;
    }
    .contact-card a:hover { color: #a87820; }

    /* MAIN CONTACT SECTION */
    .contact-main {
      display: grid; grid-template-columns: 1fr 1.4fr;
      gap: 60px; align-items: start;
      padding: 0 60px 100px;
    }

    /* CONTACT INFO SIDEBAR */
    .contact-info-sidebar {
      position: sticky; top: 30px;
    }
    .section-label {
      display: inline-block;
      font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 14px;
      padding: 4px 12px; background: var(--gold-pale); border-radius: 20px;
    }
    .contact-info-sidebar h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(30px, 3vw, 40px); font-weight: 400;
      color: var(--dark); line-height: 1.2; margin-bottom: 16px;
    }
    .contact-info-sidebar h2 em {
      color: var(--gold); font-style: normal;
      background: var(--gold-pale); padding: 0 8px; border-radius: 4px;
    }
    .contact-info-sidebar p { font-size: 13px; color: var(--muted); line-height: 1.9; margin-bottom: 32px; }

    .info-items { display: flex; flex-direction: column; gap: 18px; margin-bottom: 36px; }
    .info-item {
      display: flex; align-items: flex-start; gap: 14px;
    }
    .info-item-icon {
      width: 40px; height: 40px; border-radius: 10px;
      background: var(--gold-pale); flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
    }
    .info-item-icon svg { width: 18px; height: 18px; stroke: var(--gold); fill: none; stroke-width: 1.5; }
    .info-item-text strong { display: block; font-size: 13px; font-weight: 500; color: var(--dark); margin-bottom: 2px; }
    .info-item-text span { font-size: 12.5px; color: var(--muted); line-height: 1.6; }

    .social-links { display: flex; gap: 10px; }
    .social-btn {
      width: 38px; height: 38px; border-radius: 10px;
      border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: border-color .2s, background .2s; text-decoration: none;
    }
    .social-btn:hover { border-color: var(--gold); background: var(--gold-pale); }
    .social-btn svg { width: 16px; height: 16px; stroke: var(--muted); fill: none; stroke-width: 1.5; }

    /* FORM */
    .contact-form-wrap {
      background: var(--cream); border-radius: var(--radius);
      border: 1px solid var(--border);
      padding: 48px 44px;
    }
    .contact-form-wrap h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 26px; font-weight: 400; color: var(--dark);
      margin-bottom: 6px;
    }
    .contact-form-wrap > p { font-size: 12.5px; color: var(--muted); margin-bottom: 32px; }

    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 18px; }
    .form-group { display: flex; flex-direction: column; gap: 7px; margin-bottom: 18px; }
    .form-group label { font-size: 12px; font-weight: 500; color: var(--text); letter-spacing: .02em; }
    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 11px 14px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #fff; color: var(--text);
      font-family: 'Jost', sans-serif; font-size: 13px;
      outline: none; transition: border-color .2s, box-shadow .2s;
      width: 100%;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(200,151,42,0.1);
    }
    .form-group input::placeholder,
    .form-group textarea::placeholder { color: var(--muted); }
    .form-group textarea { resize: vertical; min-height: 130px; }
    .form-group select { appearance: none; cursor: pointer; }

    .form-consent { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 24px; }
    .form-consent input[type="checkbox"] {
      width: 16px; height: 16px; border-radius: 4px; cursor: pointer;
      accent-color: var(--gold); margin-top: 2px; flex-shrink: 0;
    }
    .form-consent label { font-size: 12px; color: var(--muted); line-height: 1.7; cursor: pointer; }
    .form-consent label a { color: var(--gold); text-decoration: none; }

    .btn-submit {
      width: 100%; padding: 14px;
      background: var(--gold); color: #fff;
      border: none; border-radius: 8px;
      font-family: 'Jost', sans-serif; font-size: 14px; font-weight: 500;
      cursor: pointer; transition: background .2s;
      display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .btn-submit:hover { background: #a87820; }

    .form-success {
      display: none; text-align: center; padding: 24px 0;
    }
    .form-success .success-icon {
      width: 56px; height: 56px; border-radius: 50%;
      background: var(--gold-pale);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 16px;
    }
    .form-success .success-icon svg { width: 28px; height: 28px; stroke: var(--gold); fill: none; stroke-width: 2; }
    .form-success h4 { font-size: 18px; font-weight: 500; color: var(--dark); margin-bottom: 8px; }
    .form-success p { font-size: 13px; color: var(--muted); }

    /* FAQ */
    .faq { padding: 80px 60px; background: var(--cream); }
    .faq-header { text-align: center; margin-bottom: 50px; }
    .faq-header h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(32px, 4vw, 44px); font-weight: 400;
      color: var(--dark); margin-top: 10px; margin-bottom: 12px;
    }
    .faq-header p { font-size: 13px; color: var(--muted); max-width: 460px; margin: 0 auto; line-height: 1.8; }

    .faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .faq-item {
      background: #fff; border-radius: var(--radius);
      border: 1px solid var(--border);
      overflow: hidden;
    }
    .faq-question {
      padding: 20px 22px;
      display: flex; justify-content: space-between; align-items: center;
      cursor: pointer; font-size: 14px; font-weight: 500; color: var(--dark);
      gap: 12px;
    }
    .faq-question svg {
      width: 18px; height: 18px; stroke: var(--gold);
      fill: none; stroke-width: 2; flex-shrink: 0;
      transition: transform .3s;
    }
    .faq-item.open .faq-question svg { transform: rotate(45deg); }
    .faq-answer {
      max-height: 0; overflow: hidden;
      transition: max-height .35s ease, padding .35s ease;
      font-size: 12.5px; color: var(--muted); line-height: 1.8;
      padding: 0 22px;
    }
    .faq-item.open .faq-answer {
      max-height: 300px; padding: 0 22px 20px;
    }

    /* STORE VISIT */
    .store-visit {
      margin: 0 60px 80px;
      background: var(--dark); border-radius: 20px;
      display: grid; grid-template-columns: 1fr 1fr;
      overflow: hidden; align-items: center;
    }
    .store-image img {
      width: 100%; height: 380px; object-fit: cover;
      display: block;
    }
    .store-content { padding: 60px 50px; }
    .store-content h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(30px, 3.5vw, 42px); font-weight: 400;
      color: #fff; margin-bottom: 16px; line-height: 1.2;
    }
    .store-content h2 span { color: var(--gold); font-style: italic; }
    .store-content p { font-size: 13px; color: rgba(255,255,255,0.5); line-height: 1.9; margin-bottom: 28px; }
    .store-hours { margin-bottom: 28px; }
    .store-hour-row {
      display: flex; justify-content: space-between;
      padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.08);
      font-size: 12.5px;
    }
    .store-hour-row:last-child { border-bottom: none; }
    .store-hour-row span:first-child { color: rgba(255,255,255,0.5); }
    .store-hour-row span:last-child { color: var(--gold-light); font-weight: 500; }
    .btn-gold {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 13px 28px; background: var(--gold); color: #fff;
      border: none; border-radius: 8px; font-size: 13px; font-weight: 500;
      cursor: pointer; text-decoration: none; transition: background .2s;
    }
    .btn-gold:hover { background: #a87820; }

    /* ANIMATIONS */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* IMG PLACEHOLDER */
    .img-placeholder {
      width: 100%; height: 100%;
      background: linear-gradient(135deg, #e8d8c0 0%, #d4c0a0 100%);
      display: flex; align-items: center; justify-content: center;
    }
    .img-placeholder span { color: var(--muted); font-size: 13px; opacity: .6; }

    /* RESPONSIVE */
    @media (max-width: 1024px) {
      .page-hero { padding: 80px 40px 60px; }
      .contact-cards { padding: 60px 40px; grid-template-columns: 1fr; }
      .contact-main { grid-template-columns: 1fr; padding: 0 40px 80px; }
      .contact-info-sidebar { position: static; }
      .faq { padding: 60px 40px; }
      .faq-grid { grid-template-columns: 1fr; }
      .store-visit { margin: 0 40px 60px; grid-template-columns: 1fr; }
      .store-image img { height: 280px; }
      .store-content { padding: 50px 40px; }
    }
    @media (max-width: 768px) {
      .page-hero { padding: 60px 30px 50px; }
      .contact-cards { padding: 50px 30px; }
      .contact-main { padding: 0 30px 60px; }
      .contact-form-wrap { padding: 36px 28px; }
      .form-row { grid-template-columns: 1fr; }
      .faq { padding: 50px 30px; }
      .store-visit { margin: 0 30px 50px; }
      .store-content { padding: 40px 30px; }
    }
    @media (max-width: 480px) {
      .page-hero { padding: 50px 20px 40px; }
      .contact-cards { padding: 40px 20px; }
      .contact-main { padding: 0 20px 50px; }
      .contact-form-wrap { padding: 28px 20px; }
      .faq { padding: 40px 20px; }
      .store-visit { margin: 0 20px 40px; }
      .store-content { padding: 32px 20px; }
    }
  </style>
</head>
<body>

<nav>
  <%- include('partials/user/header') %>
</nav>

<!-- HERO -->
