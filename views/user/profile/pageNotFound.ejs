<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page Not Found - Elanora</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap"
    rel="stylesheet">

  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: #fdfaf5;
      color: #2c2c2c;
    }

    .error-container {
      min-height: 80vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 110px 24px 40px;
    }

    .error-content {
      text-align: center;
      max-width: 520px;
    }

    .error-code {
      font-family: 'Cormorant Garamond', serif;
      font-size: 9rem;
      font-weight: 700;
      line-height: 1;
      color: #c49a2a;
      opacity: 0.15;
      user-select: none;
    }

    .error-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.8rem;
      font-weight: 700;
      color: #2c2c2c;
      margin-bottom: 16px;
    }

    .error-subtitle {
      font-size: 1.1rem;
      color: #666;
      margin-bottom: 40px;
      line-height: 1.6;
    }

    .btn-gold {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #c49a2a;
      color: #fff;
      border: none;
      padding: 14px 32px;
      border-radius: 30px;
      font-size: 0.95rem;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: background 0.15s;
    }

    .btn-gold:hover {
      background: #a87820;
    }

    .btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: transparent;
      color: #2c2c2c;
      border: 1px solid #e8e0d0;
      padding: 14px 32px;
      border-radius: 30px;
      font-size: 0.95rem;
      font-weight: 500;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: all 0.15s;
    }

    .btn-outline:hover {
      border-color: #c49a2a;
      color: #c49a2a;
    }
  </style>
</head>

<body>

  <%- include('partials/user/header') %>

    <div class="error-container">
      <div class="error-content">
        <!-- Big 404 -->
        <div class="error-code">404</div>

        <h1 class="error-title">Page Not Found</h1>

        <p class="error-subtitle">
          Oops! The page you're looking for doesn't exist or has been moved.
        </p>

        <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
          <button onclick="goBack()" class="btn-outline">
            ← Go Back
          </button>

          <button onclick="goHome()" class="btn-gold">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor"
              stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            Back to Home
          </button>
        </div>

        <!-- Decorative Element -->
        <div style="margin-top: 60px; opacity: 0.6;">
          <svg width="120" height="120" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="60" cy="60" r="48" stroke="#c49a2a" stroke-width="8" stroke-opacity="0.15" />
            <path d="M40 60 L52 72 L80 40" stroke="#c49a2a" stroke-width="10" stroke-linecap="round"
              stroke-linejoin="round" stroke-opacity="0.25" />
          </svg>
        </div>
      </div>
    </div>

    <%- include('partials/user/footer') %>

      <script>
        function goBack() {
          window.history.back();
        }

        function goHome() {
          window.location.href = '/';
        }
      </script>

</body>

</html>