<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile - Elanora</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">
  
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: #fdfaf5;
      color: #2c2c2c;
    }

    .field-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #2c2c2c;
      margin-bottom: 7px;
    }

    .field-input {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #e8e0d0;
      border-radius: 9px;
      font-size: 0.875rem;
      font-family: 'DM Sans', sans-serif;
      color: #2c2c2c;
      background: #fdfaf5;
      transition: border-color 0.15s, background 0.15s;
    }

    .field-input:focus {
      outline: none;
      border-color: #c49a2a;
      background: #fff;
    }

    .field-input:disabled {
      background: #f7f3ec;
      color: #aaa;
      cursor: default;
    }

    .btn-gold {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #c49a2a;
      color: #fff;
      border: none;
      padding: 11px 24px;
      border-radius: 30px;
      font-size: 0.85rem;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: background 0.15s;
      line-height: 1;
    }

    .btn-gold:hover {
      background: #a87820;
    }

    .btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: transparent;
      color: #2c2c2c;
      border: 1px solid #e8e0d0;
      padding: 11px 24px;
      border-radius: 30px;
      font-size: 0.85rem;
      font-weight: 500;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: all 0.15s;
    }

    .btn-outline:hover {
      border-color: #c49a2a;
      color: #c49a2a;
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.35);
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s;
    }

    .modal-backdrop.open {
      opacity: 1;
      pointer-events: all;
    }

    .modal-card {
      background: #fff;
      border-radius: 18px;
      padding: 36px;
      width: 100%;
      max-width: 400px;
      transform: translateY(12px) scale(0.97);
      transition: transform 0.22s;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
    }

    .modal-backdrop.open .modal-card {
      transform: translateY(0) scale(1);
    }

    .otp-input {
      width: 100%;
      padding: 14px;
      text-align: center;
      font-size: 1.4rem;
      letter-spacing: 0.4em;
      font-weight: 600;
      border: 1.5px solid #e8e0d0;
      border-radius: 10px;
      font-family: 'DM Sans', sans-serif;
      background: #fdfaf5;
      transition: border-color 0.15s;
    }

    .otp-input:focus {
      outline: none;
      border-color: #c49a2a;
      background: #fff;
    }


  </style>
</head>

<body>

  <%- include('partials/user/header') %>

  <div style="max-width:1200px; margin:0 auto; padding:90px 24px 80px;">

    <%- include('partials/user/profileBanner', { user }) %>

    <div style="display:grid; grid-template-columns:230px 1fr; gap:24px;">

      <%- include('partials/user/profileSidebar', { activePage: 'personal' }) %>

      <main style="background:#fff; border-radius:18px; padding:40px; border:1px solid #e8e0d0; box-shadow:0 2px 8px rgba(0,0,0,0.04);">

        <div style="display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid #f0ece4; padding-bottom:18px; margin-bottom:28px;">
          <h3 style="font-family:'Cormorant Garamond',serif; font-size:1.3rem; font-weight:700; color:#2c2c2c;">
            Personal Information
          </h3>
          <button id="editBtn" onclick="enableEdit()" class="btn-gold" style="display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:9px 20px; font-size:0.8rem; line-height:1;">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="flex-shrink:0;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <span>Edit Profile</span>
          </button>
        </div>

        <!-- Profile Picture Section -->
        <div style="margin-bottom:32px; display:flex; justify-content:center;">
          <div style="text-align:center;">
            <label class="field-label" style="margin-bottom:12px; text-align:center; display:block;">Profile Picture</label>

            <div id="profilePreviewContainer" style="position:relative; width:120px; height:120px; margin:0 auto;">
              <img id="profilePreview" 
                   src="<%= user.profileIcon ? (user.profileIcon.startsWith('http') ? user.profileIcon : '/' + user.profileIcon.replace('public/', '')) : '' %>" 
                   alt="Profile Picture"
                   style="width:120px; height:120px; object-fit:cover; border-radius:9999px; border:4px solid #e8e0d0;"
                   onerror="this.onerror=null; const initials = '<%= (user.fullName || 'U').split(' ').map(n=>n[0]).join('').toUpperCase().slice(0,2) %>'; this.src='data:image/svg+xml,' + encodeURIComponent('<svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;120&quot; height=&quot;120&quot;><rect width=&quot;120&quot; height=&quot;120&quot; rx=&quot;60&quot; fill=&quot;%23c49a2a&quot;/><text x=&quot;50%&quot; y=&quot;54%&quot; dominant-baseline=&quot;middle&quot; text-anchor=&quot;middle&quot; fill=&quot;white&quot; font-family=&quot;DM Sans,sans-serif&quot; font-size=&quot;42&quot; font-weight=&quot;600&quot;>' + initials + '</text></svg>');"
              >

              <div id="profileEditOverlay" 
                   style="display:none; position:absolute; inset:0; background:rgba(0,0,0,0.5); border-radius:9999px; align-items:center; justify-content:center; cursor:pointer;">
                <label for="profileUpload" style="color:white; font-size:0.8rem; font-weight:600; cursor:pointer; text-align:center; line-height:1.2;">
                  Change<br>Photo
                </label>
              </div>
            </div>

            <div style="margin-top:12px;">
              <button type="button" onclick="document.getElementById('profileUpload').click()" id="changePhotoBtn"
                      style="display:none;" class="btn-outline text-sm">
                Choose New Photo
              </button>
            </div>
          </div>
        </div>

        <!-- Main Profile Form -->
        <form id="profileForm" method="POST" action="/profile" enctype="multipart/form-data">
          <input type="file" id="profileUpload" name="profileIcon" accept="image/*" style="display:none;" onchange="previewImage(event)">

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px;">

            <div style="grid-column:span 2;">
              <label class="field-label" for="fullName">Full Name</label>
              <input id="fullName" name="fullName" type="text" class="field-input" value="<%= user.fullName || '' %>" maxlength="40" disabled>
            </div>

            <div style="grid-column:span 2;">
              <label class="field-label" for="email">Email Address</label>
              <div style="display:flex; gap:10px; align-items:center;">
                <input id="email" name="email" type="email" class="field-input" value="<%= user.email %>" disabled>
                <button type="button" id="verifyEmailBtn" onclick="openEmailModal()" class="btn-gold"
                        style="display:none; white-space:nowrap; padding:11px 18px; font-size:0.8rem; flex-shrink:0;">
                  Verify
                </button>
              </div>
              <p id="emailWarning" style="display:none; font-size:0.75rem; color:#b45309; margin-top:7px;">
                ⚠ Changing your email requires 2-step verification. Click "Verify" to proceed.
              </p>
            </div>

            <div style="grid-column:span 2;">
              <label class="field-label" for="phone">Phone Number</label>
              <input id="phone" name="phone" type="tel" class="field-input" value="<%= user.phone || '' %>" maxlength="10" placeholder="10-digit mobile number" disabled>
            </div>

          </div>

          <div id="formActions" style="display:none; gap:12px; padding-top:6px;" class="flex">
            <button type="submit" id="saveBtn" class="btn-gold">Save Changes</button>
            <button type="button" onclick="cancelEdit()" class="btn-outline">Cancel</button>
          </div>
        </form>

      </main>
    </div>
  </div>

  <!-- Email Verification Modal (2-Step / 2-Side Verification) -->
  <div id="emailModal" class="modal-backdrop" onclick="outsideClose(event)">
    <div class="modal-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <h4 style="font-family:'Cormorant Garamond',serif; font-size:1.4rem; font-weight:700; color:#2c2c2c;">
          Change Email Address
        </h4>
        <span id="stepIndicatorBadge" style="font-size:0.7rem; font-weight:600; padding:4px 10px; border-radius:20px; background:#fdf9ef; color:#c49a2a; border:1px solid #e8e0d0;">
          Step 1 of 2
        </span>
      </div>

      <!-- STEP 1: VERIFY CURRENT EMAIL -->
      <div id="step1CurrentEmail">
        <p style="font-size:0.82rem; color:#666; margin-bottom:16px; line-height:1.5;">
          For security, a 6-digit verification code will be sent to your current email: <strong id="currentEmailDisplay" style="color:#2c2c2c;"><%= user.email %></strong>
        </p>

        <div id="currentOtpSection" style="display:none; margin-bottom:16px;">
          <label class="field-label" style="margin-bottom:7px;">Current Email Verification Code</label>
          <input id="currentOtpInput" type="text" maxlength="6" class="otp-input" placeholder="••••••" style="margin-bottom:14px;">
          <button onclick="verifyCurrentOtp()" class="btn-gold" style="width:100%; justify-content:center; margin-bottom:10px;">
            Verify Current Email Code
          </button>
          
          <div style="text-align:center;">
            <button id="resendCurrentBtn" onclick="sendCurrentOtp(true)" 
                    style="background:none; border:none; font-size:0.82rem; color:#c49a2a; cursor:pointer; font-family:'DM Sans',sans-serif; font-weight:600;">
              Resend Code
            </button>
            <span id="timerCurrentContainer" style="font-size:0.82rem; color:#999; margin-left:8px; display:none;">
              in <span id="timerCurrentValue">60</span>s
            </span>
          </div>
        </div>

        <button id="sendCurrentOtpBtn" onclick="sendCurrentOtp(false)" class="btn-gold" style="width:100%; justify-content:center;">
          Send Code to Current Email
        </button>
      </div>

      <!-- STEP 2: VERIFY NEW EMAIL -->
      <div id="step2NewEmail" style="display:none;">
        <p style="font-size:0.82rem; color:#2e7d32; font-weight:600; margin-bottom:14px; display:flex; align-items:center; gap:6px; background:#e8f5e9; padding:8px 12px; border-radius:8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Current email verified! Now enter your new email.
        </p>

        <label class="field-label" style="margin-bottom:7px;">New Email Address</label>
        <input id="newEmailInput" type="email" class="field-input" placeholder="newemail@example.com" style="margin-bottom:16px;">

        <button id="sendNewOtpBtn" onclick="sendNewOtp(false)" class="btn-gold" style="width:100%; justify-content:center; margin-bottom:16px;">
          Send Code to New Email
        </button>

        <div id="newOtpSection" style="display:none;">
          <p style="font-size:0.82rem; color:#666; margin-bottom:12px;">
            Code sent to <strong id="newOtpEmailLabel" style="color:#2c2c2c;"></strong>
          </p>
          <label class="field-label" style="margin-bottom:7px;">New Email Verification Code</label>
          <input id="newOtpInput" type="text" maxlength="6" class="otp-input" placeholder="••••••" style="margin-bottom:16px;">
          
          <button onclick="verifyNewOtp()" class="btn-gold" style="width:100%; justify-content:center; margin-bottom:10px;">
            Verify & Save New Email
          </button>
          
          <div style="text-align:center;">
            <button id="resendNewBtn" onclick="sendNewOtp(true)" 
                    style="background:none; border:none; font-size:0.82rem; color:#c49a2a; cursor:pointer; font-family:'DM Sans',sans-serif; font-weight:600;">
              Resend Code
            </button>
            <span id="timerNewContainer" style="font-size:0.82rem; color:#999; margin-left:8px; display:none;">
              in <span id="timerNewValue">60</span>s
            </span>
          </div>
        </div>
      </div>

      <button onclick="closeEmailModal()" 
              style="width:100%; background:none; border:none; font-size:0.82rem; color:#bbb; cursor:pointer; margin-top:16px; font-family:'DM Sans',sans-serif;">
        Cancel
      </button>
    </div>
  </div>

  <!-- Image Cropping Modal -->
  <div id="cropperModal" class="modal-backdrop" style="z-index: 300;">
    <div class="modal-card" style="max-width: 500px;">
      <h4 style="font-family:'Cormorant Garamond',serif; font-size:1.4rem; font-weight:700; color:#2c2c2c; margin-bottom:12px;">
        Crop Profile Picture
      </h4>
      <div style="width: 100%; max-height: 400px; margin-bottom: 20px;">
        <img id="imageToCrop" style="max-width: 100%; display: block;">
      </div>
      <div style="display: flex; gap: 12px;">
        <button type="button" id="cropBtn" class="btn-gold" style="flex: 1; justify-content: center;">Crop & Save</button>
        <button type="button" onclick="closeCropperModal()" class="btn-outline" style="flex: 1; justify-content: center;">Cancel</button>
      </div>
    </div>
  </div>


  <%- include('partials/user/footer') %>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
  <script>
    // Original Values For Cancel Functionality
    const orig = {
      fullName: document.getElementById('fullName').value,
      email: document.getElementById('email').value,
      phone: document.getElementById('phone').value,
      profileIcon: "<%= user.profileIcon ? (user.profileIcon.startsWith('http') ? user.profileIcon : user.profileIcon.replace('public/', '')) : 'default.png' %>"
    };

    let selectedFile = null;
    let cropper = null;
    let croppedFile = null;

    function enableEdit() {
      ['fullName', 'email', 'phone'].forEach(id => {
        document.getElementById(id).disabled = false;
      });
      document.getElementById('editBtn').style.display = 'none';
      document.getElementById('formActions').style.display = 'flex';
      document.getElementById('changePhotoBtn').style.display = 'block';
      document.getElementById('profileEditOverlay').style.display = 'flex';
      document.getElementById('email').addEventListener('input', onEmailChange);
    }

    function cancelEdit() {
      document.getElementById('fullName').value = orig.fullName;
      document.getElementById('email').value = orig.email;
      document.getElementById('phone').value = orig.phone;

      document.getElementById('fullName').disabled = true;
      document.getElementById('email').disabled = true;
      document.getElementById('phone').disabled = true;

      // Reset Image
      const resetSrc = orig.profileIcon.startsWith('http') ? orig.profileIcon : (orig.profileIcon.startsWith('/') ? orig.profileIcon : '/' + orig.profileIcon);
      document.getElementById('profilePreview').src = resetSrc;
      
      document.getElementById('profileUpload').value = '';
      selectedFile = null;
      croppedFile = null;

      // Reset UI
      document.getElementById('editBtn').style.display = 'inline-flex';
      document.getElementById('formActions').style.display = 'none';
      document.getElementById('changePhotoBtn').style.display = 'none';
      document.getElementById('profileEditOverlay').style.display = 'none';
      document.getElementById('verifyEmailBtn').style.display = 'none';
      document.getElementById('emailWarning').style.display = 'none';
    }

    function previewImage(event) {
      const file = event.target.files[0];
      if (!file) return;

      if (file.size > 2 * 1024 * 1024) {
        if (typeof window.showToast === 'function') window.showToast('Image size must be less than 2MB', 'error');
        return;
      }

      selectedFile = file;
      const reader = new FileReader();
      reader.onload = function (e) {
        document.getElementById('imageToCrop').src = e.target.result;
        document.getElementById('cropperModal').classList.add('open');

        if (cropper) {
          cropper.destroy();
        }

        cropper = new Cropper(document.getElementById('imageToCrop'), {
          aspectRatio: 1,
          viewMode: 1,
          autoCropArea: 0.8,
          responsive: true,
        });
      };
      reader.readAsDataURL(file);
      // Reset Value So Same File Can Trigger Change Again If Cancelled
      event.target.value = '';
    }

    function closeCropperModal() {
      document.getElementById('cropperModal').classList.remove('open');
      if (cropper) {
        cropper.destroy();
        cropper = null;
      }
    }

    document.getElementById('cropBtn').addEventListener('click', function() {
      if (!cropper) return;
      const canvas = cropper.getCroppedCanvas({
        width: 500,
        height: 500,
        imageSmoothingEnabled: true,
        imageSmoothingQuality: 'high',
      });

      // Show Preview On Main Screen
      document.getElementById('profilePreview').src = canvas.toDataURL('image/jpeg', 0.9);

      // Create Blob For Backend Upload
      canvas.toBlob(function(blob) {
        croppedFile = new File([blob], 'profile_cropped.jpg', { type: 'image/jpeg' });
        closeCropperModal();
      }, 'image/jpeg', 0.9);
    });

    function onEmailChange() {
      const changed = document.getElementById('email').value.trim().toLowerCase() !== orig.email.toLowerCase();
      document.getElementById('verifyEmailBtn').style.display = changed ? 'block' : 'none';
      document.getElementById('emailWarning').style.display = changed ? 'block' : 'none';
    }

    // Block non-alphabets and limit to 40 characters for full name field
    document.getElementById('fullName').addEventListener('input', function () {
      let cleaned = this.value.replace(/[^A-Za-z\s]/g, '');
      if (cleaned.length > 40) {
        cleaned = cleaned.slice(0, 40);
      }
      if (this.value !== cleaned) {
        this.value = cleaned;
      }
    });

    // Block non-digits and limit to 10 digits for phone field
    document.getElementById('phone').addEventListener('input', function () {
      let cleaned = this.value.replace(/\D/g, '');
      if (cleaned.length > 10) {
        cleaned = cleaned.slice(0, 10);
      }
      if (this.value !== cleaned) {
        this.value = cleaned;
      }
    });

    // Form Submission - Now Refreshes The Page After Successful Update
    document.getElementById('profileForm').addEventListener('submit', async function (e) {
      e.preventDefault();

      const currentEmail = document.getElementById('email').value.trim().toLowerCase();
      if (currentEmail !== orig.email.toLowerCase()) {
        if (typeof window.showToast === 'function') {
          window.showToast('Please verify your new email before saving changes.', 'error');
        }
        return;
      }

      // Validate full name
      const fullNameVal = document.getElementById('fullName').value.trim();
      if (!fullNameVal || fullNameVal.length < 2) {
        if (typeof window.showToast === 'function') window.showToast('Full name must be at least 2 characters', 'error');
        return;
      }
      if (fullNameVal.length > 40) {
        if (typeof window.showToast === 'function') window.showToast('Full name cannot exceed 40 characters', 'error');
        return;
      }
      if (!/^[A-Za-z\s]+$/.test(fullNameVal)) {
        if (typeof window.showToast === 'function') window.showToast('Full name must contain only alphabets', 'error');
        return;
      }

      // Validate phone number
      const phoneVal = document.getElementById('phone').value.trim();
      if (phoneVal) {
        if (!/^[6-9]\d{9}$/.test(phoneVal)) {
          if (typeof window.showToast === 'function') window.showToast('Please enter a valid 10-digit mobile number starting with 6-9', 'error');
          return;
        }
      }

      const saveBtn = document.getElementById('saveBtn');
      const originalText = saveBtn.textContent;
      saveBtn.textContent = 'Saving...';
      saveBtn.disabled = true;

      const formData = new FormData(this);

      if (croppedFile) {
        formData.set('profileIcon', croppedFile);
      }

      try {
        const res = await fetch('/profile', {
          method: 'POST',
          body: formData
        });

        const data = await res.json();

        if (res.ok && data.success) {
          if (typeof window.showToast === 'function') window.showToast(data.message || 'Profile updated successfully!', 'success');

          setTimeout(() => {
            window.location.reload();
          }, 1200);

        } else {
          if (typeof window.showToast === 'function') window.showToast(data.message || 'Failed to update profile', 'error');
          saveBtn.textContent = originalText;
          saveBtn.disabled = false;
        }
      } catch (err) {
        if (typeof window.showToast === 'function') window.showToast('Network error. Please try again.', 'error');
        saveBtn.textContent = originalText;
        saveBtn.disabled = false;
      }
    });

    // Email Verification Modal Functions (2-Step / 2-Side Flow)
    function openEmailModal() {
      document.getElementById('step1CurrentEmail').style.display = 'block';
      document.getElementById('step2NewEmail').style.display = 'none';
      document.getElementById('currentOtpSection').style.display = 'none';
      document.getElementById('sendCurrentOtpBtn').style.display = 'flex';
      document.getElementById('newOtpSection').style.display = 'none';
      document.getElementById('sendNewOtpBtn').style.display = 'flex';
      document.getElementById('stepIndicatorBadge').textContent = 'Step 1 of 2';

      document.getElementById('currentEmailDisplay').textContent = orig.email;
      document.getElementById('currentOtpInput').value = '';
      document.getElementById('newEmailInput').value = document.getElementById('email').value.trim();
      document.getElementById('newOtpInput').value = '';

      document.getElementById('emailModal').classList.add('open');
    }

    function closeEmailModal() {
      document.getElementById('emailModal').classList.remove('open');
      clearInterval(timerInterval);
    }

    function outsideClose(e) {
      if (e.target === document.getElementById('emailModal')) closeEmailModal();
    }

    let timerInterval = null;

    function startTimer(btnId, containerId, valueId) {
      const resendBtn = document.getElementById(btnId);
      const timerContainer = document.getElementById(containerId);
      const timerValue = document.getElementById(valueId);
      
      clearInterval(timerInterval);
      let timeLeft = 60;
      resendBtn.style.opacity = '0.5';
      resendBtn.style.pointerEvents = 'none';
      resendBtn.style.color = '#999';
      timerContainer.style.display = 'inline';
      timerValue.textContent = timeLeft;

      timerInterval = setInterval(() => {
        timeLeft--;
        timerValue.textContent = timeLeft;
        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          resendBtn.style.opacity = '1';
          resendBtn.style.pointerEvents = 'all';
          resendBtn.style.color = '#c49a2a';
          timerContainer.style.display = 'none';
        }
      }, 1000);
    }

    // STEP 1: Send OTP to Current Email
    async function sendCurrentOtp(isResend = false) {
      const resendBtn = document.getElementById('resendCurrentBtn');
      if (isResend && resendBtn && resendBtn.style.pointerEvents === 'none') return;

      try {
        const res = await fetch('/profile/email/send-current-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();

        if (res.ok && data.success) {
          document.getElementById('currentOtpSection').style.display = 'block';
          document.getElementById('sendCurrentOtpBtn').style.display = 'none';
          startTimer('resendCurrentBtn', 'timerCurrentContainer', 'timerCurrentValue');

          if (typeof window.showToast === 'function') {
            window.showToast(isResend ? 'Verification code resent to current email.' : 'Verification code sent to current email.', 'success');
          }
        } else {
          if (typeof window.showToast === 'function') {
            window.showToast(data.message || 'Could not send verification code.', 'error');
          }
        }
      } catch (err) {
        if (typeof window.showToast === 'function') window.showToast('Network error. Please try again.', 'error');
      }
    }

    // STEP 1: Verify Current Email OTP
    async function verifyCurrentOtp() {
      const otp = document.getElementById('currentOtpInput').value.trim();

      if (!otp || otp.length !== 6) {
        if (typeof window.showToast === 'function') window.showToast('Please enter a valid 6-digit verification code.', 'error');
        return;
      }

      try {
        const res = await fetch('/profile/email/verify-current-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ otp })
        });
        const data = await res.json();

        if (res.ok && data.success) {
          clearInterval(timerInterval);
          document.getElementById('step1CurrentEmail').style.display = 'none';
          document.getElementById('step2NewEmail').style.display = 'block';
          document.getElementById('stepIndicatorBadge').textContent = 'Step 2 of 2';

          if (typeof window.showToast === 'function') {
            window.showToast('Current email verified! Now enter your new email.', 'success');
          }
        } else {
          if (typeof window.showToast === 'function') window.showToast(data.message || 'Invalid or expired verification code.', 'error');
        }
      } catch (err) {
        if (typeof window.showToast === 'function') window.showToast('Network error. Please try again.', 'error');
      }
    }

    // STEP 2: Send OTP to New Email
    async function sendNewOtp(isResend = false) {
      const newEmail = document.getElementById('newEmailInput').value.trim();

      if (!newEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(newEmail)) {
        if (typeof window.showToast === 'function') window.showToast('Please enter a valid new email address.', 'error');
        return;
      }

      const resendBtn = document.getElementById('resendNewBtn');
      if (isResend && resendBtn && resendBtn.style.pointerEvents === 'none') return;

      try {
        const res = await fetch('/profile/email/send-new-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ newEmail })
        });
        const data = await res.json();

        if (res.ok && data.success) {
          document.getElementById('newOtpEmailLabel').textContent = newEmail;
          document.getElementById('newOtpSection').style.display = 'block';
          document.getElementById('sendNewOtpBtn').style.display = 'none';
          startTimer('resendNewBtn', 'timerNewContainer', 'timerNewValue');

          if (typeof window.showToast === 'function') {
            window.showToast(isResend ? 'Verification code resent to new email.' : 'Verification code sent to new email.', 'success');
          }
        } else {
          if (typeof window.showToast === 'function') window.showToast(data.message || 'Could not send verification code to new email.', 'error');
        }
      } catch (err) {
        if (typeof window.showToast === 'function') window.showToast('Network error. Please try again.', 'error');
      }
    }

    // STEP 2: Verify New Email OTP & Finalize Change
    async function verifyNewOtp() {
      const otp = document.getElementById('newOtpInput').value.trim();
      const newEmail = document.getElementById('newEmailInput').value.trim();

      if (!otp || otp.length !== 6) {
        if (typeof window.showToast === 'function') window.showToast('Please enter a valid 6-digit verification code.', 'error');
        return;
      }

      try {
        const res = await fetch('/profile/email/verify-new-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ newEmail, otp })
        });
        const data = await res.json();

        if (res.ok && data.success) {
          document.getElementById('email').value = data.newEmail || newEmail;
          orig.email = data.newEmail || newEmail;

          closeEmailModal();
          if (typeof window.showToast === 'function') {
            window.showToast(data.message || 'Email updated successfully!', 'success');
          }
          setTimeout(() => location.reload(), 1200);
        } else {
          if (typeof window.showToast === 'function') window.showToast(data.message || 'Invalid or expired code.', 'error');
        }
      } catch (err) {
        if (typeof window.showToast === 'function') window.showToast('Network error. Please try again.', 'error');
      }
    }
  </script>
</body>

</html>