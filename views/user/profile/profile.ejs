<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile - Elanora</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: #fdfaf5;
      color: #2c2c2c;
    }

    .field-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #2c2c2c;
      margin-bottom: 7px;
    }

    .field-input {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #e8e0d0;
      border-radius: 9px;
      font-size: 0.875rem;
      font-family: 'DM Sans', sans-serif;
      color: #2c2c2c;
      background: #fdfaf5;
      transition: border-color 0.15s, background 0.15s;
    }

    .field-input:focus {
      outline: none;
      border-color: #c49a2a;
      background: #fff;
    }

    .field-input:disabled {
      background: #f7f3ec;
      color: #aaa;
      cursor: default;
    }

    .btn-gold {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: #c49a2a;
      color: #fff;
      border: none;
      padding: 11px 24px;
      border-radius: 30px;
      font-size: 0.85rem;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: background 0.15s;
    }

    .btn-gold:hover {
      background: #a87820;
    }

    .btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: transparent;
      color: #2c2c2c;
      border: 1px solid #e8e0d0;
      padding: 11px 24px;
      border-radius: 30px;
      font-size: 0.85rem;
      font-weight: 500;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: all 0.15s;
    }

    .btn-outline:hover {
      border-color: #c49a2a;
      color: #c49a2a;
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.35);
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s;
    }

    .modal-backdrop.open {
      opacity: 1;
      pointer-events: all;
    }

    .modal-card {
      background: #fff;
      border-radius: 18px;
      padding: 36px;
      width: 100%;
      max-width: 400px;
      transform: translateY(12px) scale(0.97);
      transition: transform 0.22s;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
    }

    .modal-backdrop.open .modal-card {
      transform: translateY(0) scale(1);
    }

    .otp-input {
      width: 100%;
      padding: 14px;
      text-align: center;
      font-size: 1.4rem;
      letter-spacing: 0.4em;
      font-weight: 600;
      border: 1.5px solid #e8e0d0;
      border-radius: 10px;
      font-family: 'DM Sans', sans-serif;
      background: #fdfaf5;
      transition: border-color 0.15s;
    }

    .otp-input:focus {
      outline: none;
      border-color: #c49a2a;
      background: #fff;
    }

    #toast {
      position: fixed;
      bottom: 28px;
      right: 28px;
      z-index: 999;
      padding: 13px 20px;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 500;
      font-family: 'DM Sans', sans-serif;
      background: #2c2c2c;
      color: #fff;
      transform: translateY(14px);
      opacity: 0;
      transition: all 0.25s ease;
      pointer-events: none;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    #toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    #toast.success { background: #166534; }
    #toast.error { background: #991b1b; }
    #toast.info { background: #1e3a5f; }
  </style>
</head>

<body>

  <%- include('partials/user/header') %>

  <div style="max-width:1200px; margin:0 auto; padding:36px 24px 80px;">

    <%- include('partials/user/profileBanner', { user }) %>

    <div style="display:grid; grid-template-columns:230px 1fr; gap:24px;">

      <%- include('partials/user/profileSidebar', { activePage: 'personal' }) %>

      <main style="background:#fff; border-radius:18px; padding:40px; border:1px solid #e8e0d0; box-shadow:0 2px 8px rgba(0,0,0,0.04);">

        <div style="display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid #f0ece4; padding-bottom:18px; margin-bottom:28px;">
          <h3 style="font-family:'Cormorant Garamond',serif; font-size:1.3rem; font-weight:700; color:#2c2c2c;">
            Personal Information
          </h3>
          <button id="editBtn" onclick="enableEdit()" class="btn-gold" style="padding:9px 20px; font-size:0.8rem;">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            Edit Profile
          </button>
        </div>

        <!-- Profile Picture Section -->
        <div style="margin-bottom:32px; display:flex; justify-content:center;">
          <div style="text-align:center;">
            <label class="field-label" style="margin-bottom:12px; text-align:center; display:block;">Profile Picture</label>

            <div id="profilePreviewContainer" style="position:relative; width:120px; height:120px; margin:0 auto;">
              <img id="profilePreview" 
                   src="/uploads/profile/<%= user.profileIcon || 'default.png' %>" 
                   alt="Profile Picture"
                   style="width:120px; height:120px; object-fit:cover; border-radius:9999px; border:4px solid #e8e0d0;">

              <div id="profileEditOverlay" 
                   style="display:none; position:absolute; inset:0; background:rgba(0,0,0,0.5); border-radius:9999px; align-items:center; justify-content:center; cursor:pointer;">
                <label for="profileUpload" style="color:white; font-size:0.8rem; font-weight:600; cursor:pointer; text-align:center; line-height:1.2;">
                  Change<br>Photo
                </label>
              </div>
            </div>

            <div style="margin-top:12px;">
              <input type="file" id="profileUpload" name="profileIcon" accept="image/*" style="display:none;" onchange="previewImage(event)">
              <button type="button" onclick="document.getElementById('profileUpload').click()" id="changePhotoBtn"
                      style="display:none;" class="btn-outline text-sm">
                Choose New Photo
              </button>
            </div>
          </div>
        </div>

        <!-- Main Profile Form -->
        <form id="profileForm" method="POST" action="/profile" enctype="multipart/form-data">
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px;">

            <div style="grid-column:span 2;">
              <label class="field-label" for="fullName">Full Name</label>
              <input id="fullName" name="fullName" type="text" class="field-input" value="<%= user.fullName || '' %>" disabled>
            </div>

            <div style="grid-column:span 2;">
              <label class="field-label" for="email">Email Address</label>
              <div style="display:flex; gap:10px; align-items:center;">
                <input id="email" name="email" type="email" class="field-input" value="<%= user.email %>" disabled>
                <button type="button" id="verifyEmailBtn" onclick="openEmailModal()" class="btn-gold"
                        style="display:none; white-space:nowrap; padding:11px 18px; font-size:0.8rem; flex-shrink:0;">
                  Verify Change
                </button>
              </div>
              <p id="emailWarning" style="display:none; font-size:0.75rem; color:#b45309; margin-top:7px;">
                ⚠ Changing your email requires verification. Click "Verify Change" to proceed.
              </p>
            </div>

            <div style="grid-column:span 2;">
              <label class="field-label" for="phone">Phone Number</label>
              <input id="phone" name="phone" type="tel" class="field-input" value="<%= user.phone || '' %>" disabled>
            </div>

          </div>

          <div id="formActions" style="display:none; gap:12px; padding-top:6px;" class="flex">
            <button type="submit" id="saveBtn" class="btn-gold">Save Changes</button>
            <button type="button" onclick="cancelEdit()" class="btn-outline">Cancel</button>
          </div>
        </form>

      </main>
    </div>
  </div>

  <!-- Email Verification Modal -->
  <div id="emailModal" class="modal-backdrop" onclick="outsideClose(event)">
    <div class="modal-card">
      <h4 style="font-family:'Cormorant Garamond',serif; font-size:1.4rem; font-weight:700; color:#2c2c2c; margin-bottom:4px;">
        Verify New Email
      </h4>
      <p style="font-size:0.82rem; color:#999; margin-bottom:24px;">
        Enter your new email and we'll send a verification code.
      </p>

      <div id="step1">
        <label class="field-label" style="margin-bottom:7px;">New Email Address</label>
        <input id="newEmailInput" type="email" class="field-input" placeholder="you@example.com" style="margin-bottom:16px;">
        <button onclick="sendOtp(false)" class="btn-gold" style="width:100%; justify-content:center;">
          Send Verification Code
        </button>
      </div>

      <div id="step2" style="display:none;">
        <p style="font-size:0.82rem; color:#666; margin-bottom:16px;">
          Code sent to <strong id="otpEmailLabel" style="color:#2c2c2c;"></strong>
        </p>
        <label class="field-label" style="margin-bottom:7px;">Verification Code</label>
        <input id="otpInput" type="text" maxlength="6" class="otp-input" placeholder="••••••" style="margin-bottom:16px;">
        
        <button onclick="verifyOtp()" class="btn-gold" style="width:100%; justify-content:center; margin-bottom:10px;">
          Verify & Update Email
        </button>
        
        <button onclick="sendOtp(true)" 
                style="width:100%; background:none; border:none; font-size:0.82rem; color:#999; cursor:pointer; font-family:'DM Sans',sans-serif; padding:4px;">
          Resend Code
        </button>
      </div>

      <button onclick="closeEmailModal()" 
              style="width:100%; background:none; border:none; font-size:0.82rem; color:#bbb; cursor:pointer; margin-top:16px; font-family:'DM Sans',sans-serif;">
        Cancel
      </button>
    </div>
  </div>

  <div id="toast"></div>

  <%- include('partials/user/footer') %>

  <script>
    // Original values for cancel functionality
    const orig = {
      fullName: document.getElementById('fullName').value,
      email: document.getElementById('email').value,
      phone: document.getElementById('phone').value,
      profileIcon: "<%= user.profileIcon || 'default.png' %>"
    };

    let selectedFile = null;

    function enableEdit() {
      ['fullName', 'email', 'phone'].forEach(id => {
        document.getElementById(id).disabled = false;
      });
      document.getElementById('editBtn').style.display = 'none';
      document.getElementById('formActions').style.display = 'flex';
      document.getElementById('changePhotoBtn').style.display = 'block';
      document.getElementById('profileEditOverlay').style.display = 'flex';
      document.getElementById('email').addEventListener('input', onEmailChange);
    }

    function cancelEdit() {
      document.getElementById('fullName').value = orig.fullName;
      document.getElementById('email').value = orig.email;
      document.getElementById('phone').value = orig.phone;

      document.getElementById('fullName').disabled = true;
      document.getElementById('email').disabled = true;
      document.getElementById('phone').disabled = true;

      // Reset image
      document.getElementById('profilePreview').src = `/uploads/profile/${orig.profileIcon}`;
      document.getElementById('profileUpload').value = '';
      selectedFile = null;

      // Reset UI
      document.getElementById('editBtn').style.display = 'block';
      document.getElementById('formActions').style.display = 'none';
      document.getElementById('changePhotoBtn').style.display = 'none';
      document.getElementById('profileEditOverlay').style.display = 'none';
      document.getElementById('verifyEmailBtn').style.display = 'none';
      document.getElementById('emailWarning').style.display = 'none';
    }

    function previewImage(event) {
      const file = event.target.files[0];
      if (!file) return;

      if (file.size > 2 * 1024 * 1024) {
        showToast('Image size must be less than 2MB', 'error');
        return;
      }

      selectedFile = file;
      const reader = new FileReader();
      reader.onload = function (e) {
        document.getElementById('profilePreview').src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function onEmailChange() {
      const changed = document.getElementById('email').value.trim() !== orig.email;
      document.getElementById('verifyEmailBtn').style.display = changed ? 'block' : 'none';
      document.getElementById('emailWarning').style.display = changed ? 'block' : 'none';
    }

    // Form Submission
    document.getElementById('profileForm').addEventListener('submit', async function (e) {
      e.preventDefault();

      const currentEmail = document.getElementById('email').value.trim();

      if (currentEmail !== orig.email) {
        showToast('Please verify your new email before saving changes.', 'error');
        return;
      }

      const saveBtn = document.getElementById('saveBtn');
      const originalText = saveBtn.textContent;
      saveBtn.textContent = 'Saving...';
      saveBtn.disabled = true;

      const formData = new FormData(this);

      try {
        const res = await fetch('/profile', {
          method: 'POST',
          body: formData
        });

        const data = await res.json();

        if (res.ok && data.success) {
          showToast(data.message || 'Profile updated successfully!', 'success');

          // Update original values
          orig.fullName = document.getElementById('fullName').value;
          orig.email = document.getElementById('email').value;
          orig.phone = document.getElementById('phone').value;

          cancelEdit(); // Reset UI
        } else {
          showToast(data.message || 'Failed to update profile', 'error');
        }
      } catch (err) {
        console.error(err);
        showToast('Network error. Please try again.', 'error');
      } finally {
        saveBtn.textContent = originalText;
        saveBtn.disabled = false;
      }
    });

    // Email Verification Modal Functions
    function openEmailModal() {
      document.getElementById('newEmailInput').value = document.getElementById('email').value.trim();
      document.getElementById('step1').style.display = 'block';
      document.getElementById('step2').style.display = 'none';
      document.getElementById('otpInput').value = '';
      document.getElementById('emailModal').classList.add('open');
    }

    function closeEmailModal() {
      document.getElementById('emailModal').classList.remove('open');
    }

    function outsideClose(e) {
      if (e.target === document.getElementById('emailModal')) closeEmailModal();
    }

    // Send OTP
    async function sendOtp(isResend = false) {
      const newEmail = document.getElementById('newEmailInput').value.trim();

      if (!newEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(newEmail)) {
        showToast('Please enter a valid email address.', 'error');
        return;
      }

      try {
        const res = await fetch('/profile/email/send-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ newEmail })
        });

        const data = await res.json();

        if (res.ok && data.success) {
          document.getElementById('otpEmailLabel').textContent = newEmail;
          document.getElementById('step1').style.display = 'none';
          document.getElementById('step2').style.display = 'block';
          showToast(isResend ? 'Code resent successfully!' : 'Verification code sent!', 'success');
        } else {
          showToast(data.message || 'Could not send OTP.', 'error');
        }
      } catch (err) {
        console.error(err);
        showToast('Something went wrong. Please try again.', 'error');
      }
    }

    // Verify OTP - Updated to match your backend
    async function verifyOtp() {
      const otp = document.getElementById('otpInput').value.trim();
      const newEmail = document.getElementById('newEmailInput').value.trim();

      if (!otp || otp.length !== 6) {
        showToast('Please enter a valid 6-digit verification code.', 'error');
        return;
      }

      try {
        const res = await fetch('/profile/email/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ newEmail, otp })
        });

        const data = await res.json();

        if (res.ok && data.success) {
          // Update email in form and original values
          document.getElementById('email').value = newEmail;
          orig.email = newEmail;

          // Hide verification elements
          document.getElementById('verifyEmailBtn').style.display = 'none';
          document.getElementById('emailWarning').style.display = 'none';

          closeEmailModal();
          showToast(data.message || 'Email updated successfully!', 'success');
        } else {
          showToast(data.message || 'Invalid or expired code.', 'error');
        }
      } catch (err) {
        console.error(err);
        showToast('Network error. Please try again.', 'error');
      }
    }

    // Toast Notification
    let toastTimer;
    function showToast(msg, type = 'info') {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.className = `show ${type}`;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { 
        t.className = ''; 
      }, 4000);
    }
  </script>
</body>

</html>