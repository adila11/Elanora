<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password & Security - Elanora</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'DM Sans', sans-serif;
      background: #fdfaf5;
      color: #2c2c2c;
    }

    .field-label {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 7px;
      display: block;
    }

    .field-input {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #e8e0d0;
      border-radius: 9px;
      font-size: 0.875rem;
      background: #fdfaf5;
    }

    .field-input:focus {
      outline: none;
      border-color: #c49a2a;
      background: #fff;
    }

    .btn-gold {
      background: #c49a2a;
      color: white;
      padding: 11px 28px;
      border-radius: 30px;
      font-size: 0.85rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: 0.2s;
    }

    .btn-gold:hover {
      background: #a87820;
    }

    .btn-gold:disabled {
      background: #d4b37a;
      cursor: not-allowed;
    }

    .notice-box {
      background: #fafafa;
      border: 1px solid #e8e0d0;
      border-radius: 12px;
      padding: 20px;
      display: flex;
      gap: 14px;
      margin-bottom: 30px;
    }

    .error-message {
      color: #e63939;
      font-size: 0.82rem;
      margin-top: 6px;
      min-height: 22px;
    }

    .input-wrapper {
      position: relative;
    }

    .eye-icon {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      color: #777;
      font-size: 1.2rem;
      user-select: none;
    }

    .success-box {
      background: #f0fdf4;
      border: 1px solid #86efac;
      color: #166534;
      padding: 14px 18px;
      border-radius: 12px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .form-container {
      max-width: 420px;
      margin: 0 auto;
    }
  </style>
</head>

<body>

  <%- include('partials/user/header') %>

  <div style="max-width:1200px; margin:0 auto; padding:90px 24px 80px;">

    <%- include('partials/user/profileBanner', { user }) %>

    <div style="display:grid; grid-template-columns:230px 1fr; gap:24px;">

      <%- include('partials/user/profileSidebar', { activePage: 'password' }) %>

      <!-- MAIN CONTENT -->
      <main style="background:#fff; border-radius:18px; padding:40px; border:1px solid #e8e0d0; box-shadow:0 2px 8px rgba(0,0,0,0.04);">

        <!-- HEADER -->
        <div style="display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid #f0ece4; padding-bottom:18px; margin-bottom:28px;">
          <h3 style="font-family:'Cormorant Garamond',serif; font-size:1.3rem; font-weight:700;">
            Password & Security
          </h3>
        </div>

        <!-- NOTICE -->
        <div class="notice-box">
          <div style="font-size:1.4rem;">🛡️</div>
          <div class="notice-text">
            <h4>Set a Password</h4>
            <p>You currently log in using a social account. Set a password to allow logging in with your email address directly.</p>
          </div>
        </div>

        <!-- SUCCESS MESSAGE CONTAINER -->
        <div id="successContainer"></div>

        <!-- CENTERED FORM -->
        <div class="form-container">
          <form id="passwordForm">

            <div style="margin-bottom:18px;">
              <label class="field-label">Old Password</label>
              <div class="input-wrapper">
                <input type="password" id="oldPassword" name="oldPassword" class="field-input" autocomplete="current-password">
                <span class="eye-icon" onclick="togglePassword('oldPassword')">👁️</span>
              </div>
              <div id="oldError" class="error-message"></div>
            </div>

            <div style="margin-bottom:18px;">
              <label class="field-label">New Password</label>
              <div class="input-wrapper">
                <input type="password" id="newPassword" name="newPassword" class="field-input" autocomplete="new-password">
                <span class="eye-icon" onclick="togglePassword('newPassword')">👁️</span>
              </div>
              <div id="newError" class="error-message"></div>
            </div>

            <div style="margin-bottom:26px;">
              <label class="field-label">Confirm New Password</label>
              <div class="input-wrapper">
                <input type="password" id="confirmPassword" name="confirmPassword" class="field-input" autocomplete="new-password">
                <span class="eye-icon" onclick="togglePassword('confirmPassword')">👁️</span>
              </div>
              <div id="confirmError" class="error-message"></div>
            </div>

            <button type="submit" id="submitBtn" class="btn-gold w-full">
              Update Password
            </button>

          </form>
        </div>

      </main>

    </div>
  </div>

  <%- include('partials/user/footer') %>

  <script>
    // Toggle Password Visibility
    function togglePassword(fieldId) {
      const input = document.getElementById(fieldId);
      const icon = input.parentElement.querySelector('.eye-icon');

      if (input.type === "password") {
        input.type = "text";
        icon.textContent = "🙈";
      } else {
        input.type = "password";
        icon.textContent = "👁️";
      }
    }

    // Clear all error messages
    function clearErrors() {
      document.getElementById('oldError').textContent = '';
      document.getElementById('newError').textContent = '';
      document.getElementById('confirmError').textContent = '';
    }

    // Show Success Message
    function showSuccessMessage(message) {
      const container = document.getElementById('successContainer');
      container.innerHTML = `
        <div class="success-box" id="successBox">
          <span style="font-size:1.3rem;">✅</span>
          <span>${message}</span>
        </div>
      `;

      // Auto hide after 6 seconds
      setTimeout(() => {
        const successBox = document.getElementById('successBox');
        if (successBox) {
          successBox.style.transition = 'opacity 0.6s ease';
          successBox.style.opacity = '0';
          setTimeout(() => {
            if (successBox) successBox.remove();
          }, 600);
        }
      }, 6000);
    }

    // Clear form fields after successful update
    function clearForm() {
      document.getElementById('oldPassword').value = '';
      document.getElementById('newPassword').value = '';
      document.getElementById('confirmPassword').value = '';
    }

    // Frontend Validation Function
    function validateForm() {
      clearErrors();
      let isValid = true;

      const oldPass = document.getElementById('oldPassword').value.trim();
      const newPass = document.getElementById('newPassword').value.trim();
      const confirmPass = document.getElementById('confirmPassword').value.trim();

      if (!oldPass) {
        document.getElementById('oldError').textContent = "Old password is required";
        isValid = false;
      }

      if (!newPass) {
        document.getElementById('newError').textContent = "New password is required";
        isValid = false;
      } else if (newPass.length < 8) {
        document.getElementById('newError').textContent = "Password must be at least 8 characters long";
        isValid = false;
      } else if (!/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/.test(newPass)) {
        document.getElementById('newError').textContent = "Password must contain at least one uppercase letter, one lowercase letter, and one number";
        isValid = false;
      }

      if (!confirmPass) {
        document.getElementById('confirmError').textContent = "Please confirm your new password";
        isValid = false;
      } else if (newPass !== confirmPass) {
        document.getElementById('confirmError').textContent = "Passwords do not match";
        isValid = false;
      }

      if (oldPass && newPass && oldPass === newPass) {
        document.getElementById('newError').textContent = "New password must be different from old password";
        isValid = false;
      }

      return isValid;
    }

    // ==================== AJAX SUBMIT ====================
    document.getElementById('passwordForm').addEventListener('submit', async function (e) {
      e.preventDefault();

      if (!validateForm()) {
        return;
      }

      const submitBtn = document.getElementById('submitBtn');
      const originalBtnText = submitBtn.textContent;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Updating...';

      const data = {
        oldPassword: document.getElementById('oldPassword').value.trim(),
        newPassword: document.getElementById('newPassword').value.trim(),
        confirmPassword: document.getElementById('confirmPassword').value.trim()
      };

      try {
        const response = await fetch('/resetPassword', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });

        const result = await response.json();

        if (response.ok && result.success) {
          showSuccessMessage(result.message || "Password updated successfully!");
          clearForm();                    // Clear the form fields
          clearErrors();                  // Clear any previous errors
        } else {
          if (result.field && result.message) {
            const errorElement = document.getElementById(result.field + 'Error');
            if (errorElement) {
              errorElement.textContent = result.message;
            }
          } else {
            alert(result.message || "An error occurred. Please try again.");
          }
        }
      } catch (error) {
        console.error(error);
        alert("Something went wrong. Please check your connection and try again.");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalBtnText;
      }
    });
  </script>

</body>
</html>