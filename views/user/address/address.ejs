<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Saved Addresses - Elanora</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: #fdfaf5;
      color: #2c2c2c;
    }

    .address-card {
      background: #fff;
      border: 1px solid #e8e0d0;
      border-radius: 16px;
      padding: 28px;
      transition: all 0.3s ease;
      position: relative;
    }

    .address-card.default {
      border-color: #c49a2a;
      background: #fffaf0;
      box-shadow: 0 0 0 3px rgba(196, 154, 42, 0.1);
    }

    .tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.85rem;
      font-weight: 600;
      color: #c49a2a;
      background: #f5edd8;
      padding: 6px 14px;
      border-radius: 9999px;
    }

    .default-badge {
      position: absolute;
      top: 20px;
      right: 20px;
      background: #c49a2a;
      color: white;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 5px 14px;
      border-radius: 9999px;
    }

    .action-btn {
      font-size: 0.85rem;
      font-weight: 500;
      padding: 8px 16px;
      border-radius: 9999px;
      transition: all 0.15s ease;
    }

    /* Page Messages */
    .page-message {
      padding: 14px 18px;
      border-radius: 12px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.95rem;
    }
    .success-msg {
      background: #ecfdf5;
      color: #0f766e;
      border: 1px solid #5eead4;
    }
    .error-msg {
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
    }

    /* Confirmation Modal */
    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.6);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }
    .modal-content {
      background: white;
      border-radius: 16px;
      width: 90%;
      max-width: 400px;
      padding: 28px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .address-card.deleting {
      opacity: 0;
      transform: translateY(20px);
    }
  </style>
</head>
<body>

  <%- include('partials/user/header') %>

  <div style="max-width:1200px; margin:0 auto; padding:36px 24px 80px;">

    <%- include('partials/user/profileBanner', { user }) %>

    <div style="display:grid; grid-template-columns:230px 1fr; gap:24px;">

      <%- include('partials/user/profileSidebar', { activePage: 'addresses' }) %>

      <!-- Main Content -->
      <main style="background:#fff; border-radius:18px; padding:40px; border:1px solid #e8e0d0; box-shadow:0 2px 8px rgba(0,0,0,0.04);">



        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:32px;">
          <h3 id="addressCount" style="font-family:'Cormorant Garamond',serif; font-size:1.5rem; font-weight:700; color:#2c2c2c;">
            Saved Addresses (<%= addresses ? addresses.length : 0 %>)
          </h3>
          
          <a href="/addresses/add" 
             class="btn-gold flex items-center gap-2 text-sm font-medium px-6 py-3 rounded-2xl hover:shadow-md transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add New Address
          </a>
        </div>

        <!-- Addresses Grid -->
        <div id="addressesContainer" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <% if (addresses && addresses.length > 0) { %>
            <% addresses.forEach(function(addr) { %>
              <div class="address-card relative <%= addr.isDefault ? 'default' : '' %>" 
                   id="address-card-<%= addr._id %>">
                
                <% if (addr.isDefault) { %>
                  <div class="default-badge">✓ Default</div>
                <% } %>

                <div class="tag mb-5">
                  <%= addr.type === 'Home' ? '🏠' : addr.type === 'Office' ? '🏢' : '📍' %> 
                  <%= addr.type %>
                </div>

                <div class="text-sm leading-relaxed text-gray-700 mb-6">
                  <strong><%= addr.fullName %></strong><br>
                  <%= addr.addressLine %><br>
                  <%= addr.city %>, <%= addr.state %> <%= addr.pincode %><br>
                  India<br>
                  Phone: <%= addr.phone %>
                </div>

                <div class="flex flex-wrap gap-3 pt-4 border-t border-gray-100">
                  <a href="/addresses/edit/<%= addr._id %>" 
                     class="action-btn text-amber-700 hover:bg-amber-50 border border-amber-200">
                    Edit
                  </a>
                  
                  <button onclick="showDeleteModal('<%= addr._id %>')" 
                          class="action-btn text-red-600 hover:bg-red-50 border border-red-200">
                    Delete
                  </button>
                  
                  <% if (!addr.isDefault) { %>
                    <button onclick="showSetDefaultModal('<%= addr._id %>')" 
                            class="action-btn text-emerald-700 hover:bg-emerald-50 border border-emerald-200 ml-auto">
                      Set as Default
                    </button>
                  <% } %>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="col-span-2 text-center py-16 text-gray-500">
              <p class="text-lg mb-2">No addresses saved yet</p>
              <p class="text-sm">Add your first delivery address using the button above.</p>
            </div>
          <% } %>
        </div>

      </main>
    </div>
  </div>

  <!-- Confirmation Modal -->
  <div id="confirmationModal" class="modal">
    <div class="modal-content">
      <h3 id="modalTitle" class="text-xl font-semibold mb-2">Confirm Action</h3>
      <p id="modalMessage" class="text-gray-600 mb-8"></p>
      
      <div class="flex gap-3 justify-end">
        <button onclick="closeModal()" 
                class="px-6 py-3 text-gray-700 hover:bg-gray-100 rounded-2xl font-medium">
          Cancel
        </button>
        <button id="confirmBtn"
                class="px-6 py-3 text-white rounded-2xl font-medium">
          Confirm
        </button>
      </div>
    </div>
  </div>

  <%- include('partials/user/footer') %>

  <script>
    let currentAction = null;
    let currentId = null;

    function showPageSuccess(message) {
      if (typeof window.showToast === 'function') {
        window.showToast(message, 'success');
      } else {
        alert(message);
      }
    }

    function showPageError(message) {
      if (typeof window.showToast === 'function') {
        window.showToast(message, 'error');
      } else {
        alert(message);
      }
    }

    function showConfirmationModal(title, message, actionType, id) {
      currentAction = actionType;
      currentId = id;

      document.getElementById('modalTitle').textContent = title;
      document.getElementById('modalMessage').textContent = message;

      const confirmBtn = document.getElementById('confirmBtn');
      
      if (actionType === 'delete') {
        confirmBtn.textContent = "Yes, Delete";
        confirmBtn.className = "px-6 py-3 bg-red-600 hover:bg-red-700 text-white rounded-2xl font-medium";
      } else if (actionType === 'setDefault') {
        confirmBtn.textContent = "Yes, Set as Default";
        confirmBtn.className = "px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl font-medium";
      }

      document.getElementById('confirmationModal').style.display = 'flex';
    }

    function closeModal() {
      document.getElementById('confirmationModal').style.display = 'none';
      currentAction = null;
      currentId = null;
    }

    function showDeleteModal(id) {
      showConfirmationModal(
        "Delete Address?",
        "Are you sure you want to delete this address? This action cannot be undone.",
        'delete',
        id
      );
    }

    function showSetDefaultModal(id) {
      showConfirmationModal(
        "Set as Default?",
        "This will be your default delivery address for future orders.",
        'setDefault',
        id
      );
    }

    // Main function to handle confirmed actions
    async function executeAction() {
      if (!currentAction || !currentId) return;

      const modal = document.getElementById('confirmationModal');
      modal.style.display = 'none';

      try {
        let response;
        
        if (currentAction === 'delete') {
          response = await fetch(`/addresses/${currentId}/delete`, { 
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' }
          });
        } else if (currentAction === 'setDefault') {
          response = await fetch(`/addresses/${currentId}/default`, { 
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' }
          });
        }

        const result = await response.json();

        if (response.ok) {
          showPageSuccess(result.message || 
            (currentAction === 'delete' ? "Address deleted successfully" : "Default address updated successfully"));

          if (currentAction === 'delete') {
            // Smoothly remove the card from DOM
            const card = document.getElementById(`address-card-${currentId}`);
            if (card) {
              card.classList.add('deleting');
              
              setTimeout(() => {
                card.remove();

                // Update address count
                const countEl = document.getElementById('addressCount');
                if (countEl) {
                  let currentCount = parseInt(countEl.textContent.match(/\d+/)?.[0] || 0);
                  countEl.textContent = `Saved Addresses (${currentCount - 1})`;
                }

                // Show empty state if no addresses left
                if (document.querySelectorAll('.address-card').length === 0) {
                  document.getElementById('addressesContainer').innerHTML = `
                    <div class="col-span-2 text-center py-16 text-gray-500">
                      <p class="text-lg mb-2">No addresses saved yet</p>
                      <p class="text-sm">Add your first delivery address using the button above.</p>
                    </div>`;
                }
              }, 300);
            }
          } else {
            // For set default, reload to reflect changes
            setTimeout(() => window.location.reload(), 1000);
          }
        } else {
          showPageError(result.message || "Operation failed");
        }
      } catch (error) {
        console.error(error);
        showPageError("Something went wrong. Please try again.");
      }

      currentAction = null;
      currentId = null;
    }

    // Attach event listener to confirm button
    document.getElementById('confirmBtn').addEventListener('click', executeAction);
  </script>

</body>
</html>