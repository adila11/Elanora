<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Review Order – Elanora</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
  :root {
    --cream: #f9f4ef;
    --cream-dark: #f0e8de;
    --gold: #b8922a;
    --gold-light: #c9a020;
    --gold-pale: #e8d5a3;
    --text-dark: #2c2416;
    --text-mid: #5a4a38;
    --text-light: #9a8570;
    --white: #ffffff;
    --border: #e8ddd0;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--cream);
    color: var(--text-dark);
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    min-height: 100vh;
    display: flex; flex-direction: column;
  }

  /* ── NAV STYLES REMOVED TO USE PARTIAL STYLES ── */

  /* ── MAIN ── */
  main { flex: 1; padding: 110px 48px 64px; max-width: 1100px; margin: 0 auto; width: 100%; }

  .page-title {
    font-family: 'Jost', sans-serif; font-size: 1.5rem; font-weight: 400;
    text-align: center; color: var(--text-dark);
    margin-bottom: 32px; letter-spacing: 0.02em;
  }

  /* ── STEPPER ── */
  .stepper {
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 40px;
  }
  .step { display: flex; align-items: center; gap: 10px; font-size: 0.85rem; color: var(--text-light); }
  .step.done { color: var(--text-mid); }
  .step.done .step-num { border-color: var(--gold); background: var(--gold); color: var(--white); }
  .step.active { color: var(--gold); }
  .step.active .step-num { border-color: var(--gold); color: var(--gold); background: var(--white); }
  .step-num {
    width: 30px; height: 30px; border-radius: 50%;
    border: 1.5px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.8rem; font-weight: 500; color: var(--text-light);
    background: var(--white); flex-shrink: 0;
  }
  .step.done .step-num svg { width: 13px; height: 13px; stroke: var(--white); fill: none; stroke-width: 2.5; }
  .step-label { font-size: 0.85rem; letter-spacing: 0.03em; }
  .step-line { flex: 1; max-width: 180px; height: 1px; background: var(--border); margin: 0 16px; }
  .step-line.done { background: var(--gold); }

  /* ── LAYOUT ── */
  .checkout-layout {
    display: grid; grid-template-columns: 1fr 360px;
    gap: 24px; align-items: start;
  }

  /* ── CARD ── */
  .card {
    background: var(--white); border-radius: 16px;
    padding: 32px; box-shadow: 0 2px 16px rgba(44,36,22,0.06);
  }

  /* ── SECTION HEADER ── */
  .section-title-row {
    display: flex; align-items: center; gap: 10px;
    font-size: 1.05rem; font-weight: 500; color: var(--text-dark);
    margin-bottom: 28px;
  }
  .section-title-row svg { width: 20px; height: 20px; stroke: var(--gold); fill: none; stroke-width: 1.5; }

  /* ── REVIEW BLOCK ── */
  .review-block {
    border: 1px solid var(--border); border-radius: 12px;
    overflow: hidden; margin-bottom: 24px;
  }
  .review-row {
    padding: 20px 22px;
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 16px;
  }
  .review-row:not(:last-child) { border-bottom: 1px solid var(--border); }
  .review-row-left {}
  .review-row-label {
    font-size: 0.88rem; font-weight: 500;
    color: var(--text-dark); margin-bottom: 6px;
  }
  .review-row-value {
    font-size: 0.84rem; color: var(--text-mid); line-height: 1.6;
  }
  .btn-edit {
    font-size: 0.8rem; color: var(--gold); font-weight: 400;
    background: none; border: none; cursor: pointer;
    padding: 2px 0; flex-shrink: 0;
    transition: opacity 0.2s;
    text-decoration: none;
  }
  .btn-edit:hover { opacity: 0.7; }

  /* ── TERMS NOTE ── */
  .terms-note {
    display: flex; align-items: center; gap: 10px;
    font-size: 0.8rem; color: var(--text-light); line-height: 1.6;
    margin-bottom: 0;
  }
  .terms-note svg { width: 16px; height: 16px; stroke: var(--text-light); fill: none; stroke-width: 1.5; flex-shrink: 0; }
  .terms-note a { color: var(--gold); text-decoration: none; }
  .terms-note a:hover { text-decoration: underline; }

  /* ── DIVIDER ── */
  .divider { height: 1px; background: var(--border); margin: 28px 0; }

  /* ── BOTTOM ROW ── */
  .bottom-row {
    display: flex; align-items: center; justify-content: space-between;
  }
  .btn-back {
    font-size: 0.85rem; color: var(--text-mid);
    background: none; border: none; cursor: pointer;
    display: flex; align-items: center; gap: 6px;
    transition: color 0.2s;
  }
  .btn-back:hover { color: var(--gold); }
  .btn-back svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; }
  .btn-place {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--gold); color: var(--white);
    font-family: 'Jost', sans-serif; font-size: 0.9rem; font-weight: 400;
    letter-spacing: 0.04em; padding: 14px 36px;
    border: none; cursor: pointer; border-radius: 50px;
    transition: background 0.25s, transform 0.2s;
  }
  .btn-place:hover { background: var(--gold-light); transform: translateY(-1px); }
  .btn-place svg { width: 18px; height: 18px; stroke: var(--white); fill: none; stroke-width: 2; }

  /* ── ORDER SUMMARY ── */
  .summary-title { font-size: 1rem; font-weight: 500; color: var(--text-dark); margin-bottom: 20px; }
  .cart-item {
    display: flex; align-items: center; gap: 14px;
    padding-bottom: 20px; border-bottom: 1px solid var(--border); margin-bottom: 16px;
  }
  .cart-thumb {
    width: 60px; height: 60px; background: var(--cream-dark); border-radius: 6px;
    flex-shrink: 0; display: flex; align-items: center; justify-content: center;
  }
  .cart-thumb svg { width: 26px; height: 26px; stroke: var(--text-light); fill: none; }
  .cart-item-name { font-size: 0.88rem; font-weight: 500; color: var(--text-dark); margin-bottom: 3px; }
  .cart-item-qty  { font-size: 0.78rem; color: var(--text-light); }
  .cart-item-price { font-size: 0.88rem; font-weight: 500; color: var(--gold); margin-top: 3px; }

  /* Totals */
  .totals { margin-top: 4px; }
  .total-row {
    display: flex; justify-content: space-between;
    align-items: center; margin-bottom: 10px;
  }
  .total-row .label { font-size: 0.83rem; color: var(--text-mid); }
  .total-row .value { font-size: 0.83rem; color: var(--text-dark); }
  .total-final {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border);
  }
  .total-final .label { font-size: 0.9rem; font-weight: 500; color: var(--text-dark); }
  .total-final .amount {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem; font-weight: 500; color: var(--gold);
  }

  /* ── FOOTER ── */
  footer { background: var(--white); border-top: 1px solid var(--border); margin-top: auto; }
  .footer-top {
    max-width: 1100px; margin: 0 auto;
    padding: 56px 48px 40px;
    display: grid; grid-template-columns: 2fr 1fr 1fr 1.6fr; gap: 48px;
  }
  .footer-logo {
    display: flex; align-items: center; gap: 8px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem; font-weight: 500; color: var(--gold); margin-bottom: 14px;
  }
  .footer-logo svg { width: 20px; height: 20px; fill: var(--gold); }
  .footer-brand p { font-size: 0.82rem; line-height: 1.8; color: var(--text-light); max-width: 240px; }
  .social-links { display: flex; gap: 10px; margin-top: 20px; }
  .social-links a {
    width: 36px; height: 36px; border-radius: 50%;
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    text-decoration: none; transition: border-color 0.2s, background 0.2s;
  }
  .social-links a:hover { border-color: var(--gold); background: #fdf8f3; }
  .social-links svg { width: 14px; height: 14px; fill: var(--text-mid); }
  .footer-col h4 {
    font-size: 0.78rem; font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--text-dark); margin-bottom: 18px;
  }
  .footer-col ul { list-style: none; }
  .footer-col ul li { margin-bottom: 10px; }
  .footer-col ul li a { font-size: 0.83rem; color: var(--text-light); text-decoration: none; transition: color 0.2s; }
  .footer-col ul li a:hover { color: var(--gold); }
  .footer-newsletter p { font-size: 0.82rem; color: var(--text-light); line-height: 1.7; margin-bottom: 14px; }
  .newsletter-input {
    width: 100%; border: 1px solid var(--border); border-radius: 6px;
    padding: 11px 14px; font-family: 'Jost', sans-serif; font-size: 0.82rem;
    color: var(--text-dark); background: var(--white); outline: none;
    margin-bottom: 10px; transition: border-color 0.2s;
  }
  .newsletter-input:focus { border-color: var(--gold); }
  .newsletter-input::placeholder { color: var(--text-light); }
  .btn-subscribe {
    width: 100%; background: var(--gold); border: none; border-radius: 6px;
    padding: 12px; color: var(--white);
    font-family: 'Jost', sans-serif; font-size: 0.8rem;
    letter-spacing: 0.08em; cursor: pointer; transition: background 0.2s;
  }
  .btn-subscribe:hover { background: var(--gold-light); }
  .footer-bottom {
    border-top: 1px solid var(--border); padding: 20px 48px;
    max-width: 1100px; margin: 0 auto;
    display: flex; justify-content: space-between; align-items: center;
  }
  .footer-bottom p { font-size: 0.76rem; color: var(--text-light); }
  .footer-bottom a { font-size: 0.76rem; color: var(--text-light); text-decoration: none; margin-left: 20px; }
  .footer-bottom a:hover { color: var(--gold); }
</style>
</head>
<body>

<%- include('../../partials/user/header') %>

<!-- MAIN -->
<main>
  <h1 class="page-title">Secure Checkout</h1>

  <!-- STEPPER -->
  <div class="stepper">
    <div class="step done">
      <div class="step-num"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
      <span class="step-label">Shipping</span>
    </div>
    <div class="step-line done"></div>
    <div class="step done">
      <div class="step-num"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
      <span class="step-label">Payment</span>
    </div>
    <div class="step-line done"></div>
    <div class="step active">
      <div class="step-num">3</div>
      <span class="step-label">Review</span>
    </div>
  </div>

  <div class="checkout-layout">

    <!-- LEFT: Review -->
    <div class="card">

      <div class="section-title-row">
        <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Review Order
      </div>

      <div class="review-block">
        <!-- Shipping -->
        <div class="review-row">
          <div class="review-row-left">
            <div class="review-row-label">Shipping To</div>
            <div class="review-row-value"><%= address.fullName %>, <%= address.addressLine %>, <%= address.city %>, <%= address.state %> <%= address.pincode %></div>
          </div>
          <a href="/checkout/address" class="btn-edit">Edit</a>
        </div>
        <!-- Payment -->
        <div class="review-row">
          <div class="review-row-left">
            <div class="review-row-label">Payment Method</div>
            <div class="review-row-value" style="text-transform: capitalize;"><%= paymentMethod %></div>
          </div>
          <a href="/checkout/payment?addressId=<%= address._id %>" class="btn-edit">Edit</a>
        </div>
      </div>

      <!-- Terms -->
      <div class="terms-note">
        <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        By clicking "Place Order", you agree to our <a href="#">Terms and Conditions.</a>
      </div>

      <div class="divider"></div>

      <div class="bottom-row">
        <button class="btn-back" onclick="history.back()">
          <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
          Back
        </button>
        <button class="btn-place" id="placeOrderBtn">
          Place Order
          <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>

    </div>

    <!-- RIGHT: Order Summary -->
    <div class="card">
      <div class="summary-title">In Your Cart</div>

      <% 
        let subtotal = 0;
        if (cart && cart.items && cart.items.length > 0) {
          cart.items.forEach(item => {
            const product = item.productId;
            if (!product) return;
            const price = product.discountPrice || product.basePrice;
            subtotal += price * item.qty;
            const variant = product.variants ? product.variants.find(v => v._id.toString() === item.variantId.toString()) : null;
            const imageUrl = variant && variant.images && variant.images.length > 0 ? variant.images[0].url : 'https://via.placeholder.com/60';
            const variantName = variant ? variant.color : '';
      %>
      <div class="cart-item">
        <div class="cart-thumb">
          <img src="<%= imageUrl %>" alt="<%= product.name %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none'">
        </div>
        <div class="cart-item-info">
          <div class="cart-item-name"><%= product.name %> <%= variantName ? `(${variantName})` : '' %></div>
          <div class="cart-item-qty">Qty: <%= item.qty %></div>
          <div class="cart-item-price" style="margin-top:4px;">₹<%= (price * item.qty).toLocaleString('en-IN') %></div>
        </div>
      </div>
      <% 
          });
        }
      %>

      <div class="totals">
        <div class="total-row">
          <span class="label">Subtotal</span>
          <span class="value">₹<%= subtotal.toLocaleString('en-IN') %></span>
        </div>
        <div class="total-row">
          <span class="label">Shipping</span>
          <span class="value">Free</span>
        </div>
        <div class="total-final">
          <span class="label">Total</span>
          <span class="amount">₹<%= subtotal.toLocaleString('en-IN') %></span>
        </div>
      </div>
    </div>

  </div>
</main>

<%- include('../../partials/user/footer') %>

<script>
  document.getElementById('placeOrderBtn').addEventListener('click', async function() {
    var btn = this;
    btn.disabled = true;
    btn.innerHTML = '<svg viewBox="0 0 24 24" width="18" height="18" stroke="white" fill="none" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg> Placing Order…';

    try {
      var res = await fetch('/place-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({
          addressId: '<%= address._id %>',
          paymentMethod: '<%= paymentMethod %>'
        }),
      });

      var data = await res.json().catch(function() { return {}; });

      if (!res.ok || !data.success) {
        throw new Error(data.message || 'Failed to place order.');
      }

      // Redirect to order confirmation
      window.location.href = data.redirectUrl || '/order-confirmation';

    } catch(err) {
      alert(err.message);
      btn.disabled = false;
      btn.innerHTML = 'Place Order <svg viewBox="0 0 24 24" width="18" height="18" stroke="white" fill="none" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>';
    }
  });
</script>

</body>
</html>