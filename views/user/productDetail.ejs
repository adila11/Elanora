<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= product.name %> – Elanora
    </title>
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap"
        rel="stylesheet" />
    <style>
        :root {
            --cream: #f5f0ea;
            --warm-white: #faf8f5;
            --gold: #b8892a;
            --gold-light: #d4a843;
            --gold-pale: #f0e0bb;
            --text-dark: #1c1a17;
            --text-mid: #4a4540;
            --text-light: #8a8078;
            --border: #e8dfd4;
            --card-bg: #ffffff;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Jost', sans-serif;
            background: var(--cream);
            color: var(--text-dark);
            font-weight: 300;
        }


        /* BREADCRUMB */
        .breadcrumb {
            max-width: 1100px;
            margin: 90px auto 20px;
            padding: 0 24px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.8rem;
            color: var(--text-light);
        }

        .breadcrumb a {
            text-decoration: none;
            color: var(--text-light);
            transition: color 0.2s;
        }

        .breadcrumb a:hover {
            color: var(--gold);
        }

        .breadcrumb span {
            color: var(--text-dark);
        }

        .breadcrumb svg {
            width: 12px;
            height: 12px;
        }

        /* PRODUCT SECTION */
        .product-section {
            max-width: 1100px;
            margin: 0 auto 48px;
            padding: 0 24px;
        }

        .product-card-wrap {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 28px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }

        /* LEFT – Images */
        .img-col {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        /* MAGNIFIER */
        .main-img-wrap {
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            background: var(--cream);
            aspect-ratio: 1/1;
            cursor: crosshair;
        }

        .main-img-wrap img#mainImg {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            pointer-events: none;
            user-select: none;
        }

        .magnifier-glass {
            position: absolute;
            border: 2px solid var(--gold);
            border-radius: 50%;
            width: 120px;
            height: 120px;
            pointer-events: none;
            display: none;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.18);
            background-repeat: no-repeat;
            z-index: 10;
            transform: translate(-50%, -50%);
        }

        .main-img-wrap:hover .magnifier-glass {
            display: block;
        }

        .wishlist-main {
            position: absolute;
            top: 12px;
            right: 12px;
            background: rgba(255, 255, 255, 0.9);
            border: none;
            border-radius: 50%;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--text-light);
            transition: color 0.2s, background 0.2s;
            z-index: 11;
        }

        .wishlist-main:hover {
            color: #e05050;
        }

        .wishlist-main.liked {
            color: #e05050;
        }

        .wishlist-main.liked svg {
            fill: #e05050;
        }

        .thumbnails {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .thumb {
            width: 80px;
            height: 80px;
            border-radius: 8px;
            overflow: hidden;
            border: 2px solid transparent;
            cursor: pointer;
            transition: border-color 0.2s;
            flex-shrink: 0;
        }

        .thumb.active {
            border-color: var(--gold);
        }

        .thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* RIGHT – Info */
        .info-col {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .info-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 10px;
        }

        .product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            font-weight: 600;
            color: var(--text-dark);
            line-height: 1.2;
        }

        .share-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-light);
            padding: 4px;
            transition: color 0.2s;
        }

        .share-btn:hover {
            color: var(--gold);
        }

        .rating-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 14px;
        }

        .stars {
            display: flex;
            gap: 2px;
        }

        .star {
            color: var(--gold);
            font-size: 0.9rem;
        }

        .star.empty {
            color: var(--border);
        }

        .rating-text {
            font-size: 0.82rem;
            color: var(--text-light);
        }

        .price {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.2rem;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 14px;
        }

        .description {
            font-size: 0.86rem;
            color: var(--text-light);
            line-height: 1.75;
            margin-bottom: 24px;
            padding-bottom: 24px;
            border-bottom: 1px solid var(--border);
        }

        .option-label {
            font-size: 0.78rem;
            font-weight: 500;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-mid);
            margin-bottom: 12px;
        }

        .color-options {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
        }

        .color-opt {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }

        .color-swatch {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 2px solid transparent;
            transition: border-color 0.2s, transform 0.15s;
        }

        .color-opt.active .color-swatch {
            border-color: var(--gold);
            transform: scale(1.1);
        }

        .color-name {
            font-size: 0.75rem;
            color: var(--text-light);
        }

        .qty-label {
            font-size: 0.78rem;
            font-weight: 500;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-mid);
            margin-bottom: 10px;
        }

        .qty-row {
            display: flex;
            align-items: center;
            gap: 0;
            margin-bottom: 24px;
        }

        .qty-btn {
            width: 36px;
            height: 36px;
            border: 1px solid var(--border);
            background: var(--cream);
            cursor: pointer;
            font-size: 1.1rem;
            color: var(--text-mid);
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .qty-btn:first-child {
            border-radius: 8px 0 0 8px;
        }

        .qty-btn:last-child {
            border-radius: 0 8px 8px 0;
        }

        .qty-btn:hover {
            background: var(--gold-pale);
            color: var(--gold);
        }

        .qty-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .qty-display {
            width: 48px;
            height: 36px;
            border: 1px solid var(--border);
            border-left: none;
            border-right: none;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            font-weight: 500;
            background: var(--card-bg);
        }

        .qty-note {
            font-size: 0.73rem;
            color: var(--text-light);
            margin-top: -18px;
            margin-bottom: 20px;
        }

        .divider-line {
            height: 1px;
            background: var(--border);
            margin: 4px 0 20px;
        }

        /* CTA BUTTONS */
        .cta-row {
            display: flex;
            gap: 12px;
            margin-bottom: 24px;
        }

        .btn-cart {
            flex: 1;
            background: var(--gold);
            color: #fff;
            border: none;
            border-radius: 100px;
            padding: 14px 20px;
            font-family: 'Jost', sans-serif;
            font-size: 0.88rem;
            font-weight: 500;
            letter-spacing: 0.06em;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background 0.2s, transform 0.15s;
        }

        .btn-cart:hover {
            background: var(--gold-light);
            transform: scale(1.01);
        }

        .btn-cart.in-cart {
            background: var(--text-mid);
            cursor: default;
        }

        .btn-cart.in-cart:hover {
            background: var(--text-mid);
            transform: none;
        }

        .btn-wish {
            flex: 1;
            background: transparent;
            color: var(--gold);
            border: 1.5px solid var(--gold);
            border-radius: 100px;
            padding: 14px 20px;
            font-family: 'Jost', sans-serif;
            font-size: 0.88rem;
            font-weight: 500;
            letter-spacing: 0.06em;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s;
        }

        .btn-wish:hover {
            background: var(--gold-pale);
        }

        .btn-wish.in-wishlist {
            background: #fde8e8;
            color: #c0392b;
            border-color: #c0392b;
        }

        .btn-wish.in-wishlist:hover {
            background: #fbd5d5;
        }

        .perks {
            display: flex;
            gap: 16px;
        }

        .perk {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            flex: 1;
            background: var(--cream);
            border-radius: 10px;
            padding: 12px;
        }

        .perk svg {
            flex-shrink: 0;
            color: var(--gold);
            margin-top: 2px;
        }

        .perk-text strong {
            display: block;
            font-size: 0.82rem;
            font-weight: 500;
            color: var(--text-dark);
        }

        .perk-text span {
            font-size: 0.75rem;
            color: var(--text-light);
        }

        /* TABS */
        .tabs-section {
            max-width: 1100px;
            margin: 0 auto 48px;
            padding: 0 24px;
        }

        .tab-nav {
            display: flex;
            gap: 0;
            border-bottom: 1px solid var(--border);
            margin-bottom: 28px;
        }

        .tab-btn {
            padding: 12px 24px;
            font-family: 'Jost', sans-serif;
            font-size: 0.88rem;
            font-weight: 400;
            color: var(--text-light);
            background: none;
            border: none;
            border-bottom: 2px solid transparent;
            cursor: pointer;
            transition: all 0.2s;
            letter-spacing: 0.04em;
        }

        .tab-btn.active {
            color: var(--gold);
            border-bottom-color: var(--gold);
            font-weight: 500;
        }

        .tab-btn:hover {
            color: var(--text-dark);
        }

        .tab-panel {
            display: none;
        }

        .tab-panel.active {
            display: block;
        }

        .product-details-content h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 14px;
            color: var(--text-dark);
        }

        .product-details-content p {
            font-size: 0.88rem;
            color: var(--text-light);
            line-height: 1.8;
            margin-bottom: 14px;
        }

        .feature-list {
            list-style: none;
            margin-top: 8px;
        }

        .feature-list li {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.87rem;
            color: var(--text-mid);
            padding: 7px 0;
            border-bottom: 1px solid var(--border);
        }

        .feature-list li:last-child {
            border-bottom: none;
        }

        .feature-list li svg {
            color: var(--gold);
            flex-shrink: 0;
        }

        /* Reviews */
        .reviews-grid {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .review-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 18px 20px;
        }

        .reviewer {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
        }

        .avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--gold-pale);
            color: var(--gold);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .reviewer-name {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-dark);
        }

        .reviewer-date {
            font-size: 0.75rem;
            color: var(--text-light);
        }

        .review-text {
            font-size: 0.85rem;
            color: var(--text-mid);
            line-height: 1.7;
        }

        /* YOU MAY ALSO LIKE */
        .related-section {
            max-width: 1100px;
            margin: 0 auto 60px;
            padding: 0 24px;
        }

        .section-heading {
            text-align: center;
            margin-bottom: 6px;
        }

        .section-heading h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            font-weight: 400;
            color: var(--text-dark);
        }

        .section-sub {
            text-align: center;
            font-size: 0.85rem;
            color: var(--text-light);
            margin-bottom: 28px;
        }

        .related-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .related-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
            transition: box-shadow 0.25s, transform 0.25s;
        }

        .related-card:hover {
            box-shadow: 0 8px 32px rgba(184, 137, 42, 0.12);
            transform: translateY(-3px);
        }

        .r-img-wrap {
            position: relative;
            aspect-ratio: 1/1;
            overflow: hidden;
            background: var(--cream);
        }

        .r-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s;
        }

        .related-card:hover .r-img-wrap img {
            transform: scale(1.05);
        }

        .r-wish {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(255, 255, 255, 0.85);
            border: none;
            border-radius: 50%;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--text-light);
            transition: color 0.2s;
        }

        .r-wish:hover {
            color: #e05050;
        }

        .r-body {
            padding: 12px 14px 14px;
            text-align: center;
        }

        .r-category {
            font-size: 0.7rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-light);
            margin-bottom: 4px;
        }

        .r-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 4px;
        }

        /* LIMITED STOCK BADGE STYLES */
        .stock-bar-wrap {
            margin-bottom: 16px;
            padding: 8px 14px;
            border-radius: 8px;
            font-size: 0.82rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
            width: fit-content;
        }

        .stock-bar-wrap.limited {
            background: #fdf2f2;
            border: 1px solid #f8d7da;
            color: #c0392b;
        }

        .stock-bar-wrap.out-of-stock {
            background: #fdf0ee;
            border: 1px solid #f5c6cb;
            color: #721c24;
        }
    </style>
</head>

<body>

    <%- include('partials/user/header') %>

        <!-- BREADCRUMB -->
        <div class="breadcrumb">
            <a href="/">Home</a>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6" />
            </svg>
            <a href="/shop">Shop</a>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6" />
            </svg>
            <span>
                <%= product.name %>
            </span>
        </div>

        <!-- PRODUCT DETAIL -->
        <section class="product-section">
            <div class="product-card-wrap">

                <% const firstVariant=product.variants.length> 0 ? product.variants[0] : null;
                    const initialImages = firstVariant ? firstVariant.images.map(img => img.url) :
                    ['https://via.placeholder.com/600'];
                    const initialImg = initialImages[0];
                    const variantsJson = JSON.stringify(product.variants.map(v => ({
                    id: v._id.toString(),
                    color: v.color,
                    stock: v.stock,
                    images: v.images.map(i => i.url)
                    })));
                    %>

                    <!-- LEFT: Images -->
                    <div class="img-col">
                        <div class="main-img-wrap" id="mainImgWrap">
                            <img id="mainImg" src="<%= initialImg %>" alt="<%= product.name %>" />
                            <div class="magnifier-glass" id="magnifierGlass"></div>
                            <button class="wishlist-main" id="wishBtnImg" title="Toggle Wishlist"
                                onclick="toggleWishlist(event)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path
                                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                </svg>
                            </button>
                        </div>
                        <div class="thumbnails" id="thumbnailsRow">
                            <% initialImages.forEach((imgUrl, idx)=> { %>
                                <div class="thumb <%= idx === 0 ? 'active' : '' %>"
                                    onclick="switchImg(this, '<%= imgUrl %>')">
                                    <img src="<%= imgUrl %>" alt="" />
                                </div>
                                <% }) %>
                        </div>
                    </div>

                    <!-- RIGHT: Info -->
                    <div class="info-col">
                        <div class="rating-row">
                            <div class="stars">
                                <span class="star">★</span><span class="star">★</span><span class="star">★</span>
                                <span class="star">★</span><span class="star empty">★</span>
                            </div>
                            <span class="rating-text">New Arrival</span>
                        </div>

                        <div class="info-top">
                            <h1 class="product-name">
                                <%= product.name %>
                            </h1>
                            <button class="share-btn" title="Share">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <circle cx="18" cy="5" r="3" />
                                    <circle cx="6" cy="12" r="3" />
                                    <circle cx="18" cy="19" r="3" />
                                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
                                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
                                </svg>
                            </button>
                        </div>

                        <div class="price-section"
                            style="display:flex; align-items:baseline; gap:12px; margin-bottom:12px;">
                            <span class="price" style="font-size:24px; font-weight:600;">₹<%= (product.discountPrice ||
                                    product.basePrice).toLocaleString('en-IN') %></span>
                            <% if (product.discountPrice && product.discountPrice < product.basePrice) { %>
                                <span class="original-price"
                                    style="text-decoration:line-through; color:var(--muted); font-size:16px;">₹<%=
                                        product.basePrice.toLocaleString('en-IN') %></span>
                                <% if (typeof offerActive !=='undefined' && offerActive && typeof offerName
                                    !=='undefined' && offerName) { %>
                                    <span class="offer-tag"
                                        style="background:var(--accent-light); color:#8a6a2f; font-size:12px; font-weight:600; padding:4px 8px; border-radius:12px; margin-left:4px;">
                                        <%= offerName %> (<%= offerDiscountValue %>
                                                <%= offerDiscountType==='flat' ? '₹' : '%' %> OFF)
                                    </span>
                                    <% } %>
                                        <% } %>
                        </div>

                        <p class="description">
                            <%= product.description %>
                        </p>

                        <div class="option-label">Available Colors</div>
                        <div class="color-options" id="colorOptions">
                            <% product.variants.forEach((v, idx)=> { %>
                                <div class="color-opt <%= idx === 0 ? 'active' : '' %>"
                                    onclick="selectVariant('<%= v._id %>', '<%= v.color %>', this)">
                                    <div class="color-swatch"
                                        style="background: <%= v.color.toLowerCase() === 'gold' ? '#c9a84c' : (v.color.toLowerCase() === 'silver' ? '#a8a8a8' : v.color) %>">
                                    </div>
                                    <span class="color-name">
                                        <%= v.color %>
                                    </span>
                                </div>
                                <% }) %>
                        </div>

                        <div class="qty-label">Quantity</div>
                        <div class="qty-row">
                            <button class="qty-btn" id="qtyMinus" onclick="changeQty(-1)">−</button>
                            <div class="qty-display" id="qtyDisplay">1</div>
                            <button class="qty-btn" id="qtyPlus" onclick="changeQty(1)">+</button>
                        </div>
                        <p class="qty-note">Maximum 10 items per order</p>

                        <!-- STOCK BADGE -->
                        <div id="stockBarWrap" class="stock-bar-wrap" style="display: none;">
                            <span id="stockBarText"></span>
                        </div>

                        <div class="divider-line"></div>

                        <div class="cta-row">
                            <button class="btn-cart" id="addCartBtn" onclick="addToCart()">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <circle cx="9" cy="21" r="1" />
                                    <circle cx="20" cy="21" r="1" />
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                                </svg>
                                Add to Cart
                            </button>
