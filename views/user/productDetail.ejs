    <!-- YOU MAY ALSO LIKE -->
    <section class="related-section">
    <div class="section-heading"><h2>You May Also Like</h2></div>
    <p class="section-sub">Handpicked pieces that complement your style</p>
    <div class="related-grid">
        <% if (relatedProducts && relatedProducts.length > 0) { %>
            <% relatedProducts.forEach(rp => { %>
                <% 
                   const rFirstVariant = rp.variants && rp.variants.length > 0 ? rp.variants[0] : null;
                   const rImageUrl = rFirstVariant && rFirstVariant.images && rFirstVariant.images.length > 0 
                                   ? rFirstVariant.images[0].url 
                                   : 'https://via.placeholder.com/400';
                %>
                <div class="related-card" onclick="location.href='/product/<%= rp._id %>'" style="cursor:pointer">
                <div class="r-img-wrap">
                    <img src="<%= rImageUrl %>" alt="<%= rp.name %>"/>
                    <button class="r-wish" onclick="event.stopPropagation();">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    </button>
                </div>
                <div class="r-body">
                    <div class="r-category"><%= rp.category?.name || 'Uncategorized' %></div>
                    <div class="r-name"><%= rp.name %></div>
                    <div class="r-price">₹<%= (rp.discountPrice || rp.basePrice).toLocaleString('en-IN') %></div>
                </div>
                </div>
            <% }) %>
        <% } else { %>
            <p style="grid-column: 1 / -1; text-align: center; color: var(--text-light);">Explore our other collections for more inspirations.</p>
        <% } %>
    </div>
    </section>

    <%- include('partials/user/footer') %>

    <script>
    let selectedVariantId = '<%= product.variants.length > 0 ? product.variants[0]._id : "" %>';

    function selectVariant(id, color, el) {
        selectedVariantId = id;
        document.querySelectorAll('.color-opt').forEach(o => o.classList.remove('active'));
        el.classList.add('active');
        // Optional: Filter images based on selected variant color
        console.log('Selected variant:', id, color);
    }

    function changeQty(d) {
        qty = Math.max(1, qty + d);
        document.getElementById('qtyDisplay').textContent = qty;
    }

    function addToCart() {
        console.log('Adding to cart:', selectedVariantId, 'Quantity:', qty);
        // Add real cart logic here
    }

    function switchImg(thumb, src) {
        document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
        thumb.classList.add('active');
        document.getElementById('mainImg').src = src;
    }

    function switchTab(btn, id) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById(id).classList.add('active');
    }
    </script>
    </body>
