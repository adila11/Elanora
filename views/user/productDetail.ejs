        </section>

        <!-- YOU MAY ALSO LIKE -->
        <section class="related-section">
            <div class="section-heading">
                <h2>You May Also Like</h2>
            </div>
            <p class="section-sub">Handpicked pieces that complement your style</p>
            <div class="related-grid">
                <% if (relatedProducts && relatedProducts.length> 0) { %>
                    <% relatedProducts.forEach(rp=> { %>
                        <% const rFirstVariant=rp.variants && rp.variants.length> 0 ? rp.variants[0] : null;
                            const rImageUrl = rFirstVariant && rFirstVariant.images && rFirstVariant.images.length > 0
                            ? rFirstVariant.images[0].url
                            : 'https://via.placeholder.com/400'; %>
                            <div class="related-card" onclick="location.href='/product/<%= rp._id %>'"
                                style="cursor:pointer">
                                <div class="r-img-wrap">
                                    <img src="<%= rImageUrl %>" alt="<%= rp.name %>" />
                                    <button class="r-wish" onclick="event.stopPropagation();">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2">
                                            <path
                                                d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                        </svg>
                                    </button>
                                </div>
                                <div class="r-body">
                                    <div class="r-category">
                                        <%= rp.category?.name || 'Uncategorized' %>
                                    </div>
                                    <div class="r-name">
                                        <%= rp.name %>
                                    </div>
                                    <div class="r-price">₹<%= (rp.discountPrice || rp.basePrice).toLocaleString('en-IN')
                                            %>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <p style="grid-column: 1 / -1; text-align: center; color: var(--text-light);">
                                        Explore our other collections for more inspirations.</p>
                                    <% } %>
            </div>
        </section>

        <%- include('partials/user/footer') %>

            <%- include('partials/user/modal') %>

                <script>
                    // DATA
                    const allVariants = <%- variantsJson %>;
                    const productId = '<%= product._id %>';

                    let selectedVariantId = allVariants.length > 0 ? allVariants[0].id : '';
                    let qty = 1;
                    const QTY_MAX = 10;

                    // Track State
                    let inCart = false;
                    let inWishlist = <%= typeof inWishlist !== 'undefined' ? inWishlist : false %>;

                    // Stock UI Handler
                    function updateStockUI(variant) {
                        const stockWrap = document.getElementById('stockBarWrap');
                        const stockText = document.getElementById('stockBarText');
                        const addCartBtn = document.getElementById('addCartBtn');

                        if (!variant || !stockWrap) return;

                        const stock = Number(variant.stock || 0);

                        if (stock <= 0) {
                            stockWrap.style.display = 'inline-flex';
                            stockWrap.className = 'stock-bar-wrap out-of-stock';
                            stockText.innerHTML = `Out of Stock`;
                            if (addCartBtn) {
                                addCartBtn.disabled = true;
                                addCartBtn.style.opacity = '0.5';
                                addCartBtn.style.cursor = 'not-allowed';
                            }
                        } else if (stock < 5) {
                            stockWrap.style.display = 'inline-flex';
                            stockWrap.className = 'stock-bar-wrap limited';
                            stockText.innerHTML = `Only ${stock} left`;
                            if (addCartBtn) {
                                addCartBtn.disabled = false;
                                addCartBtn.style.opacity = '1';
                                addCartBtn.style.cursor = 'pointer';
                            }
                        } else {
                            stockWrap.style.display = 'none';
                            if (addCartBtn) {
                                addCartBtn.disabled = false;
                                addCartBtn.style.opacity = '1';
                                addCartBtn.style.cursor = 'pointer';
                            }
                        }
                    }

                    // Initialize UI State On Page Load
                    document.addEventListener('DOMContentLoaded', () => {
                        if (inWishlist) updateWishlistUI();
                        if (allVariants.length > 0) updateStockUI(allVariants[0]);
                    });

                    // VARIANT SELECTION & IMAGE GALLERY
                    function selectVariant(id, color, el) {
                        selectedVariantId = id;
                        document.querySelectorAll('.color-opt').forEach(o => o.classList.remove('active'));
                        el.classList.add('active');

                        // Show Only This Variant's Images
                        const variant = allVariants.find(v => v.id === id);
                        if (!variant) return;
                        const images = variant.images.length > 0 ? variant.images : ['https://via.placeholder.com/600'];

                        // Update Main Image
                        document.getElementById('mainImg').src = images[0];
                        updateMagnifierSrc(images[0]);

                        // Rebuild Thumbnails
                        const row = document.getElementById('thumbnailsRow');
                        row.innerHTML = '';
                        images.forEach((url, idx) => {
                            const div = document.createElement('div');
                            div.className = 'thumb' + (idx === 0 ? ' active' : '');
                            div.onclick = function () { switchImg(this, url); };
                            const img = document.createElement('img');
                            img.src = url;
                            img.alt = '';
                            div.appendChild(img);
                            row.appendChild(div);
                        });

                        // Reset Cart/wishlist Button States For New Variant
                        inCart = false;
                        inWishlist = false;
                        resetCartBtn();
                        resetWishBtn();
                        updateStockUI(variant);
                    }

                    function switchImg(thumb, src) {
                        document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
                        thumb.classList.add('active');
                        document.getElementById('mainImg').src = src;
                        updateMagnifierSrc(src);
                    }

                    // MAGNIFIER
                    const ZOOM = 2.5;
                    let currentImgSrc = document.getElementById('mainImg').src;

                    function updateMagnifierSrc(src) { currentImgSrc = src; }

                    document.getElementById('mainImgWrap').addEventListener('mousemove', function (e) {
                        const wrap = this;
                        const glass = document.getElementById('magnifierGlass');
                        const rect = wrap.getBoundingClientRect();
                        const x = e.clientX - rect.left;
                        const y = e.clientY - rect.top;
                        const gW = glass.offsetWidth;
                        const gH = glass.offsetHeight;

                        // Clamp
                        const cx = Math.max(gW / 2, Math.min(x, rect.width - gW / 2));
                        const cy = Math.max(gH / 2, Math.min(y, rect.height - gH / 2));

                        glass.style.left = cx + 'px';
                        glass.style.top = cy + 'px';

                        // Background Position
                        const bgX = -(cx * ZOOM - gW / 2);
                        const bgY = -(cy * ZOOM - gH / 2);

                        glass.style.backgroundImage = `url('${currentImgSrc}')`;
                        glass.style.backgroundSize = `${rect.width * ZOOM}px ${rect.height * ZOOM}px`;
                        glass.style.backgroundPosition = `${bgX}px ${bgY}px`;
                    });

                    document.getElementById('mainImgWrap').addEventListener('mouseleave', function () {
                        document.getElementById('magnifierGlass').style.display = 'none';
                    });

                    document.getElementById('mainImgWrap').addEventListener('mouseenter', function () {
                        document.getElementById('magnifierGlass').style.display = 'block';
                    });

                    // QUANTITY
                    function changeQty(d) {
                        const next = qty + d;
                        if (next < 1) return;
                        if (next > QTY_MAX) {
                            showModal('info',
                                'Quantity Limit Reached',
                                `You can add a maximum of <strong>${QTY_MAX} items</strong> per order.`,
                                [{ label: 'Got it', primary: true, action: 'closeModal()' }]
                            );
                            return;
                        }
                        qty = next;
                        document.getElementById('qtyDisplay').textContent = qty;
                        document.getElementById('qtyMinus').disabled = qty <= 1;
                        document.getElementById('qtyPlus').disabled = qty >= QTY_MAX;
                    }

                    // ADD TO CART
                    async function addToCart() {
                        if (inCart) {
                            showModal('info',
                                'Already in Cart',
                                'This item is already in your cart. Visit your cart to update the quantity or proceed to checkout.',
                                [
                                    { label: 'View Cart', primary: true, action: "location.href='/cart'" },
                                    { label: 'Continue Shopping', primary: false, action: 'closeModal()' }
                                ]
                            );
                            return;
                        }

                        try {
                            const res = await fetch('/add-to-cart', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ productId, variantId: selectedVariantId, qty })
                            });

                            if (res.status === 401) {
                                showModal('info', 'Login Required', 'You are not logged in. Please log in to add items to your cart.', [
                                    { label: 'Cancel', primary: false, action: 'closeModal()' },
                                    { label: 'Login', primary: true, action: "window.location.href='/login'" }
                                ]);
                                return;
                            }

                            const data = await res.json();

                            if (data.success) {
                                inCart = true;
                                const btn = document.getElementById('addCartBtn');
                                btn.classList.add('in-cart');
                                btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Already in Cart`;

                                if (data.cartCount !== undefined && typeof window.updateCartBadge === 'function') {
                                    window.updateCartBadge(data.cartCount);
                                }

                                if (inWishlist) {
                                    inWishlist = false;
                                    updateWishlistUI();
                                }

                                showModal('success',
                                    'Added to Cart!',
                                    'The item has been added to your cart successfully.',
                                    [
                                        { label: 'View Cart', primary: true, action: "location.href='/cart'" },
                                        { label: 'Continue Shopping', primary: false, action: 'closeModal()' }
                                    ]
                                );
                            } else if (data.notLoggedIn || data.message === 'Please login first') {
                                showModal('info', 'Login Required', 'You are not logged in. Please log in to add items to your cart.', [
                                    { label: 'Cancel', primary: false, action: 'closeModal()' },
                                    { label: 'Login', primary: true, action: "window.location.href='/login'" }
                                ]);
                            } else {
                                const msg = data.message || 'Unable to add item to cart. Please try again.';
                                showModal('error', 'Could Not Add to Cart', msg,
                                    [{ label: 'Close', primary: true, action: 'closeModal()' }]
                                );
                            }
                        } catch (err) {
                            showModal('error', 'Something Went Wrong',
                                'A network error occurred. Please check your connection and try again.',
                                [{ label: 'Close', primary: true, action: 'closeModal()' }]
                            );
                        }
                    }

                    // TOGGLE WISHLIST
                    async function toggleWishlist(e) {
                        if (e) e.stopPropagation();

                        const endpoint = inWishlist ? '/remove-from-wishlist' : '/add-to-wishlist';

                        try {
                            const res = await fetch(endpoint, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ productId, variantId: selectedVariantId })
                            });

                            if (res.status === 401) {
                                showModal('info', 'Login Required', 'You are not logged in. Please log in to add items to your wishlist.', [
                                    { label: 'Cancel', primary: false, action: 'closeModal()' },
                                    { label: 'Login', primary: true, action: "window.location.href='/login'" }
                                ]);
                                return;
                            }

                            const data = await res.json();

                            if (data.success) {
                                inWishlist = !inWishlist;
                                updateWishlistUI();

                                if (inWishlist) {
                                    showModal('success',
                                        'Added to Wishlist',
                                        'This item has been saved to your wishlist.',
                                        [
                                            { label: 'View Wishlist', primary: true, action: "location.href='/wishlist'" },
                                            { label: 'Continue Shopping', primary: false, action: 'closeModal()' }
                                        ]
                                    );
                                } else {
                                    showModal('info',
                                        'Removed from Wishlist',
                                        'This item has been removed from your wishlist.',
                                        [{ label: 'OK', primary: true, action: 'closeModal()' }]
                                    );
                                }
                            } else if (data.notLoggedIn || data.message === 'Please login first') {
                                showModal('info', 'Login Required', 'You are not logged in. Please log in to add items to your wishlist.', [
                                    { label: 'Cancel', primary: false, action: 'closeModal()' },
                                    { label: 'Login', primary: true, action: "window.location.href='/login'" }
                                ]);
                            } else {
                                const msg = data.message || 'Unable to update wishlist. Please try again.';
                                showModal('error', 'Wishlist Error', msg,
                                    [{ label: 'Close', primary: true, action: 'closeModal()' }]
                                );
                            }
                        } catch (err) {
                            showModal('error', 'Something Went Wrong',
                                'A network error occurred. Please try again.',
                                [{ label: 'Close', primary: true, action: 'closeModal()' }]
                            );
                        }
                    }

                    function updateWishlistUI() {
                        const btn = document.getElementById('wishlistBtn');
                        const imgBtn = document.getElementById('wishBtnImg');
                        const heartSVG = `<svg width="15" height="15" viewBox="0 0 24 24" fill="${inWishlist ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`;
                        const heartSVGSm = `<svg width="16" height="16" viewBox="0 0 24 24" fill="${inWishlist ? '#e05050' : 'none'}" stroke="${inWishlist ? '#e05050' : 'currentColor'}" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`;

                        if (inWishlist) {
                            btn.classList.add('in-wishlist');
                            btn.innerHTML = heartSVG + ' Remove from Wishlist';
                            imgBtn.classList.add('liked');
                        } else {
                            btn.classList.remove('in-wishlist');
                            btn.innerHTML = heartSVG + ' Add to Wishlist';
                            imgBtn.classList.remove('liked');
                        }
                        imgBtn.innerHTML = heartSVGSm;
                    }

                    function resetCartBtn() {
                        const btn = document.getElementById('addCartBtn');
                        btn.classList.remove('in-cart');
                        btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg> Add to Cart`;
                    }

                    function resetWishBtn() {
                        const btn = document.getElementById('wishlistBtn');
                        const imgBtn = document.getElementById('wishBtnImg');
                        btn.classList.remove('in-wishlist');
                        btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg> Add to Wishlist`;
                        imgBtn.classList.remove('liked');
                        imgBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`;
                    }



                    // TABS
                    function switchTab(btn, id) {
                        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
                        btn.classList.add('active');
                        document.getElementById(id).classList.add('active');
                    }

                    // Init Magnifier Src
                    updateMagnifierSrc(document.getElementById('mainImg').src);
                </script>
</body>

</html>