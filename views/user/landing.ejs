<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Elanora – Luxury Jewelry</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cream: #f9f5ef;
      --warm-white: #fdfaf5;
      --gold: #c8972a;
      --gold-light: #e4b84a;
      --gold-pale: #f0ddb0;
      --dark: #1a1612;
      --text: #3a3228;
      --muted: #8c7f70;
      --border: #e8ddd0;
      --radius: 12px;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Jost', sans-serif;
      background: var(--warm-white);
      color: var(--text);
      overflow-x: hidden;
    }

    /* NAV */
    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(253,250,245,0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 60px; height: 64px;
    }
    .nav-logo {
      display: flex; align-items: center; gap: 8px;
      font-family: 'Cormorant Garamond', serif;
      font-size: 22px; font-weight: 600; color: var(--gold);
      text-decoration: none;
    }
    .nav-logo svg { width: 20px; height: 20px; fill: var(--gold); }
    .nav-links { display: flex; gap: 36px; list-style: none; }
    .nav-links a {
      font-size: 13px; font-weight: 400; letter-spacing: 0.06em;
      color: var(--text); text-decoration: none;
      transition: color .2s;
    }
    .nav-links a:hover { color: var(--gold); }
    .nav-actions { display: flex; gap: 10px; align-items: center; }
    .nav-icon { width: 18px; height: 18px; cursor: pointer; color: var(--text); }
    .btn-login {
      padding: 7px 18px; border: 1px solid var(--border); border-radius: 6px;
      font-size: 12px; font-weight: 500; background: transparent; cursor: pointer;
      color: var(--text); transition: border-color .2s, color .2s;
    }
    .btn-login:hover { border-color: var(--gold); color: var(--gold); }
    .btn-signup {
      padding: 7px 18px; border-radius: 6px; font-size: 12px; font-weight: 500;
      background: var(--gold); color: #fff; border: none; cursor: pointer;
      transition: background .2s;
    }
    .btn-signup:hover { background: #a87820; }

    /* HERO */
    .hero {
      display: grid; grid-template-columns: 1fr 1fr;
      min-height: 540px; background: var(--cream);
      overflow: hidden;
    }
    .hero-content {
      padding: 80px 60px;
      display: flex; flex-direction: column; justify-content: center;
    }
    .hero-content h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(42px, 5vw, 60px); font-weight: 400; line-height: 1.15;
      color: var(--dark); margin-bottom: 20px;
    }
    .hero-content h1 span { color: var(--gold); font-style: italic; }
    .hero-content p {
      font-size: 13px; color: var(--muted); line-height: 1.8; max-width: 320px;
      margin-bottom: 32px;
    }
    .hero-bottom { display: flex; align-items: center; gap: 20px; }
    .btn-primary {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 12px 26px; background: var(--gold); color: #fff;
      border: none; border-radius: 8px; font-size: 13px; font-weight: 500;
      cursor: pointer; transition: background .2s; text-decoration: none;
    }
    .btn-primary:hover { background: #a87820; }
    .hero-avatars { display: flex; align-items: center; gap: 8px; }
    .avatar-stack { display: flex; }
    .avatar-stack img {
      width: 32px; height: 32px; border-radius: 50%;
      border: 2px solid var(--warm-white); margin-left: -8px; object-fit: cover;
    }
    .avatar-stack img:first-child { margin-left: 0; }
    .hero-count { font-size: 12px; color: var(--muted); }
    .hero-count strong { color: var(--text); font-weight: 500; }
    .hero-image {
      position: relative; overflow: hidden;
      background: #e8ddd0;
    }
    .hero-image img {
      width: 100%; height: 100%; object-fit: cover;
    }
    .hero-badge {
      position: absolute; bottom: 40px; left: -20px;
      background: #fff; border-radius: 10px;
      padding: 10px 14px; display: flex; align-items: center; gap: 10px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.12);
      animation: floatBadge 3s ease-in-out infinite;
    }
    @keyframes floatBadge {
      0%,100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }
    .badge-img { width: 40px; height: 40px; border-radius: 8px; object-fit: cover; }
    .badge-text { font-size: 11px; }
    .badge-text strong { display: block; font-weight: 500; color: var(--dark); }
    .badge-text span { color: var(--muted); }

    /* FEATURES */
    .features {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 0; border-bottom: 1px solid var(--border);
    }
    .feature {
      padding: 40px 30px; text-align: center;
      border-right: 1px solid var(--border);
    }
    .feature:last-child { border-right: none; }
    .feature-icon {
      width: 40px; height: 40px; margin: 0 auto 14px;
      background: var(--gold-pale); border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
    }
    .feature-icon svg { width: 20px; height: 20px; stroke: var(--gold); fill: none; stroke-width: 1.5; }
    .feature h3 { font-size: 13px; font-weight: 500; margin-bottom: 6px; color: var(--dark); }
    .feature p { font-size: 11.5px; color: var(--muted); line-height: 1.6; }

    /* ABOUT */
    .about {
      display: grid; grid-template-columns: 1fr 1fr;
      align-items: center; gap: 60px;
      padding: 100px 60px; background: var(--warm-white);
    }
    .about-image { border-radius: var(--radius); overflow: hidden; }
    .about-image img { width: 100%; height: 500px; object-fit: cover; border-radius: var(--radius); display: block; }
    .about-content { position: relative; }
    .about-content h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(34px, 4vw, 48px); font-weight: 400; line-height: 1.2;
      margin-bottom: 24px; color: var(--dark);
    }
    .about-content h2 em {
      color: var(--gold); font-style: normal;
      background: var(--gold-pale); padding: 0 8px; border-radius: 4px;
    }
    .about-content p { font-size: 13px; color: var(--muted); line-height: 1.9; margin-bottom: 16px; }
    .btn-outline {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 11px 24px; border: 1px solid var(--gold); border-radius: 8px;
      font-size: 13px; color: var(--gold); background: transparent;
      cursor: pointer; text-decoration: none; transition: all .2s; margin-top: 12px;
    }
    .btn-outline:hover { background: var(--gold); color: #fff; }
    .about-badge {
      position: absolute; bottom: -20px; right: 0;
      width: 100px; height: 100px; border-radius: 50%; overflow: hidden;
      border: 4px solid var(--warm-white);
      box-shadow: 0 6px 24px rgba(0,0,0,0.15);
    }
    .about-badge img { width: 100%; height: 100%; object-fit: cover; }

    /* COLLECTION */
    .collection { padding: 80px 60px; background: var(--cream); }
    .section-header {
      display: flex; align-items: flex-end; justify-content: space-between;
      margin-bottom: 40px;
    }
    .section-header h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 36px; font-weight: 400; color: var(--dark);
    }
    .section-header p { font-size: 12.5px; color: var(--muted); max-width: 320px; line-height: 1.7; }
    .btn-see-all {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 13px; color: var(--gold); background: transparent;
      border: 1px solid var(--gold); border-radius: 8px;
      padding: 9px 20px; cursor: pointer; text-decoration: none; transition: all .2s;
      white-space: nowrap;
    }
    .btn-see-all:hover { background: var(--gold); color: #fff; }
    .products-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .product-card {
      background: #fff; border-radius: var(--radius); overflow: hidden;
      border: 1px solid var(--border);
      transition: transform .3s, box-shadow .3s;
    }
    .product-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(0,0,0,0.1); }
    .product-card img {
      width: 100%; height: 240px; object-fit: cover;
      display: block; transition: transform .4s;
    }
    .product-card:hover img { transform: scale(1.04); }
    .product-info { padding: 18px 20px; }
    .product-info h3 { font-size: 14px; font-weight: 500; color: var(--dark); margin-bottom: 6px; }
    .product-info .price { font-size: 13px; color: var(--gold); font-weight: 500; }

    /* CATEGORY */
    .category {
      margin: 0 60px 80px;
      background: var(--cream); border-radius: 20px;
      display: grid; grid-template-columns: 1fr 1.4fr;
      overflow: hidden; align-items: center;
    }
    .category-image img { width: 100%; height: 360px; object-fit: cover; display: block; }
    .category-content { padding: 60px 50px; }
    .category-content h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 36px; font-weight: 400; margin-bottom: 14px; color: var(--dark);
    }
    .category-content p { font-size: 13px; color: var(--muted); line-height: 1.8; margin-bottom: 30px; }
    .category-types { display: flex; gap: 28px; }
    .type-item { text-align: center; cursor: pointer; }
    .type-thumb {
      width: 70px; height: 70px; border-radius: 50%; overflow: hidden;
      border: 2px solid var(--border); margin: 0 auto 8px;
      transition: border-color .2s;
    }
    .type-item:hover .type-thumb { border-color: var(--gold); }
    .type-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .type-item span { font-size: 12px; color: var(--muted); }

    /* FOOTER */
    footer {
      background: var(--cream);
      border-top: 1px solid var(--border);
      padding: 60px 60px 30px;
    }
    .footer-grid {
      display: grid; grid-template-columns: 2fr 1fr 1.2fr 1.6fr;
      gap: 40px; margin-bottom: 40px;
    }
    .footer-brand .nav-logo { margin-bottom: 14px; display: inline-flex; }
    .footer-brand p { font-size: 12.5px; color: var(--muted); line-height: 1.8; max-width: 220px; }
    .footer-socials { display: flex; gap: 12px; margin-top: 18px; }
    .social-icon {
      width: 32px; height: 32px; border-radius: 8px;
      border: 1px solid var(--border); display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: border-color .2s, background .2s;
    }
    .social-icon:hover { border-color: var(--gold); background: var(--gold-pale); }
    .social-icon svg { width: 14px; height: 14px; stroke: var(--muted); fill: none; stroke-width: 1.5; }
    .footer-col h4 { font-size: 13px; font-weight: 500; color: var(--dark); margin-bottom: 16px; }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .footer-col ul li a { font-size: 12.5px; color: var(--muted); text-decoration: none; transition: color .2s; }
    .footer-col ul li a:hover { color: var(--gold); }
    .newsletter-input-wrap { display: flex; margin-top: 6px; }
    .newsletter-input-wrap input {
      flex: 1; padding: 10px 14px; font-size: 12px;
      border: 1px solid var(--border); border-radius: 8px 0 0 8px;
      background: #fff; color: var(--text); outline: none;
    }
    .newsletter-input-wrap input::placeholder { color: var(--muted); }
    .newsletter-input-wrap button {
      padding: 10px 18px; background: var(--gold); color: #fff;
      border: none; border-radius: 0 8px 8px 0; font-size: 12px;
      cursor: pointer; font-weight: 500; transition: background .2s;
    }
    .newsletter-input-wrap button:hover { background: #a87820; }
    .footer-bottom {
      border-top: 1px solid var(--border); padding-top: 20px;
      display: flex; justify-content: space-between; align-items: center;
    }
    .footer-bottom p { font-size: 11.5px; color: var(--muted); }
    .footer-bottom-links { display: flex; gap: 20px; }
    .footer-bottom-links a { font-size: 11.5px; color: var(--muted); text-decoration: none; }
    .footer-bottom-links a:hover { color: var(--gold); }

    /* ANIMATIONS */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .hero-content { animation: fadeUp .8s ease both; }
    .hero-image { animation: fadeUp .8s .2s ease both; }

    /* PLACEHOLDER IMAGE FALLBACK */
    .img-placeholder {
      width: 100%; height: 100%;
      background: linear-gradient(135deg, #e8d8c0 0%, #d4c0a0 100%);
      display: flex; align-items: center; justify-content: center;
    }
    .img-placeholder span { color: var(--muted); font-size: 13px; opacity: .6; }
  </style>
</head>
