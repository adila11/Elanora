    <h3>Cancel Order</h3>
    <p class="modal-sub" id="modalSubText">Select the items you'd like to cancel. Stock will be restored for cancelled items.</p>

    <div class="cancel-items-list" id="cancelItemsList"></div>

    <label class="reason-label">
      Reason for cancellation <span class="reason-optional">(optional)</span>
    </label>
    <textarea id="cancelReason" placeholder="e.g. Changed my mind, found a better deal, ordered by mistake…"></textarea>

    <div class="modal-actions">
      <button class="btn-keep" onclick="closeCancelModal()">Keep Order</button>
      <button class="btn-confirm-cancel" id="confirmCancelBtn" onclick="confirmCancel()">Confirm Cancellation</button>
    </div>
