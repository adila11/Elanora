<!-- TOAST -->
<div class="toast" id="toast">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
  <span id="toastMsg">Invoice downloaded!</span>
</div>

<script>
  // ── CANCEL ORDER ──
  let currentCancelOrder = null;
  // stock tracker (simulated; in real app this would be server-side)
  const stock = {};

  function openCancelModal(orderId, date, items, prices) {
    currentCancelOrder = { orderId, date, items, prices };
    document.getElementById('cancelReason').value = '';
    document.getElementById('modalSubText').textContent =
      items.length > 1
        ? `Select the items you'd like to cancel from order #${orderId}. Stock will be restored automatically.`
        : `Are you sure you want to cancel order #${orderId}? This cannot be undone.`;

    // Build item checklist
    const list = document.getElementById('cancelItemsList');
    list.innerHTML = '';
    items.forEach((item, i) => {
      const row = document.createElement('div');
      row.className = 'cancel-item-row';
      row.innerHTML = `
        <input type="checkbox" id="ci_${i}" value="${i}" checked onchange="updateConfirmBtn()">
        <label for="ci_${i}">${item}</label>
        <span class="item-price">₹${(prices[i] || 0).toLocaleString('en-IN')}</span>
      `;
      list.appendChild(row);
    });

    updateConfirmBtn();
    document.getElementById('cancelModalOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function updateConfirmBtn() {
    const checked = document.querySelectorAll('#cancelItemsList input[type="checkbox"]:checked');
    document.getElementById('confirmCancelBtn').disabled = checked.length === 0;
  }

  function closeCancelModal() {
    document.getElementById('cancelModalOverlay').classList.remove('open');
    document.body.style.overflow = '';
    currentCancelOrder = null;
  }

  function handleOverlayClick(e) {
    if (e.target === document.getElementById('cancelModalOverlay')) closeCancelModal();
  }

  function confirmCancel() {
    if (!currentCancelOrder) return;
    const { orderId, items, prices } = currentCancelOrder;
    const checkedEls = document.querySelectorAll('#cancelItemsList input[type="checkbox"]:checked');
    const cancelledIndices = Array.from(checkedEls).map(el => parseInt(el.value));
    const cancelledItems = cancelledIndices.map(i => items[i]);
    const reason = document.getElementById('cancelReason').value.trim();

    // ── Increment stock for cancelled items ──
    cancelledItems.forEach(item => {
      stock[item] = (stock[item] || 10) + 1; // simulate stock increment
      console.log(`Stock restored for "${item}": ${stock[item]} units`);
    });

    const allCancelled = cancelledIndices.length === items.length;

    // Update badge
    const badge = document.getElementById(`badge-${orderId}`);
    if (badge && allCancelled) {
      badge.className = 'status-badge cancelled';
      badge.textContent = 'Cancelled';
    }

    // Hide cancel button if fully cancelled
    const cancelBtn = document.getElementById(`cancel-btn-${orderId}`);
    if (cancelBtn && allCancelled) cancelBtn.style.display = 'none';

    // Update item count text
    const card = document.querySelector(`[data-order="#${orderId}"]`);
    if (card) {
      const infoP = card.querySelector('.item-info p');
      const infoSmall = card.querySelector('.item-info small');
      if (allCancelled) {
        if (infoP) infoP.textContent = 'Order Cancelled';
        if (infoSmall) infoSmall.textContent = cancelledItems.join(', ');
      } else {
        const remaining = items.filter((_, i) => !cancelledIndices.includes(i));
        if (infoP) infoP.textContent = `${remaining.length} Item${remaining.length > 1 ? 's' : ''} remaining`;
        if (infoSmall) infoSmall.textContent = `Cancelled: ${cancelledItems.join(', ')}`;
      }
    }

    closeCancelModal();

    const msg = allCancelled
      ? `Order #${orderId} cancelled${reason ? ' — Reason saved' : ''}.`
      : `${cancelledItems.length} item${cancelledItems.length > 1 ? 's' : ''} cancelled from #${orderId}.`;
    showToast(msg, 'cancel');
  }

  function filterOrders() {
    const q = document.getElementById('searchInput').value.trim().toLowerCase();
    const cards = document.querySelectorAll('.order-card');
    let visible = 0;
    cards.forEach(card => {
      const order = card.dataset.order.toLowerCase();
      const item  = card.dataset.item.toLowerCase();
      const date  = card.dataset.date.toLowerCase();
      const match = !q || order.includes(q) || item.includes(q) || date.includes(q);
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    document.getElementById('noResults').style.display = visible === 0 ? 'block' : 'none';
  }

  // ── TOAST ──
  function showToast(msg, type = 'success') {
    const t = document.getElementById('toast');
    document.getElementById('toastMsg').textContent = msg;
    t.style.background = type === 'cancel' ? '#C0392B' : '';
    t.classList.add('show');
    setTimeout(() => { t.classList.remove('show'); t.style.background = ''; }, 3000);
  }

  // ── PDF INVOICE ──
  function downloadInvoice(orderNum, date, total, status, items) {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ unit: 'pt', format: 'a4' });

    const W = doc.internal.pageSize.getWidth();
    const gold = [201, 149, 42];
    const dark = [44, 31, 14];
    const mid  = [107, 83, 53];
    const light = [160, 139, 110];

    // header strip
    doc.setFillColor(...gold);
    doc.rect(0, 0, W, 90, 'F');

    // brand name
    doc.setTextColor(255, 255, 255);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(28);
    doc.text('ELANORA', 48, 48);

    doc.setFont('helvetica', 'normal');
    doc.setFontSize(10);
    doc.text('Fine Jewelry & Elegance', 48, 66);

    // invoice label (right)
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(18);
    doc.text('INVOICE', W - 48, 40, { align: 'right' });
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(10);
    doc.text(`#${orderNum}`, W - 48, 58, { align: 'right' });
    doc.text(`Date: ${date}`, W - 48, 74, { align: 'right' });

    // thin gold bar
    doc.setFillColor(...gold);
    doc.rect(0, 90, W, 3, 'F');

    // bill to section
    let y = 120;
    doc.setTextColor(...mid);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(9);
    doc.text('BILLED TO', 48, y);
    y += 14;
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(11);
    doc.setTextColor(...dark);
    doc.text('Adila K A', 48, y);
    y += 14;
    doc.setFontSize(10);
    doc.setTextColor(...mid);
    doc.text('adila@gmail.com', 48, y);

    // status badge area
    doc.setFontSize(9);
    doc.setFont('helvetica', 'bold');
    const statusColor = status === 'Delivered' ? [76, 175, 125] : [91, 155, 213];
    doc.setTextColor(...statusColor);
    doc.text(`STATUS: ${status.toUpperCase()}`, W - 48, 120 + 4, { align: 'right' });

    // divider
    y = 180;
    doc.setDrawColor(...gold);
    doc.setLineWidth(0.5);
    doc.line(48, y, W - 48, y);

    // table header
    y += 20;
    doc.setFillColor(250, 246, 241);
    doc.rect(40, y - 14, W - 80, 22, 'F');
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(9);
    doc.setTextColor(...mid);
    doc.text('ITEM', 52, y);
    doc.text('QTY', W / 2, y, { align: 'center' });
    doc.text('AMOUNT', W - 52, y, { align: 'right' });

    // table rows
    y += 18;
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(11);
    const perItem = Math.round(parseInt(total.replace(/[^0-9]/g, '')) / items.length);
    items.forEach((item, i) => {
      if (i % 2 === 0) {
        doc.setFillColor(255, 255, 255);
      } else {
        doc.setFillColor(252, 249, 245);
      }
      doc.rect(40, y - 14, W - 80, 20, 'F');
      doc.setTextColor(...dark);
      doc.text(item, 52, y);
      doc.setTextColor(...mid);
      doc.text('1', W / 2, y, { align: 'center' });
      doc.setTextColor(...dark);
      doc.text(`₹${perItem.toLocaleString('en-IN')}`, W - 52, y, { align: 'right' });
      y += 24;
    });

    // total section
    y += 10;
    doc.setDrawColor(...gold);
    doc.setLineWidth(0.5);
    doc.line(48, y, W - 48, y);
    y += 20;

    doc.setFont('helvetica', 'normal');
    doc.setFontSize(11);
    doc.setTextColor(...mid);
    doc.text('Subtotal', W - 200, y);
    doc.setTextColor(...dark);
    doc.text(total, W - 52, y, { align: 'right' });
    y += 18;

    doc.setTextColor(...mid);
    doc.text('Shipping', W - 200, y);
    doc.setTextColor(...dark);
    doc.text('Free', W - 52, y, { align: 'right' });
    y += 18;

    doc.setTextColor(...mid);
    doc.text('Tax (GST 3%)', W - 200, y);
    const taxAmt = Math.round(parseInt(total.replace(/[^0-9]/g, '')) * 0.03);
    doc.setTextColor(...dark);
    doc.text(`₹${taxAmt.toLocaleString('en-IN')}`, W - 52, y, { align: 'right' });
    y += 10;

    doc.setDrawColor(...gold);
    doc.line(W - 200, y, W - 48, y);
    y += 16;

    doc.setFillColor(...gold);
    doc.rect(W - 200, y - 14, 152, 26, 'F');
    doc.setTextColor(255, 255, 255);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(12);
    doc.text('TOTAL', W - 180, y);
    const totalNum = parseInt(total.replace(/[^0-9]/g, ''));
    const grandTotal = totalNum + taxAmt;
    doc.text(`₹${grandTotal.toLocaleString('en-IN')}`, W - 52, y, { align: 'right' });

    // footer note
    y += 50;
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(9);
    doc.setTextColor(...light);
    doc.text('Thank you for shopping with Elanora. For queries, contact support@elanora.com', W / 2, y, { align: 'center' });

    // bottom gold strip
    const pH = doc.internal.pageSize.getHeight();
    doc.setFillColor(...gold);
    doc.rect(0, pH - 18, W, 18, 'F');
    doc.setTextColor(255, 255, 255);
    doc.setFontSize(8);
    doc.text('© 2026 Elanora Jewelry. Crafting timeless elegance.', W / 2, pH - 6, { align: 'center' });

    doc.save(`Elanora_Invoice_${orderNum}.pdf`);
    showToast(`Invoice ${orderNum} downloaded!`);
  }
</script>
</body>
</html>