<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Elanora – My Orders</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
  :root {
    --gold: #C9952A;
    --gold-light: #E8C97A;
    --gold-muted: #D4AA50;
    --cream: #FAF6F1;
    --cream-deep: #F2EAE0;
    --brown-soft: #8B6B3D;
    --text-dark: #2C1F0E;
    --text-mid: #6B5335;
    --text-light: #A08B6E;
    --white: #FFFFFF;
    --border: #E8DDD0;
    --green: #4CAF7D;
    --blue: #5B9BD5;
    --shadow: 0 2px 20px rgba(44,31,14,0.08);
    --shadow-hover: 0 8px 40px rgba(44,31,14,0.14);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Jost', sans-serif;
    background: var(--cream);
    color: var(--text-dark);
    min-height: 100vh;
  }

  /* ── NAV ── */
  nav {
    background: var(--white);
    border-bottom: 1px solid var(--border);
    padding: 0 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 600;
    color: var(--gold);
    text-decoration: none;
  }
  .logo svg { width: 28px; height: 28px; }
  .nav-links { display: flex; gap: 32px; }
  .nav-links a {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-mid);
    text-decoration: none;
    letter-spacing: 0.5px;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--gold); }
  .nav-icons { display: flex; gap: 18px; align-items: center; }
  .nav-icons svg { width: 20px; height: 20px; color: var(--text-mid); cursor: pointer; }
  .cart-badge {
    position: relative;
  }
  .badge {
    position: absolute;
    top: -6px; right: -6px;
    background: var(--gold);
    color: white;
    border-radius: 50%;
    width: 16px; height: 16px;
    font-size: 9px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 600;
  }

  /* ── LAYOUT ── */
  .page-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 36px 24px 80px;
  }

  /* ── PROFILE CARD ── */
  .profile-card {
    background: var(--white);
    border-radius: 16px;
    padding: 28px 36px;
    display: flex;
    align-items: center;
    gap: 24px;
    box-shadow: var(--shadow);
    margin-bottom: 28px;
  }
  .avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }
  .avatar {
    width: 80px; height: 80px;
    border-radius: 50%;
    background: var(--gold-muted);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    color: white;
    font-weight: 600;
  }
  .edit-btn {
    position: absolute;
    bottom: 0; right: 0;
    width: 26px; height: 26px;
    border-radius: 50%;
    background: var(--gold);
    border: 2px solid white;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
  }
  .edit-btn svg { width: 12px; height: 12px; color: white; }
  .profile-info h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 4px;
  }
  .profile-info p {
    font-size: 13px;
    color: var(--text-light);
    margin-bottom: 12px;
  }
  .profile-tags { display: flex; gap: 10px; flex-wrap: wrap; }
  .tag {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border: 1px solid var(--border);
    border-radius: 20px;
    font-size: 12px;
    color: var(--text-mid);
    font-weight: 500;
  }
  .tag svg { width: 14px; height: 14px; color: var(--gold); }

  /* ── MAIN GRID ── */
  .main-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
    align-items: start;
  }

  /* ── SIDEBAR ── */
  .sidebar {
    background: var(--white);
    border-radius: 16px;
    padding: 12px 0;
    box-shadow: var(--shadow);
  }
  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    font-size: 14px;
    color: var(--text-mid);
    cursor: pointer;
    transition: all 0.2s;
    border-left: 3px solid transparent;
    text-decoration: none;
  }
  .sidebar-item:hover {
    background: var(--cream);
    color: var(--text-dark);
  }
  .sidebar-item.active {
    background: var(--cream-deep);
    color: var(--gold);
    border-left-color: var(--gold);
    font-weight: 500;
  }
  .sidebar-item svg { width: 16px; height: 16px; flex-shrink: 0; }

  /* ── ORDERS PANEL ── */
  .orders-panel {
    background: var(--white);
    border-radius: 16px;
    padding: 28px;
    box-shadow: var(--shadow);
  }
  .orders-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .orders-header h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 600;
    color: var(--text-dark);
  }

  /* ── SEARCH BAR ── */
  .search-wrap {
    position: relative;
    flex: 1;
    max-width: 340px;
  }
  .search-wrap svg {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px; height: 16px;
    color: var(--text-light);
    pointer-events: none;
  }
  #searchInput {
    width: 100%;
    padding: 9px 14px 9px 36px;
    border: 1px solid var(--border);
    border-radius: 30px;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    color: var(--text-dark);
    background: var(--cream);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  #searchInput:focus {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201,149,42,0.1);
  }
  #searchInput::placeholder { color: var(--text-light); }

  /* ── NO RESULTS ── */
  .no-results {
    display: none;
    text-align: center;
    padding: 48px 0;
    color: var(--text-light);
    font-size: 14px;
  }
  .no-results svg { width: 40px; height: 40px; margin-bottom: 12px; opacity: 0.4; display: block; margin-left: auto; margin-right: auto; }

  /* ── ORDER CARDS ── */
  .order-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px 20px;
    margin-bottom: 16px;
    transition: box-shadow 0.25s, transform 0.2s;
    animation: fadeIn 0.35s ease both;
  }
  .order-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-1px);
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .order-meta {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .meta-group label {
    font-size: 11px;
    color: var(--text-light);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    display: block;
    margin-bottom: 2px;
  }
  .meta-group span {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-dark);
  }
  .order-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .status-badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
  }
  .status-badge.processing {
    background: #EBF3FD;
    color: var(--blue);
    border: 1px solid #C5DCEF;
  }
  .status-badge.delivered {
    background: #EBF8F2;
    color: var(--green);
    border: 1px solid #B5E5CE;
  }
  .dl-btn {
    width: 32px; height: 32px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--white);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    flex-shrink: 0;
  }
  .dl-btn:hover {
    background: var(--gold);
    border-color: var(--gold);
  }
  .dl-btn:hover svg { color: white; }
  .dl-btn svg { width: 15px; height: 15px; color: var(--text-mid); }

  /* ── CANCEL BTN ── */
  .cancel-order-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 6px 14px;
    background: transparent;
    color: #C0392B;
    border: 1px solid #E8B4B0;
    border-radius: 20px;
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    flex-shrink: 0;
  }
  .cancel-order-btn:hover {
    background: #FDF0EE;
    border-color: #C0392B;
  }
  .cancel-order-btn svg { width: 13px; height: 13px; }

  /* ── CANCELLED BADGE ── */
  .status-badge.cancelled {
    background: #FDF0EE;
    color: #C0392B;
    border: 1px solid #E8B4B0;
  }

  /* ── CANCEL MODAL OVERLAY ── */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(44,31,14,0.45);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(2px);
  }
  .modal-overlay.open { display: flex; }

  .cancel-modal {
    background: var(--white);
    border-radius: 20px;
    padding: 36px;
    width: 100%;
    max-width: 480px;
    box-shadow: 0 20px 60px rgba(44,31,14,0.18);
    animation: modalIn 0.25s ease both;
    position: relative;
  }
  @keyframes modalIn {
    from { opacity: 0; transform: translateY(16px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .modal-close {
    position: absolute;
    top: 16px; right: 16px;
    width: 30px; height: 30px;
    border: none;
    background: var(--cream);
    border-radius: 50%;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    color: var(--text-mid);
    transition: background 0.2s;
  }
  .modal-close:hover { background: var(--cream-deep); }
  .modal-close svg { width: 14px; height: 14px; }

  .modal-icon {
    width: 52px; height: 52px;
    border-radius: 14px;
    background: #FDF0EE;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 18px;
  }
  .modal-icon svg { width: 26px; height: 26px; color: #C0392B; }

  .cancel-modal h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 6px;
  }
  .cancel-modal .modal-sub {
    font-size: 13px;
    color: var(--text-light);
    margin-bottom: 20px;
    line-height: 1.5;
  }

  /* Items checklist inside modal */
  .cancel-items-list {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 18px;
  }
  .cancel-item-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
  }
  .cancel-item-row:last-child { border-bottom: none; }
  .cancel-item-row:hover { background: var(--cream); }
  .cancel-item-row input[type="checkbox"] {
    width: 16px; height: 16px;
    accent-color: var(--gold);
    cursor: pointer;
    flex-shrink: 0;
  }
  .cancel-item-row label {
    font-size: 13px;
    color: var(--text-dark);
    cursor: pointer;
    flex: 1;
    font-weight: 500;
  }
  .cancel-item-row .item-price {
    font-size: 12px;
    color: var(--text-light);
    font-weight: 400;
  }

  /* Reason textarea */
  .reason-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-mid);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 8px;
    display: block;
  }
  .reason-optional { font-weight: 400; color: var(--text-light); text-transform: none; letter-spacing: 0; }
  #cancelReason {
    width: 100%;
    height: 90px;
    resize: none;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    color: var(--text-dark);
    background: var(--cream);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    margin-bottom: 22px;
  }
  #cancelReason:focus {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201,149,42,0.1);
  }
  #cancelReason::placeholder { color: var(--text-light); }

  .modal-actions { display: flex; gap: 12px; }
  .btn-keep {
    flex: 1;
    padding: 11px;
    background: var(--cream-deep);
    border: 1px solid var(--border);
    border-radius: 24px;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-mid);
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-keep:hover { background: var(--border); }
  .btn-confirm-cancel {
    flex: 1;
    padding: 11px;
    background: #C0392B;
    border: none;
    border-radius: 24px;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: white;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-confirm-cancel:hover { background: #A93226; }
  .btn-confirm-cancel:disabled { background: #E0A09A; cursor: not-allowed; }

  /* ── ORDER ITEM ROW ── */
  .order-item-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .item-left { display: flex; align-items: center; gap: 14px; }
  .item-img {
    width: 52px; height: 52px;
    border-radius: 10px;
    background: var(--cream-deep);
    object-fit: cover;
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .item-img svg { width: 22px; height: 22px; color: var(--gold-muted); }
  .item-info p {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-dark);
    margin-bottom: 2px;
  }
  .item-info small {
    font-size: 12px;
    color: var(--text-light);
  }

  /* ── VIEW DETAILS BTN ── */
  .view-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 18px;
    background: var(--gold);
    color: white;
    border: none;
    border-radius: 24px;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    flex-shrink: 0;
  }
  .view-btn:hover { background: var(--brown-soft); transform: scale(1.03); }
  .view-btn svg { width: 14px; height: 14px; }

  /* ── PAGINATION ── */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
  }
  .page-btn {
    width: 36px; height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: white;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    color: var(--text-mid);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.2s;
  }
  .page-btn:hover { border-color: var(--gold); color: var(--gold); }
  .page-btn.active { background: var(--gold); border-color: var(--gold); color: white; font-weight: 600; }
  .page-btn svg { width: 14px; height: 14px; }

  /* ── FOOTER ── */
  footer {
    background: var(--white);
    border-top: 1px solid var(--border);
    padding: 56px 48px 32px;
    margin-top: 60px;
  }
  .footer-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
    gap: 40px;
    margin-bottom: 40px;
  }
  .footer-brand .logo { margin-bottom: 14px; display: inline-flex; }
  .footer-brand p { font-size: 13px; color: var(--text-light); line-height: 1.6; margin-bottom: 18px; }
  .social-icons { display: flex; gap: 10px; }
  .social-icon {
    width: 34px; height: 34px;
    border: 1px solid var(--border);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    color: var(--text-light);
  }
  .social-icon:hover { border-color: var(--gold); color: var(--gold); }
  .social-icon svg { width: 15px; height: 15px; }
  .footer-col h4 {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 16px;
    letter-spacing: 0.3px;
  }
  .footer-col a {
    display: block;
    font-size: 13px;
    color: var(--text-light);
    text-decoration: none;
    margin-bottom: 10px;
    transition: color 0.2s;
  }
  .footer-col a:hover { color: var(--gold); }
  .newsletter-form { display: flex; flex-direction: column; gap: 10px; }
  .newsletter-form input {
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    outline: none;
    background: var(--cream);
    transition: border-color 0.2s;
  }
  .newsletter-form input:focus { border-color: var(--gold); }
  .newsletter-form button {
    padding: 10px;
    background: var(--gold);
    color: white;
    border: none;
    border-radius: 8px;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
  }
  .newsletter-form button:hover { background: var(--brown-soft); }
  .footer-bottom {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    color: var(--text-light);
  }
  .footer-bottom-links { display: flex; gap: 20px; }
  .footer-bottom-links a { color: var(--text-light); text-decoration: none; }
  .footer-bottom-links a:hover { color: var(--gold); }

  /* ── TOAST ── */
  .toast {
    position: fixed;
    bottom: 28px; right: 28px;
    background: var(--text-dark);
    color: white;
    padding: 12px 20px;
    border-radius: 10px;
    font-size: 13px;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s;
    z-index: 999;
    pointer-events: none;
    display: flex; align-items: center; gap: 8px;
  }
  .toast.show { opacity: 1; transform: translateY(0); }
  .toast svg { width: 16px; height: 16px; color: var(--green); }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <a href="#" class="logo">
    <svg viewBox="0 0 32 32" fill="none">
      <polygon points="16,2 28,10 28,22 16,30 4,22 4,10" fill="none" stroke="currentColor" stroke-width="2"/>
      <polygon points="16,8 22,12 22,20 16,24 10,20 10,12" fill="currentColor" opacity="0.3"/>
    </svg>
    Elanora
  </a>
  <div class="nav-links">
    <a href="#">Home</a>
    <a href="#">Shop</a>
    <a href="#">About Us</a>
    <a href="#">Contact Us</a>
  </div>
  <div class="nav-icons">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    <div class="cart-badge" style="position:relative;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span class="badge">1</span>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <!-- PROFILE CARD -->
  <div class="profile-card">
    <div class="avatar-wrap">
