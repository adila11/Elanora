<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Detail – Elanora</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: #fdfaf5;
      color: #2c2c2c;
    }

    /* ── ORDER HEADER ── */
    .order-header {
      display: flex;
      align-items: center;
      gap: 14px;
      border-bottom: 1px solid #f0ece4;
      padding-bottom: 18px;
      margin-bottom: 28px;
    }

    .back-btn {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 1px solid #e8e0d0;
      background: none;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.15s;
      flex-shrink: 0;
      text-decoration: none;
      color: #888;
    }

    .back-btn:hover { background: #fdfaf5; }

    .order-header h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: #2c2c2c;
    }

    /* ── META GRID ── */
    .order-meta {
      background: #fdfaf5;
      border: 1px solid #e8e0d0;
      border-radius: 10px;
      padding: 18px 22px;
      display: grid;
      grid-template-columns: repeat(4, 1fr) auto;
      gap: 16px;
      align-items: center;
      margin-bottom: 30px;
    }

    .meta-group label {
      display: block;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #aaa;
      margin-bottom: 4px;
    }

    .meta-group span {
      font-size: 0.85rem;
      font-weight: 500;
      color: #2c2c2c;
    }

    .meta-address {
      font-size: 0.8rem;
      color: #888;
      line-height: 1.55;
      display: flex;
      align-items: flex-start;
      gap: 6px;
    }

    .meta-address svg {
      width: 13px;
      margin-top: 2px;
      color: #c49a2a;
      flex-shrink: 0;
    }

    /* ── STATUS BADGES ── */
    .status-badge {
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }

    .status-badge.pending,
    .status-badge.processing,
    .status-badge.shipped,
    .status-badge.out_for_delivery { background: #EBF3FD; color: #5B9BD5; border: 1px solid #C5DCEF; }

    .status-badge.delivered { background: #EBF8F2; color: #4CAF7D; border: 1px solid #B5E5CE; }

    .status-badge.cancelled,
    .status-badge.returned { background: #FDF0EE; color: #C0392B; border: 1px solid #E8B4B0; }

    /* ── TRACKER ── */
    .tracker-wrap {
      position: relative;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 34px;
      padding: 0 12px;
    }

    .tracker-line {
      position: absolute;
      top: 20px;
      left: 32px;
      right: 32px;
      height: 2px;
      background: #e8e0d0;
      z-index: 0;
    }

    .tracker-fill {
      position: absolute;
      top: 20px;
      left: 32px;
      height: 2px;
      background: linear-gradient(90deg, #c49a2a, #e8c97a);
      z-index: 1;
      transition: width 0.4s ease;
    }

    .tracker-step {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      z-index: 2;
    }

    .step-dot {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #e8e0d0;
      border: 2px solid #e8e0d0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .step-dot.done {
      background: #c49a2a;
      border-color: #c49a2a;
    }

    .step-dot svg { width: 18px; height: 18px; color: #fff; }

    .tracker-step span {
      font-size: 0.7rem;
      color: #aaa;
      text-align: center;
      white-space: nowrap;
    }

    .tracker-step.done span {
      color: #c49a2a;
      font-weight: 600;
    }

    /* ── SECTION TITLE ── */
    .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: #2c2c2c;
      margin-bottom: 14px;
    }

    /* ── ITEM ROWS ── */
    .order-item {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 16px;
      border: 1px solid #e8e0d0;
      border-radius: 10px;
      margin-bottom: 12px;
      transition: box-shadow 0.2s;
    }

    .order-item:hover {
      box-shadow: 0 4px 18px rgba(44, 31, 14, 0.07);
    }

    .item-img {
      width: 68px;
      height: 68px;
      border-radius: 9px;
      background: #f7f3ec;
      overflow: hidden;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .item-img img { width: 100%; height: 100%; object-fit: cover; }

    .item-details { flex: 1; }

    .item-details h4 {
      font-size: 0.9rem;
      font-weight: 600;
      color: #2c2c2c;
      margin-bottom: 3px;
    }

    .item-details p {
      font-size: 0.78rem;
      color: #aaa;
      margin-bottom: 6px;
    }

    .item-qty {
      font-size: 0.8rem;
      color: #888;
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .item-qty .dot {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: #ccc;
    }

    .item-qty strong { color: #2c2c2c; font-weight: 600; }

    .item-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    /* ── ACTION BUTTONS ── */
    .btn-gold {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #c49a2a;
      color: #fff;
      border: none;
      padding: 7px 16px;
      border-radius: 30px;
      font-size: 0.78rem;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: background 0.15s;
    }

    .btn-gold:hover { background: #a87820; }

    .btn-outline-red {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 7px 16px;
      background: transparent;
      color: #C0392B;
      border: 1px solid #E8B4B0;
      border-radius: 30px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.78rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.15s;
    }

    .btn-outline-red:hover { background: #FDF0EE; border-color: #C0392B; }

    .btn-outline-gold {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 7px 16px;
      background: transparent;
      color: #c49a2a;
      border: 1px solid #c49a2a;
      border-radius: 30px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.78rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.15s;
    }

    .btn-outline-gold:hover { background: #c49a2a; color: #fff; }

    /* ── ITEM STATUS BADGE ── */
    .item-status-badge {
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.7rem;
      font-weight: 600;
      background: #EBF8F2;
      color: #4CAF7D;
      border: 1px solid #B5E5CE;
    }

    /* ── SUMMARY ── */
    .order-summary {
      margin-top: 26px;
      padding-top: 22px;
      border-top: 1px solid #e8e0d0;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
      font-size: 0.85rem;
      color: #888;
    }

    .summary-row.total {
      font-size: 0.95rem;
      font-weight: 700;
      color: #2c2c2c;
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid #e8e0d0;
    }

    /* ── MODALS ── */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(44, 31, 14, 0.4);
      backdrop-filter: blur(3px);
      z-index: 999;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.22s;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: all;
    }

    .modal {
      background: #fff;
      border-radius: 18px;
      width: 100%;
      max-width: 440px;
      padding: 30px;
      box-shadow: 0 20px 60px rgba(44, 31, 14, 0.15);
      transform: translateY(16px) scale(0.97);
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
    }

    .modal-overlay.active .modal { transform: translateY(0) scale(1); }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .modal-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: #2c2c2c;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .modal-title svg { width: 18px; height: 18px; color: #c49a2a; }

    .modal-close {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: none;
      background: #f7f3ec;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: #888;
      transition: background 0.15s;
    }

    .modal-close:hover { background: #e8e0d0; }
    .modal-close svg { width: 13px; height: 13px; }

    .modal-item-card {
      background: #fdfaf5;
      border: 1px solid #e8e0d0;
      border-radius: 10px;
      padding: 14px;
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 22px;
    }

    .modal-item-img {
      width: 50px;
      height: 50px;
      border-radius: 8px;
      background: #f7f3ec;
      overflow: hidden;
      flex-shrink: 0;
    }

    .modal-item-img img { width: 100%; height: 100%; object-fit: cover; }

    .modal-item-info h4 { font-size: 0.88rem; font-weight: 600; margin-bottom: 3px; }
    .modal-item-info p { font-size: 0.75rem; color: #aaa; }

    /* Reasons */
    .reasons-label {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #2c2c2c;
      margin-bottom: 10px;
    }

    .reasons-list { display: flex; flex-direction: column; gap: 7px; margin-bottom: 18px; }

    .reason-option {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      border: 1.5px solid #e8e0d0;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.83rem;
      color: #888;
      transition: all 0.15s;
    }

    .reason-option:hover { border-color: #c49a2a; background: #fdf9ef; }

    .reason-option.selected { border-color: #c49a2a; background: #fdf9ef; color: #2c2c2c; }

    .radio-circle {
      width: 17px;
      height: 17px;
      border-radius: 50%;
      border: 1.5px solid #e8e0d0;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.15s;
    }

    .reason-option.selected .radio-circle { border-color: #c49a2a; background: #c49a2a; }

    .radio-dot { width: 7px; height: 7px; border-radius: 50%; background: #fff; display: none; }
    .reason-option.selected .radio-dot { display: block; }

    /* Textarea */
    .modal-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #2c2c2c;
      margin-bottom: 7px;
    }

    .modal-label span { font-weight: 400; text-transform: none; letter-spacing: 0; color: #bbb; }

    .modal-textarea {
      width: 100%;
      height: 88px;
      resize: none;
      padding: 12px 14px;
      border: 1px solid #e8e0d0;
      border-radius: 9px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.875rem;
      color: #2c2c2c;
      background: #fdfaf5;
      outline: none;
      transition: border-color 0.15s;
      margin-bottom: 20px;
    }

    .modal-textarea:focus { border-color: #c49a2a; background: #fff; }
    .modal-textarea::placeholder { color: #bbb; }

    /* Modal actions */
    .modal-actions { display: flex; gap: 12px; }

    .modal-btn-cancel {
      flex: 1;
      padding: 11px;
      background: #f7f3ec;
      border: 1px solid #e8e0d0;
      border-radius: 30px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.85rem;
      font-weight: 500;
      color: #888;
      cursor: pointer;
      transition: background 0.15s;
    }

    .modal-btn-cancel:hover { background: #e8e0d0; }

    .modal-btn-submit {
      flex: 1;
      padding: 11px;
      background: #c49a2a;
      border: none;
      border-radius: 30px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      color: #fff;
      cursor: pointer;
      transition: background 0.15s;
    }

    .modal-btn-submit:hover { background: #a87820; }
    .modal-btn-submit:disabled { background: #e8e0d0; color: #bbb; cursor: not-allowed; }

    .modal-btn-danger {
      flex: 1;
      padding: 11px;
      background: #C0392B;
      border: none;
      border-radius: 30px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      color: #fff;
      cursor: pointer;
      transition: background 0.15s;
    }

    .modal-btn-danger:hover { background: #a93226; }
  </style>
</head>

<body>

  <%- include('partials/user/header') %>

  <div style="max-width:1200px; margin:0 auto; padding:90px 24px 80px;">

    <%- include('partials/user/profileBanner', { user }) %>

    <div style="display:grid; grid-template-columns:230px 1fr; gap:24px;">

      <%- include('partials/user/profileSidebar', { activePage: 'orders' }) %>

      <main style="background:#fff; border-radius:18px; padding:40px; border:1px solid #e8e0d0; box-shadow:0 2px 8px rgba(0,0,0,0.04);">

        <!-- Header row -->
        <div class="order-header">
          <a href="/orders" class="back-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
          </a>
          <h3>Order #<%= order.orderId %></h3>

          <% if (['pending', 'processing'].includes(order.orderStatus)) { %>
            <button class="btn-outline-red" style="margin-left:auto;" onclick="openFullCancelModal()">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
              </svg>
              Cancel Order
            </button>
          <% } %>
        </div>

        <!-- Meta -->
        <div class="order-meta">
          <div class="meta-group">
            <label>Order Date</label>
            <span><%= new Date(order.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></span>
          </div>
          <div class="meta-group">
            <label>Total</label>
            <span>₹<%= order.finalAmount %></span>
          </div>
          <div class="meta-group">
            <label>Payment</label>
            <span><%= order.paymentMethod.toUpperCase() %></span>
          </div>
          <div class="meta-address">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span>
              <%= order.shippingAddress.fullName %><br>
              <%= order.shippingAddress.addressLine %>, <%= order.shippingAddress.city %><br>
              <%= order.shippingAddress.state %> – <%= order.shippingAddress.pincode %><br>
              Phone: <%= order.shippingAddress.phone %>
            </span>
          </div>
          <span class="status-badge <%= order.orderStatus %>">
            <%= String(order.orderStatus).replaceAll('_',' ').replace(/\b\w/g, c => c.toUpperCase()) %>
          </span>
        </div>

        <!-- Tracker -->
        <%
          const statusSteps = ['pending','processing','shipped','out_for_delivery','delivered'];
          let currentStep = statusSteps.indexOf(order.orderStatus);
          if (currentStep < 0) currentStep = 0;
          const fillPct = (currentStep / (statusSteps.length - 1)) * 100;
        %>
        <div class="tracker-wrap">
          <div class="tracker-line"></div>
          <div class="tracker-fill" style="width:<%= fillPct %>%;"></div>

          <% const trackerSteps = [
            { label:'Order Placed',     icon:'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2' },
            { label:'Processing',       icon:'M20 6L9 17l-5-5' },
            { label:'Shipped',          icon:'M1 3h15v13H1zM16 8l4 0 3 3 0 5-7 0' },
            { label:'Out for Delivery', icon:'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0zM12 10m-3 0a3 3 0 106 0 3 3 0 10-6 0' },
            { label:'Delivered',        icon:'M20 6L9 17l-5-5' },
          ]; %>

          <% trackerSteps.forEach((step, i) => { %>
            <div class="tracker-step <%= currentStep >= i ? 'done' : '' %>">
              <div class="step-dot <%= currentStep >= i ? 'done' : '' %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="<%= step.icon %>"/>
                </svg>
              </div>
              <span><%= step.label %></span>
            </div>
          <% }) %>
        </div>

        <!-- Items -->
        <p class="section-title">Items in this Order</p>

        <% order.items.forEach(item => { %>
          <div class="order-item">
            <div class="item-img">
              <% if (item.productImage) { %>
                <img src="<%= item.productImage %>" alt="<%= item.productName %>">
              <% } else { %>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#c49a2a" stroke-width="1.5">
                  <rect x="2" y="3" width="20" height="14" rx="2"/>
                </svg>
              <% } %>
            </div>

            <div class="item-details">
              <h4><%= item.productName %></h4>
              <p><%= item.variantName || 'Default Variant' %></p>
              <div class="item-qty">
                <span>Qty: <%= item.qty %></span>
                <div class="dot"></div>
                <strong>₹<%= item.total %></strong>
              </div>
            </div>

            <div class="item-actions">
              <%# itemStatus: 'active' | 'cancelled' | 'returned' — show order status when item is active %>
              <span class="item-status-badge" style="<%= item.itemStatus === 'cancelled' ? 'background:#FDF0EE;color:#C0392B;border-color:#E8B4B0;' : item.itemStatus === 'returned' ? 'background:#FDF0EE;color:#C0392B;border-color:#E8B4B0;' : '' %>">
                <% if (item.itemStatus === 'active') { %>
                  <%= String(order.orderStatus).replaceAll('_',' ').replace(/\b\w/g, c => c.toUpperCase()) %>
                <% } else { %>
                  <%= String(item.itemStatus).replace(/\b\w/g, c => c.toUpperCase()) %>
                <% } %>
              </span>

              <%# Return: only after delivered, and item not already returned or cancelled %>
              <% if (order.orderStatus === 'delivered' && item.itemStatus === 'active') { %>
                <% const rId = JSON.stringify(String(item._id)); const rName = JSON.stringify(item.productName); const rSub = JSON.stringify(item.variantName || 'Default Variant'); const rImg = JSON.stringify(item.productImage || ''); %>
<button
  class="btn-outline-gold"
  data-id="<%= item._id %>"
  data-name="<%= item.productName %>"
  data-sub="<%= item.variantName || 'Default Variant' %>"
  data-img="<%= item.productImage || '' %>"
  onclick="openReturnModal(this)"
>                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/>
                  </svg>
                  Return
                </button>
              <% } %>

              <%# Cancel Item: only before shipped (pending/processing), and item is still active %>
              <% if (['pending', 'processing'].includes(order.orderStatus) && item.itemStatus === 'active') { %>
                <% const cId = JSON.stringify(String(item._id)); const cName = JSON.stringify(item.productName); const cSub = JSON.stringify(item.variantName || 'Default Variant'); const cImg = JSON.stringify(item.productImage || ''); %>
<button
  class="btn-outline-red"
  data-id="<%= item._id %>"
  data-name="<%= item.productName %>"
  data-sub="<%= item.variantName || 'Default Variant' %>"
  data-img="<%= item.productImage || '' %>"
  onclick="openPartialCancelModal(this)"
>                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                  </svg>
                  Cancel Item
                </button>
              <% } %>
            </div>
          </div>
        <% }) %>

        <!-- Summary -->
        <div class="order-summary">
          <div class="summary-row"><span>Subtotal</span><span>₹<%= order.orderTotal %></span></div>
          <div class="summary-row"><span>Delivery Charge</span><span>₹<%= order.deliveryCharge %></span></div>
          <div class="summary-row"><span>Discount</span><span>– ₹<%= order.discount %></span></div>
          <div class="summary-row total"><span>Total</span><span>₹<%= order.finalAmount %></span></div>
        </div>

      </main>
    </div>
  </div>

  <%- include('partials/user/footer') %>

  <!-- ── RETURN ITEM MODAL ── -->
  <div class="modal-overlay" id="returnModal" onclick="if(event.target===this) closeReturnModal()">
    <div class="modal">
      <div class="modal-header">
        <div class="modal-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/>
          </svg>
          Return Item
        </div>
        <button class="modal-close" onclick="closeReturnModal()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <div class="modal-item-card">
        <div class="modal-item-img"><img id="returnItemImg" src="" alt=""></div>
        <div class="modal-item-info">
          <h4 id="returnItemName"></h4>
          <p id="returnItemSub"></p>
        </div>
      </div>

      <p class="reasons-label">Select a reason for return:</p>
      <div class="reasons-list" id="returnReasonsList">
        <% ['Item is defective or damaged','Wrong item received','Item doesn\'t match description','Changed my mind','Item arrived too late','Other'].forEach(r => { %>
          <div class="reason-option" onclick="selectReason(this, 'returnSubmitBtn')">
            <div class="radio-circle"><div class="radio-dot"></div></div>
            <%= r %>
          </div>
        <% }) %>
      </div>

      <label class="modal-label">Additional details <span>(optional)</span></label>
      <textarea class="modal-textarea" id="returnDetails" placeholder="Please provide more information…"></textarea>

      <div class="modal-actions">
        <button class="modal-btn-cancel" onclick="closeReturnModal()">Cancel</button>
        <button class="modal-btn-submit" id="returnSubmitBtn" disabled onclick="submitReturn()">Submit Return</button>
      </div>
    </div>
  </div>

  <!-- ── FULL CANCEL MODAL ── -->
  <div class="modal-overlay" id="fullCancelModal" onclick="if(event.target===this) closeFullCancelModal()">
    <div class="modal">
      <div class="modal-header">
        <div class="modal-title">Cancel Entire Order</div>
        <button class="modal-close" onclick="closeFullCancelModal()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <p style="font-size:0.82rem;color:#aaa;margin-bottom:18px;">This will cancel all items in your order. This action cannot be undone.</p>
      <label class="modal-label">Reason</label>
      <textarea class="modal-textarea" id="fullCancelReason" placeholder="Tell us why you're cancelling…"></textarea>
      <div class="modal-actions">
        <button class="modal-btn-cancel" onclick="closeFullCancelModal()">Keep Order</button>
        <button class="modal-btn-danger" onclick="submitFullCancel()">Yes, Cancel Order</button>
      </div>
    </div>
  </div>

  <!-- ── PARTIAL ITEM CANCEL MODAL ── -->
  <div class="modal-overlay" id="partialCancelModal" onclick="if(event.target===this) closePartialCancelModal()">
    <div class="modal">
      <div class="modal-header">
        <div class="modal-title">Cancel Item</div>
        <button class="modal-close" onclick="closePartialCancelModal()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="modal-item-card">
        <div class="modal-item-img"><img id="partialCancelImg" src="" alt=""></div>
        <div class="modal-item-info">
          <h4 id="partialCancelName"></h4>
          <p id="partialCancelSub"></p>
        </div>
      </div>
      <label class="modal-label">Reason</label>
      <textarea class="modal-textarea" id="partialCancelReason" placeholder="Tell us why you're cancelling this item…"></textarea>
      <div class="modal-actions">
        <button class="modal-btn-cancel" onclick="closePartialCancelModal()">Keep Item</button>
        <button class="modal-btn-danger" onclick="submitPartialCancel()">Cancel Item</button>
      </div>
    </div>
  </div>

  <script>
    let returnItemId = null;
    let partialCancelItemId = null;

    // ── Escape key closes all modals
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        closeReturnModal();
        closeFullCancelModal();
        closePartialCancelModal();
      }
    });

    // ── Reason selector
    function selectReason(el, submitBtnId) {
      el.closest('.reasons-list').querySelectorAll('.reason-option').forEach(r => r.classList.remove('selected'));
      el.classList.add('selected');
      if (submitBtnId) document.getElementById(submitBtnId).disabled = false;
    }

    // ── Return modal
    function openReturnModal(btn) {

  const itemId = btn.dataset.id;
  const name = btn.dataset.name;
  const sub = btn.dataset.sub;
  const img = btn.dataset.img;

  returnItemId = itemId;

  document.getElementById('returnItemName').textContent = name;
  document.getElementById('returnItemSub').textContent = sub;
  document.getElementById('returnItemImg').src = img || '';

  document.getElementById('returnDetails').value = '';

  document.getElementById('returnSubmitBtn').disabled = true;

  document.querySelectorAll('#returnReasonsList .reason-option')
    .forEach(r => r.classList.remove('selected'));

  document.getElementById('returnModal').classList.add('active');

  document.body.style.overflow = 'hidden';
}

    function closeReturnModal() {
      document.getElementById('returnModal').classList.remove('active');
      document.body.style.overflow = '';
    }

    async function submitReturn() {
      const selected = document.querySelector('#returnReasonsList .reason-option.selected');
      if (!selected) return;
      const reason = selected.textContent.trim();
      const details = document.getElementById('returnDetails').value;
      const btn = document.getElementById('returnSubmitBtn');
      btn.disabled = true;
      btn.textContent = 'Submitting…';
      try {
        const res = await fetch(`/return-item/${returnItemId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason, details })
        });
        const data = await res.json();
        if (data.success) {
          closeReturnModal();
          if (typeof window.showToast === 'function') window.showToast('Return request submitted!', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          if (typeof window.showToast === 'function') window.showToast(data.message || 'Something went wrong.', 'error');
          btn.disabled = false;
          btn.textContent = 'Submit Return';
        }
      } catch (err) {
        if (typeof window.showToast === 'function') window.showToast('Network error. Please try again.', 'error');
        btn.disabled = false;
        btn.textContent = 'Submit Return';
      }
    }

    // ── Full cancel modal
    function openFullCancelModal() {
      document.getElementById('fullCancelReason').value = '';
      document.getElementById('fullCancelModal').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeFullCancelModal() {
      document.getElementById('fullCancelModal').classList.remove('active');
      document.body.style.overflow = '';
    }

    async function submitFullCancel() {
      const reason = document.getElementById('fullCancelReason').value.trim();
      if (!reason) {
        if (typeof window.showToast === 'function') window.showToast('Please enter a cancellation reason.', 'error');
        return;
      }
      const btn = document.querySelector('#fullCancelModal .modal-btn-danger');
      btn.disabled = true;
      btn.textContent = 'Cancelling…';
      try {
        const res = await fetch(`/cancel-order/<%= order._id %>`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason })
        });
        const data = await res.json();
        if (data.success) {
          closeFullCancelModal();
          if (typeof window.showToast === 'function') window.showToast('Order cancelled successfully.', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          if (typeof window.showToast === 'function') window.showToast(data.message || 'Failed to cancel order.', 'error');
          btn.disabled = false;
          btn.textContent = 'Yes, Cancel Order';
        }
      } catch (err) {
        if (typeof window.showToast === 'function') window.showToast('Network error. Please try again.', 'error');
        btn.disabled = false;
        btn.textContent = 'Yes, Cancel Order';
      }
    }

    // ── Partial item cancel modal
    function openPartialCancelModal(btn) {

      partialCancelItemId = btn.dataset.id;

      document.getElementById('partialCancelName').textContent =
        btn.dataset.name;

      document.getElementById('partialCancelSub').textContent =
        btn.dataset.sub;

      document.getElementById('partialCancelImg').src =
        btn.dataset.img || '';

      document.getElementById('partialCancelReason').value = '';

      document.getElementById('partialCancelModal').classList.add('active');

      document.body.style.overflow = 'hidden';
    }

    function closePartialCancelModal() {
      document.getElementById('partialCancelModal').classList.remove('active');
      document.body.style.overflow = '';
    }

    async function submitPartialCancel() {
      const reason = document.getElementById('partialCancelReason').value.trim();
      if (!reason) {
        if (typeof window.showToast === 'function') window.showToast('Please enter a cancellation reason.', 'error');
        return;
      }
      const btn = document.querySelector('#partialCancelModal .modal-btn-danger');
      btn.disabled = true;
      btn.textContent = 'Cancelling…';
      try {
        const res = await fetch(`/cancel-item/${partialCancelItemId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason })
        });
        const data = await res.json();
        if (data.success) {
          closePartialCancelModal();
          if (typeof window.showToast === 'function') window.showToast('Item cancelled successfully.', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          if (typeof window.showToast === 'function') window.showToast(data.message || 'Failed to cancel item.', 'error');
          btn.disabled = false;
          btn.textContent = 'Cancel Item';
        }
      } catch (err) {
        if (typeof window.showToast === 'function') window.showToast('Network error. Please try again.', 'error');
        btn.disabled = false;
        btn.textContent = 'Cancel Item';
      }
    }
  </script>
</body>

</html>
