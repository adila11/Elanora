<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Detail – Elanora</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap"
    rel="stylesheet">

  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: #fdfaf5;
      color: #2c2c2c;
    }

    /* ORDER HEADER */
    .order-header {
      display: flex;
      align-items: center;
      gap: 14px;
      border-bottom: 1px solid #f0ece4;
      padding-bottom: 18px;
      margin-bottom: 28px;
    }

    .back-btn {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 1px solid #e8e0d0;
      background: none;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.15s;
      flex-shrink: 0;
      text-decoration: none;
      color: #888;
    }

    .back-btn:hover {
      background: #fdfaf5;
    }

    .order-header h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: #2c2c2c;
    }

    /* META GRID */
    .order-meta {
      background: #fdfaf5;
      border: 1px solid #e8e0d0;
      border-radius: 10px;
      padding: 18px 22px;
      display: grid;
      grid-template-columns: repeat(4, 1fr) auto;
      gap: 16px;
      align-items: center;
      margin-bottom: 30px;
    }

    .meta-group label {
      display: block;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #aaa;
      margin-bottom: 4px;
    }

    .meta-group span {
      font-size: 0.85rem;
      font-weight: 500;
      color: #2c2c2c;
    }

    .meta-address {
      font-size: 0.8rem;
      color: #888;
      line-height: 1.55;
      display: flex;
      align-items: flex-start;
      gap: 6px;
    }

    .meta-address svg {
      width: 13px;
      margin-top: 2px;
      color: #c49a2a;
      flex-shrink: 0;
    }

    /* STATUS BADGES */
    .status-badge {
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }

    .status-badge.pending {
      background: #EBF3FD;
      color: #5B9BD5;
      border: 1px solid #C5DCEF;
    }

    .status-badge.processing {
      background: #EBF3FD;
      color: #5B9BD5;
      border: 1px solid #C5DCEF;
    }

    .status-badge.shipped {
      background: #EBF3FD;
      color: #5B9BD5;
      border: 1px solid #C5DCEF;
    }

    .status-badge.out_for_delivery {
      background: #EBF3FD;
      color: #5B9BD5;
      border: 1px solid #C5DCEF;
    }

    .status-badge.delivered {
      background: #EBF8F2;
      color: #4CAF7D;
      border: 1px solid #B5E5CE;
    }

    .status-badge.cancelled {
      background: #FDF0EE;
      color: #C0392B;
      border: 1px solid #E8B4B0;
    }

    .status-badge.partially_cancelled {
      background: #FDF0EE;
      color: #C0392B;
      border: 1px solid #E8B4B0;
    }

    .status-badge.returned {
      background: #FDF0EE;
      color: #C0392B;
      border: 1px solid #E8B4B0;
    }

    .status-badge.partially_returned {
      background: #FDF0EE;
      color: #C0392B;
      border: 1px solid #E8B4B0;
    }

    .status-badge.payment_failed {
      background: #FDF0EE;
      color: #C0392B;
      border: 1px solid #E8B4B0;
    }

    /* RETRY PAYMENT BTN */
    .retry-btn-detail {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 18px;
      background: #c49a2a;
      color: #fff;
      border: none;
      border-radius: 20px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      margin-left: 12px;
    }

    .retry-btn-detail:hover {
      background: #a87820;
      transform: scale(1.02);
    }

    .retry-btn-detail:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    /* TRACKER */
    .tracker-wrap {
      position: relative;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 34px;
      padding: 0 12px;
    }

    .tracker-line {
      position: absolute;
      top: 20px;
      left: 32px;
      right: 32px;
      height: 2px;
      background: #e8e0d0;
      z-index: 0;
    }

    .tracker-fill {
      position: absolute;
      top: 20px;
      left: 32px;
      height: 2px;
      background: linear-gradient(90deg, #c49a2a, #e8c97a);
      z-index: 1;
      transition: width 0.4s ease;
    }

    .tracker-fill.red-fill {
      background: linear-gradient(90deg, #C0392B, #e87a7a);
    }

    .tracker-step {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      z-index: 2;
    }

    .step-dot {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #e8e0d0;
      border: 2px solid #e8e0d0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .step-dot.done {
      background: #c49a2a;
      border-color: #c49a2a;
    }

    .step-dot.done-red {
      background: #C0392B;
      border-color: #C0392B;
    }

    .step-dot svg {
      width: 18px;
      height: 18px;
      color: #fff;
    }

    .tracker-step span {
      font-size: 0.7rem;
      color: #aaa;
      text-align: center;
      white-space: nowrap;
    }

    .tracker-step.done span {
      color: #c49a2a;
      font-weight: 600;
    }

    .tracker-step.done-red span {
      color: #C0392B;
      font-weight: 600;
    }

    /* SECTION TITLE */
    .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: #2c2c2c;
      margin-bottom: 14px;
    }

    /* ITEM ROWS */
    .order-item {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      padding: 16px;
      border: 1px solid #e8e0d0;
      border-radius: 10px;
      margin-bottom: 12px;
      transition: box-shadow 0.2s;
    }

    .order-item:hover {
      box-shadow: 0 4px 18px rgba(44, 31, 14, 0.07);
    }

    .item-img {
      width: 68px;
      height: 68px;
      border-radius: 9px;
      background: #f7f3ec;
      overflow: hidden;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .item-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .item-details {
      flex: 1;
    }

    .item-details h4 {
      font-size: 0.9rem;
      font-weight: 600;
      color: #2c2c2c;
      margin-bottom: 3px;
    }

    .item-details p {
      font-size: 0.78rem;
      color: #aaa;
      margin-bottom: 6px;
    }

    .item-qty {
      font-size: 0.8rem;
      color: #888;
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .item-qty .dot {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: #ccc;
    }

    .item-qty strong {
      color: #2c2c2c;
      font-weight: 600;
    }

    .item-meta-info {
      margin-top: 10px;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 0.78rem;
      line-height: 1.6;
    }

    .item-meta-info.cancelled-meta {
      background: #FDF0EE;
      border: 1px solid #F5C6C2;
    }

    .item-meta-info.returned-meta {
      background: #F5EEFF;
      border: 1px solid #D4B8F0;
    }

    .item-meta-info .meta-label {
      font-weight: 600;
      font-size: 0.7rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      display: inline-block;
      margin-right: 6px;
    }

    .item-meta-info.cancelled-meta .meta-label {
      color: #C0392B;
    }

    .item-meta-info.returned-meta .meta-label {
      color: #7B4FA6;
    }

    .item-meta-info.cancelled-meta .meta-value {
      color: #8B3A30;
    }

    .item-meta-info.returned-meta .meta-value {
      color: #5A3578;
    }

    .item-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .btn-gold {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #c49a2a;
      color: #fff;
      border: none;
      padding: 7px 16px;
      border-radius: 30px;
      font-size: 0.78rem;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: background 0.15s;
    }

    .btn-gold:hover {
      background: #a87820;
    }

    .btn-outline-red {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 7px 16px;
      background: transparent;
      color: #C0392B;
      border: 1px solid #E8B4B0;
      border-radius: 30px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.78rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.15s;
    }

    .btn-outline-red:hover {
      background: #FDF0EE;
      border-color: #C0392B;
    }

    .btn-outline-gold {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 7px 16px;
      background: transparent;
      color: #c49a2a;
      border: 1px solid #c49a2a;
      border-radius: 30px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.78rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.15s;
    }

    .btn-outline-gold:hover {
      background: #c49a2a;
      color: #fff;
    }

    /* ITEM STATUS BADGES */
    .item-status-badge {
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.7rem;
      font-weight: 600;
      white-space: nowrap;
    }

    .item-status-badge.item-active-delivered {
      background: #EBF8F2;
      color: #4CAF7D;
      border: 1px solid #B5E5CE;
    }

    .item-status-badge.item-active-progress {
      background: #EBF3FD;
      color: #5B9BD5;
      border: 1px solid #C5DCEF;
    }

    .item-status-badge.item-cancelled {
      background: #FDF0EE;
      color: #C0392B;
      border: 1px solid #E8B4B0;
    }

    .item-status-badge.item-returned {
      background: #F5EEFF;
      color: #7B4FA6;
      border: 1px solid #D4B8F0;
    }

    .item-status-badge.item-return-requested {
      background: #FFF3E6;
      color: #D4730A;
      border: 1px solid #F5C97A;
    }

    .item-status-badge.item-return-rejected {
      background: #FDF0EE;
      color: #C0392B;
      border: 1px solid #E8B4B0;
    }

    /* SUMMARY */
    .order-summary {
      margin-top: 26px;
      padding-top: 22px;
      border-top: 1px solid #e8e0d0;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
      font-size: 0.85rem;
      color: #888;
    }

    .summary-row.total {
      font-size: 0.95rem;
      font-weight: 700;
      color: #2c2c2c;
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid #e8e0d0;
    }

    /* MODALS */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(44, 31, 14, 0.4);
      backdrop-filter: blur(3px);
      z-index: 999;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.22s;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: all;
    }

    .modal {
      background: #fff;
      border-radius: 18px;
      width: 100%;
      max-width: 440px;
      padding: 30px;
      box-shadow: 0 20px 60px rgba(44, 31, 14, 0.15);
      transform: translateY(16px) scale(0.97);
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
    }

    .modal-overlay.active .modal {
      transform: translateY(0) scale(1);
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .modal-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: #2c2c2c;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .modal-title svg {
      width: 18px;
      height: 18px;
      color: #c49a2a;
    }

    .modal-close {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: none;
      background: #f7f3ec;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: #888;
      transition: background 0.15s;
    }

    .modal-close:hover {
      background: #e8e0d0;
    }

    .modal-close svg {
      width: 13px;
      height: 13px;
    }

    .modal-item-card {
      background: #fdfaf5;
      border: 1px solid #e8e0d0;
      border-radius: 10px;
      padding: 14px;
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 22px;
    }

    .modal-item-img {
      width: 50px;
      height: 50px;
      border-radius: 8px;
      background: #f7f3ec;
      overflow: hidden;
      flex-shrink: 0;
    }

    .modal-item-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .modal-item-info h4 {
      font-size: 0.88rem;
      font-weight: 600;
      margin-bottom: 3px;
    }

    .modal-item-info p {
      font-size: 0.75rem;
      color: #aaa;
    }

    .reasons-label {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #2c2c2c;
      margin-bottom: 10px;
    }

    .reasons-list {
      display: flex;
      flex-direction: column;
      gap: 7px;
      margin-bottom: 18px;
    }

    .reason-option {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      border: 1.5px solid #e8e0d0;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.83rem;
      color: #888;
      transition: all 0.15s;
    }

    .reason-option:hover {
      border-color: #c49a2a;
      background: #fdf9ef;
    }

    .reason-option.selected {
      border-color: #c49a2a;
      background: #fdf9ef;
      color: #2c2c2c;
    }

    .radio-circle {
      width: 17px;
      height: 17px;
      border-radius: 50%;
      border: 1.5px solid #e8e0d0;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.15s;
    }

    .reason-option.selected .radio-circle {
      border-color: #c49a2a;
      background: #c49a2a;
    }

    .radio-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #fff;
      display: none;
    }

    .reason-option.selected .radio-dot {
      display: block;
    }

    .modal-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #2c2c2c;
      margin-bottom: 7px;
    }

    .modal-label span {
      font-weight: 400;
      text-transform: none;
      letter-spacing: 0;
      color: #bbb;
    }

    .modal-textarea {
      width: 100%;
      height: 88px;
      resize: none;
      padding: 12px 14px;
      border: 1px solid #e8e0d0;
      border-radius: 9px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.875rem;
      color: #2c2c2c;
      background: #fdfaf5;
      outline: none;
      transition: border-color 0.15s;
      margin-bottom: 20px;
    }

    .modal-textarea:focus {
      border-color: #c49a2a;
      background: #fff;
    }

    .modal-textarea::placeholder {
      color: #bbb;
    }

    .modal-actions {
      display: flex;
      gap: 12px;
    }

    .modal-btn-cancel {
      flex: 1;
      padding: 11px;
      background: #f7f3ec;
      border: 1px solid #e8e0d0;
      border-radius: 30px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.85rem;
      font-weight: 500;
      color: #888;
      cursor: pointer;
      transition: background 0.15s;
    }

    .modal-btn-cancel:hover {
      background: #e8e0d0;
    }

    .modal-btn-submit {
      flex: 1;
      padding: 11px;
      background: #c49a2a;
      border: none;
      border-radius: 30px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      color: #fff;
      cursor: pointer;
      transition: background 0.15s;
    }

    .modal-btn-submit:hover {
      background: #a87820;
    }

    .modal-btn-submit:disabled {
      background: #e8e0d0;
      color: #bbb;
      cursor: not-allowed;
    }

    .modal-btn-danger {
      flex: 1;
      padding: 11px;
      background: #C0392B;
      border: none;
      border-radius: 30px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      color: #fff;
      cursor: pointer;
      transition: background 0.15s;
    }

    .modal-btn-danger:hover {
      background: #a93226;
    }

    /* PREMIUM INVOICE PRINT ONLY */
    .invoice-container-wrap {
      position: absolute;
      left: -9999px;
      top: -9999px;
      width: 190mm;
      /* Width Adjusted For Proper Fitting Without Overflow */
      background: #fff;
    }

    .invoice-card {
      padding: 10mm;
      background: #ffffff;
      color: #1a1a18;
      font-family: 'DM Sans', sans-serif;
    }

    .invoice-header-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      align-items: start;
      border-bottom: 2px solid #c8a96e;
      padding-bottom: 15px;
      margin-bottom: 20px;
    }

    .invoice-company-logo {
      font-family: 'Cormorant Garamond', serif;
      font-size: 32px;
      font-weight: 700;
      color: #1a1a18;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }

    .invoice-company-details {
      font-size: 11.5px;
      color: #7a7870;
      line-height: 1.6;
    }

    .invoice-meta-info {
      text-align: right;
    }

    .invoice-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 26px;
      font-weight: 600;
      color: #c8a96e;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 8px;
    }

    .invoice-meta-row {
      font-size: 12px;
      color: #1a1a18;
      margin-bottom: 4px;
    }

    .invoice-meta-row strong {
      color: #7a7870;
      font-weight: 500;
    }

    .invoice-address-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      margin-bottom: 25px;
    }

    .invoice-address-col h3 {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #7a7870;
      border-bottom: 1.5px solid #e8e6e0;
      padding-bottom: 4px;
      margin-bottom: 8px;
      font-weight: 600;
    }

    .invoice-address-details {
      font-size: 12.5px;
      line-height: 1.6;
      color: #1a1a18;
    }

    .invoice-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 25px;
    }

    .invoice-table th {
      background: #fafaf8;
      border-top: 1px solid #e8e6e0;
      border-bottom: 2px solid #e8e6e0;
      color: #7a7870;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 10px 12px;
      text-align: left;
    }

    .invoice-table td {
      padding: 12px;
      border-bottom: 1px solid #e8e6e0;
      font-size: 12.5px;
      color: #1a1a18;
      vertical-align: middle;
    }

    .invoice-table tr:last-child td {
      border-bottom: 2px solid #e8e6e0;
    }

    .invoice-item-status.cancelled { background: #fcecea; color: #c0392b; }
    .invoice-item-status.returned { background: #eef0fd; color: #5b52e8; }
    .invoice-item-status.return_requested { background: #fff4e0; color: #c47a10; }
    .invoice-item-status.return_rejected { background: #fcecea; color: #c0392b; }

    .invoice-item-name {
      font-weight: 500;
    }

    .invoice-item-variant {
      font-size: 11px;
      color: #7a7870;
      margin-top: 2px;
    }

    .invoice-total-section {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 30px;
      margin-bottom: 25px;
    }

    .invoice-notes {
      font-size: 11.5px;
      color: #7a7870;
      line-height: 1.6;
    }

    .invoice-notes h4 {
      font-size: 12px;
      color: #1a1a18;
      margin-bottom: 6px;
      font-weight: 600;
    }

    .invoice-summary-table {
      width: 100%;
      border-collapse: collapse;
    }

    .invoice-summary-table td {
      padding: 6px 12px;
      font-size: 12.5px;
      color: #7a7870;
    }

    .invoice-summary-table tr.grand-total td {
      font-size: 15px;
      font-weight: 600;
      color: #c8a96e;
      border-top: 1.5px dashed #e8e6e0;
      padding-top: 10px;
    }

    .invoice-footer {
      border-top: 1px solid #e8e6e0;
      padding-top: 15px;
      text-align: center;
      font-size: 11.5px;
      color: #7a7870;
      line-height: 1.5;
    }
  </style>
</head>

<body>

  <%- include('partials/user/header') %>

    <div style="max-width:1200px; margin:0 auto; padding:90px 24px 80px;">

      <%- include('partials/user/profileBanner', { user }) %>

        <div style="display:grid; grid-template-columns:230px 1fr; gap:24px;">

          <%- include('partials/user/profileSidebar', { activePage: 'orders' }) %>

            <main
              style="background:#fff; border-radius:18px; padding:40px; border:1px solid #e8e0d0; box-shadow:0 2px 8px rgba(0,0,0,0.04);">

              <% /* ═══════════════════════════════════════════════════ HELPER MAPPINGS
                ═══════════════════════════════════════════════════ */ const orderStatusLabel={ pending: 'Pending' ,
                processing: 'Processing' , shipped: 'Shipped' , out_for_delivery: 'Out for Delivery' ,
                delivered: 'Delivered' , cancelled: 'Cancelled' , partially_cancelled: 'Partially Cancelled' ,
                returned: 'Returned' , partially_returned: 'Partially Returned' , payment_failed: 'Payment Failed' , }; const itemStatusLabel={
                active: 'Active' , cancelled: 'Cancelled' , returned: 'Returned' , }; const returnStatusLabel={
                pending: 'Return Requested' , approved: 'Returned' , rejected: 'Return Rejected' , }; /*
                ═══════════════════════════════════════════════════ DERIVE EFFECTIVE ORDER STATUS FROM ITEMS
                ═══════════════════════════════════════════════════ The DB `orderStatus` drives the forward-progress
                steps. We compute an overlay status for cancel / return badges and tracker extra steps.
                ═══════════════════════════════════════════════════ */ const os=order.orderStatus; /* ── Cancellation
                analysis (only valid before shipping) ── */ const preShipStatuses=['pending', 'processing' , 'shipped'
                ]; const isPreShip=preShipStatuses.includes(os); const cancelledItems=order.items.filter(i=>
                i.itemStatus === 'cancelled');
                const hasCancelledItems = cancelledItems.length > 0 && isPreShip;

                // "all cancelled" means every item is cancelled
                const allCancelled = order.items.length > 0 &&
                order.items.every(i => i.itemStatus === 'cancelled');
                const someCancelled = hasCancelledItems && !allCancelled;

                /* ── Return analysis (only valid after delivery) ── */
                const isDelivered = os === 'delivered';

                // an item counts as returned if its itemStatus = 'returned'
                // OR if it has an approved return request
                const isItemReturned = (item) => {
                if (item.itemStatus === 'returned') return true;
                const rr = item.returnRequest || null;
                return rr && rr.status === 'approved';
                };

                const returnedItems = order.items.filter(isItemReturned);
                const hasReturnedItems = returnedItems.length > 0 && isDelivered;

                const allReturned = order.items.length > 0 && isDelivered &&
                order.items.every(isItemReturned);
                const someReturned = hasReturnedItems && !allReturned;

                /* ── Derive the display status shown in the badge ── */
                let displayStatus;
                if (allCancelled) displayStatus = 'cancelled';
                else if (someCancelled) displayStatus = 'partially_cancelled';
                else if (allReturned) displayStatus = 'returned';
                else if (someReturned) displayStatus = 'partially_returned';
                else displayStatus = os;

                /* CSS class for the order-level badge */
                const badgeCssMap = {
                pending: 'pending',
                processing: 'processing',
                shipped: 'shipped',
                out_for_delivery: 'out_for_delivery',
                delivered: 'delivered',
                cancelled: 'cancelled',
                partially_cancelled: 'partially_cancelled',
                returned: 'returned',
                partially_returned: 'partially_returned',
                payment_failed: 'payment_failed',
                };
                const orderBadgeClass = badgeCssMap[displayStatus] || displayStatus;

                /* ── Tracker fill calculation ──
                Base 5 steps use the raw DB orderStatus.
                Cancel/return extras are appended after. */
                const baseSteps = ['pending', 'processing', 'shipped', 'out_for_delivery', 'delivered'];
                let currentStep = baseSteps.indexOf(os);
                if (currentStep < 0) currentStep=0; /* Fill covers the base pipeline up to the current DB step. If all
                  items are cancelled we show 0% on the base line (the extra cancelled dot is red, so the gold line
                  stays at 0). */ let fillPct=0; if (!allCancelled) { fillPct=(currentStep / (baseSteps.length - 1)) *
                  100; } /* ── Should we show extra terminal step in tracker? ── */ const
                  showCancelledStep=allCancelled; const showPartiallyCancelledStep=someCancelled; const
                  showReturnedStep=allReturned; const showPartiallyReturnedStep=someReturned; const trackerSteps=[ {
                  key: 'pending' , label: 'Order Placed' ,
                  icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2'
                  }, { key: 'processing' , label: 'Processing' , icon: 'M20 6L9 17l-5-5' }, { key: 'shipped' ,
                  label: 'Shipped' , icon: 'M1 3h15v13H1zM16 8l4 0 3 3 0 5-7 0' }, { key: 'out_for_delivery' ,
                  label: 'Out for Delivery' ,
                  icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0zM12 10m-3 0a3 3 0 106 0 3 3 0 10-6 0' }, {
                  key: 'delivered' , label: 'Delivered' , icon: 'M20 6L9 17l-5-5' } ]; %>

                  <!-- Header Row -->
                  <div class="order-header">
                    <a href="/orders" class="back-btn">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2.5">
                        <polyline points="15 18 9 12 15 6" />
                      </svg>
                    </a>
                    <h3>Order #<%= order.orderId %>
                    </h3>

                    <div class="flex items-center gap-3 ml-auto">
                      <button class="btn-gold" id="downloadInvoiceBtn" onclick="downloadInvoice()">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2.5" class="inline mr-1">
                          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" />
                          <polyline points="7 10 12 15 17 10" />
                          <line x1="12" y1="15" x2="12" y2="3" />
                        </svg>
                        Download Invoice
                      </button>

                      <% if (['pending', 'processing' ].includes(os) && !allCancelled) { %>
                        <button class="btn-outline-red" onclick="openFullCancelModal()">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" class="inline mr-1">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="15" y1="9" x2="9" y2="15" />
                            <line x1="9" y1="9" x2="15" y2="15" />
                          </svg>
                          Cancel Order
                        </button>
                        <% } %>
                    </div>
                  </div>

                  <!-- Meta -->
                  <div class="order-meta">
                    <div class="meta-group">
                      <label>Order Date</label>
                      <span>
                        <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric' , month: 'short' ,
                          year: 'numeric' }) %>
                      </span>
                    </div>
                    <div class="meta-group">
                      <label>Total</label>
                      <span>₹<%= order.finalAmount %></span>
                    </div>
                    <div class="meta-group">
                      <label>Payment</label>
                      <span>
                        <%= order.paymentMethod.toUpperCase() %>
                      </span>
                    </div>
                    <div class="meta-address">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                        <circle cx="12" cy="10" r="3" />
                      </svg>
                      <span>
                        <%= order.shippingAddress.fullName %><br>
                          <%= order.shippingAddress.addressLine %>, <%= order.shippingAddress.city %><br>
                              <%= order.shippingAddress.state %> – <%= order.shippingAddress.pincode %><br>
                                  Phone: <%= order.shippingAddress.phone %>
                      </span>
                    </div>
                    <% if (order.paymentStatus === 'failed') { %>
                      <span class="status-badge payment_failed">Payment Failed</span>
                      <button class="retry-btn-detail" id="retryBtnDetail" onclick='initiateRetryPaymentDetail("<%= order._id %>")'>
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                          <polyline points="23 4 23 10 17 10" />
                          <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
                        </svg>
                        Retry Payment
                      </button>
                    <% } else { %>
                      <span class="status-badge <%= orderBadgeClass %>">
                        <%= orderStatusLabel[displayStatus] || displayStatus %>
                      </span>
                    <% } %>
                  </div>

                  <!-- ORDER TRACKER -->
                  <% /* * Build renderNodes for the tracker. * Each node: { label, icon, state } * state: 'done'
                    | 'pending' | 'cancelled' | 'partial-cancel' | 'returned' | 'partial-return' */ const
                    cancelIcon='M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zM15 9l-6 6M9 9l6 6'
                    ; const returnIcon='M1 4v6h6M3.51 15a9 9 0 102.13-9.36L1 10' ; const trackerStepDefs=[ {
                    key: 'pending' , label: 'Order Placed' ,
                    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2'
                    }, { key: 'processing' , label: 'Processing' , icon: 'M20 6L9 17l-5-5' }, { key: 'shipped' ,
                    label: 'Shipped' , icon: 'M1 3h15v13H1zM16 8l4 0 3 3 0 5-7 0' }, { key: 'out_for_delivery' ,
                    label: 'Out for Delivery' ,
                    icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0zM12 10m-3 0a3 3 0 106 0 3 3 0 10-6 0' }, {
                    key: 'delivered' , label: 'Delivered' , icon: 'M20 6L9 17l-5-5' }, ]; let trackerNodes=[]; if
                    (allCancelled) { // Show completed base steps as gold, then red Cancelled dot at end
                    trackerStepDefs.slice(0, currentStep + 1).forEach(s=> {
                    trackerNodes.push({ label: s.label, icon: s.icon, state: 'done' });
                    });
                    trackerNodes.push({ label: 'Cancelled', icon: cancelIcon, state: 'cancelled' });

                    } else if (someCancelled) {
                    // Gold steps up to currentStep, then red Partially Cancelled dot INLINE,
                    // then remaining base steps as grey/pending
                    trackerStepDefs.forEach((s, i) => {
                    if (i <= currentStep) { trackerNodes.push({ label: s.label, icon: s.icon, state: 'done' }); } if
                      (i===currentStep) { trackerNodes.push({ label: 'Partially<br>Cancelled' , icon: cancelIcon,
                      state: 'partial-cancel' }); } if (i> currentStep) {
                      trackerNodes.push({ label: s.label, icon: s.icon, state: 'pending' });
                      }
                      });

                      } else if (allReturned) {
                      // All 5 gold, then red Returned dot appended
                      trackerStepDefs.forEach(s => trackerNodes.push({ label: s.label, icon: s.icon, state: 'done' }));
                      trackerNodes.push({ label: 'Returned', icon: returnIcon, state: 'returned' });

                      } else if (someReturned) {
                      // All 5 gold, then red Partially Returned dot appended
                      trackerStepDefs.forEach(s => trackerNodes.push({ label: s.label, icon: s.icon, state: 'done' }));
                      trackerNodes.push({ label: 'Partially<br>Returned', icon: returnIcon, state: 'partial-return' });

                      } else {
                      // Normal flow
                      trackerStepDefs.forEach((s, i) => {
                      trackerNodes.push({ label: s.label, icon: s.icon, state: currentStep >= i ? 'done' : 'pending' });
                      });
                      }

                      /*
                      * Fill bar calculation:
                      * Gold segment covers from node 0 to the last 'done' node.
                      * Red segment covers from last 'done' node to the cancel/return node (if any).
                      * For partial-cancel: gold fills up to currentStep node index,
                      * red fills from there to the partial-cancel node index.
                      */
                      const totalNodes = trackerNodes.length;

                      // Index of last gold 'done' node
                      let lastDoneIdx = -1;
                      trackerNodes.forEach((n, i) => { if (n.state === 'done') lastDoneIdx = i; });

                      // Index of red terminal node (cancelled / partial-cancel / returned / partial-return)
                      const redStates = ['cancelled', 'partial-cancel', 'returned', 'partial-return'];
                      const redIdx = trackerNodes.findIndex(n => redStates.includes(n.state));

                      // Gold fill: 0% to lastDoneIdx position
                      const goldFillPct = totalNodes > 1 && lastDoneIdx >= 0
                      ? (lastDoneIdx / (totalNodes - 1)) * 100
                      : 0;

                      // Red fill: from lastDoneIdx to redIdx (only when there's a red terminal node)
                      const redFillStart = totalNodes > 1 && lastDoneIdx >= 0
                      ? (lastDoneIdx / (totalNodes - 1)) * 100
                      : 0;
                      const redFillEnd = totalNodes > 1 && redIdx >= 0
                      ? (redIdx / (totalNodes - 1)) * 100
                      : 0;
                      const hasRedSegment = redIdx >= 0;
                      %>

                      <div class="tracker-wrap">
                        <div class="tracker-line"></div>

                        <%# Gold Progress Fill %>
                          <% if (goldFillPct> 0) { %>
                            <div class="tracker-fill" style="width:<%= goldFillPct %>%;"></div>
                            <% } %>

                              <%# Red Segment Fill (from Last Gold Dot To Cancel/return Dot) %>
                                <% if (hasRedSegment && redFillEnd> redFillStart) { %>
                                  <div class="tracker-fill red-fill"
                                    style="left:calc(32px + <%= redFillStart %>% * (100% - 64px) / 100); width:calc(<%= redFillEnd - redFillStart %>% * (100% - 64px) / 100);">
                                  </div>
                                  <% } %>

                                    <% trackerNodes.forEach(node=> {
                                      const isDone = node.state === 'done';
                                      const isCancelled = node.state === 'cancelled' || node.state === 'partial-cancel';
                                      const isReturned = node.state === 'returned' || node.state === 'partial-return';
                                      const stepClass = isDone ? 'done' : isCancelled ? 'done-red' : isReturned ?
                                      'done-red' : '';
                                      const dotClass = isDone ? 'done' : isCancelled ? 'done-red' : isReturned ?
                                      'done-red' : '';
                                      %>
                                      <div class="tracker-step <%= stepClass %>">
                                        <div class="step-dot <%= dotClass %>">
                                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="<%= node.icon %>" />
                                          </svg>
                                        </div>
                                        <span><%- node.label %></span>
                                      </div>
                                      <% }) %>
                      </div>

                      <!-- ITEMS -->
                      <p class="section-title">Items in this Order</p>

                      <% order.items.forEach(item=> {
                        const safeId = String(item._id);
                        const safeName = (item.productName || '').replace(/"/g, '&quot;');
                        const safeSub = (item.variantName || 'Default Variant').replace(/"/g, '&quot;');
                        const safeImg = (item.productImage || '').replace(/"/g, '&quot;');

                        const rr = item.returnRequest || null;
                        const rrStatus = rr ? rr.status : null;

                        let badgeClass = '';
                        let badgeText = '';
                        let showCancelItemBtn = false;
                        let showReturnItemBtn = false;

                        if (item.itemStatus === 'cancelled') {
                        badgeClass = 'item-cancelled';
                        badgeText = 'Cancelled';

                        } else if (item.itemStatus === 'returned') {
                        badgeClass = 'item-returned';
                        badgeText = 'Returned';

                        } else if (rrStatus === 'pending') {
                        badgeClass = 'item-return-requested';
                        badgeText = 'Return Requested';

                        } else if (rrStatus === 'approved') {
                        badgeClass = 'item-returned';
                        badgeText = 'Returned';

                        } else if (item.itemStatus === 'return_rejected' || rrStatus === 'rejected') {
                        badgeClass = 'item-return-rejected';
                        badgeText = 'Return Rejected';

                        } else {
                        /* Active item — show contextual status label & buttons */
                        if (os === 'delivered') {
                          badgeClass = 'item-active-delivered';
                          badgeText = 'Delivered';
                        } else if (os === 'shipped') {
                          badgeClass = 'item-active-progress';
                          badgeText = 'Shipped';
                        } else if (os === 'out_for_delivery') {
                          badgeClass = 'item-active-progress';
                          badgeText = 'Out for Delivery';
                        } else if (os === 'processing') {
                          badgeClass = 'item-active-progress';
                          badgeText = 'Processing';
                        } else {
                          badgeClass = 'item-active-progress';
                          badgeText = 'Order Placed';
                        }

                        /* Cancel button: strictly BEFORE shipment only */
                        if (['pending', 'processing'].includes(os) && !['shipped', 'out_for_delivery', 'delivered', 'cancelled', 'returned'].includes(item.itemStatus)) {
                          showCancelItemBtn = true;
                        }
                        /* Return button: only after delivery */
                        if (os === 'delivered') {
                          showReturnItemBtn = true;
                        }
                        }
                        %>

                        <div class="order-item">
                          <div class="item-img">
                            <% if (item.productImage) { %>
                              <img src="<%= item.productImage %>" alt="<%= safeName %>">
                              <% } else { %>
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#c49a2a"
                                  stroke-width="1.5">
                                  <rect x="2" y="3" width="20" height="14" rx="2" />
                                </svg>
                                <% } %>
                          </div>

                          <div class="item-details">
                            <h4>
                              <%= item.productName %>
                            </h4>
                            <p>
                              <%= item.variantName || 'Default Variant' %>
                            </p>
                            <div class="item-qty">
                              <span>Qty: <%= item.qty %></span>
                              <div class="dot"></div>
                              <strong>₹<%= item.total %></strong>
                            </div>

                            <%# Cancelled-item Info %>
                              <% if (item.itemStatus==='cancelled' && (item.cancelReason || item.cancelledAt)) { %>
                                <div class="item-meta-info cancelled-meta">
                                  <% if (item.cancelReason) { %>
                                    <span class="meta-label">Reason</span>
                                    <span class="meta-value">
                                      <%= item.cancelReason %>
                                    </span><br>
                                    <% } %>
                                      <% if (item.cancelledAt) { %>
                                        <span class="meta-label">Cancelled on</span>
                                        <span class="meta-value">
                                          <%= new Date(item.cancelledAt).toLocaleDateString('en-IN', { day: 'numeric' ,
                                            month: 'short' , year: 'numeric' }) %>
                                        </span>
                                        <% } %>
                                </div>
                                <% } %>

                                  <%# Returned-item Info %>
                                    <% if (item.itemStatus==='returned' && (item.returnReason || item.returnedAt)) { %>
                                      <div class="item-meta-info returned-meta">
                                        <% if (item.returnReason) { %>
                                          <span class="meta-label">Reason</span>
                                          <span class="meta-value">
                                            <%= item.returnReason %>
                                          </span><br>
                                          <% } %>
                                            <% if (item.returnedAt) { %>
                                              <span class="meta-label">Returned on</span>
                                              <span class="meta-value">
                                                <%= new Date(item.returnedAt).toLocaleDateString('en-IN', {
                                                  day: 'numeric' , month: 'short' , year: 'numeric' }) %>
                                              </span>
                                              <% } %>
                                      </div>
                                      <% } %>

                                        <%# Return Request – Pending %>
                                          <% if (rrStatus==='pending' && rr.reason) { %>
                                            <div class="item-meta-info returned-meta"
                                              style="background:#FFF3E6;border-color:#F5C97A;">
                                              <span class="meta-label" style="color:#D4730A;">Reason Filed</span>
                                              <span class="meta-value" style="color:#8B5A10;">
                                                <%= rr.reason %>
                                              </span>
                                              <% if (rr.requestedAt) { %>
                                                <br>
                                                <span class="meta-label" style="color:#D4730A;">Requested on</span>
                                                <span class="meta-value" style="color:#8B5A10;">
                                                  <%= new Date(rr.requestedAt).toLocaleDateString('en-IN', {
                                                    day: 'numeric' , month: 'short' , year: 'numeric' }) %>
                                                </span>
                                                <% } %>
                                            </div>
                                            <% } %>

                                              <%# Return Request – Approved %>
                                                <% if (rrStatus==='approved' ) { %>
                                                  <div class="item-meta-info returned-meta">
                                                    <% if (rr.refundAmount) { %>
                                                      <span class="meta-label">Refund</span>
                                                      <span class="meta-value">₹<%= rr.refundAmount %></span>
                                                      <% } %>
                                                        <% if (rr.processedAt) { %>
                                                          <% if (rr.refundAmount) { %>&nbsp;&bull;&nbsp;<% } %>
                                                              <span class="meta-label">Returned on</span>
                                                              <span class="meta-value">
                                                                <%= new Date(rr.processedAt).toLocaleDateString('en-IN',
                                                                  { day: 'numeric' , month: 'short' , year: 'numeric' })
                                                                  %>
                                                              </span>
                                                              <% } %>
                                                                <% if (rr.adminRemark) { %>
                                                                  <br>
                                                                  <span class="meta-label">Admin Note</span>
                                                                  <span class="meta-value">
                                                                    <%= rr.adminRemark %>
                                                                  </span>
                                                                  <% } %>
                                                  </div>
                                                  <% } %>

                                                    <%# Return Request – Rejected %>
                                                      <% if (rrStatus==='rejected' ) { %>
                                                        <div class="item-meta-info cancelled-meta">
                                                          <% if (rr.reason) { %>
                                                            <span class="meta-label">Your Reason</span>
                                                            <span class="meta-value">
                                                              <%= rr.reason %>
                                                            </span><br>
                                                            <% } %>
                                                              <% if (rr.processedAt) { %>
                                                                <span class="meta-label">Rejected on</span>
                                                                <span class="meta-value">
                                                                  <%= new
                                                                    Date(rr.processedAt).toLocaleDateString('en-IN', {
                                                                    day: 'numeric' , month: 'short' , year: 'numeric' })
                                                                    %>
                                                                </span><br>
                                                                <% } %>
                                                                  <% if (rr.adminRemark) { %>
                                                                    <span class="meta-label">Admin Note</span>
                                                                    <span class="meta-value">
                                                                      <%= rr.adminRemark %>
                                                                    </span>
                                                                    <% } %>
                                                        </div>
                                                        <% } %>
                          </div>

                          <div class="item-actions">
                            <span class="item-status-badge <%= badgeClass %>">
                              <%= badgeText %>
                            </span>

                            <% if (showReturnItemBtn) { %>
                              <button class="btn-outline-gold" data-id="<%= safeId %>" data-name="<%= safeName %>"
                                data-sub="<%= safeSub %>" data-img="<%= safeImg %>" onclick="openReturnModal(this)">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                  stroke-width="2.5">
                                  <polyline points="1 4 1 10 7 10" />
                                  <path d="M3.51 15a9 9 0 102.13-9.36L1 10" />
                                </svg>
                                Return
                              </button>
                              <% } %>

                                <% if (showCancelItemBtn) { %>
                                  <button class="btn-outline-red" data-id="<%= safeId %>" data-name="<%= safeName %>"
                                    data-sub="<%= safeSub %>" data-img="<%= safeImg %>"
                                    onclick="openPartialCancelModal(this)">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                      stroke-width="2.5">
                                      <circle cx="12" cy="12" r="10" />
                                      <line x1="15" y1="9" x2="9" y2="15" />
                                      <line x1="9" y1="9" x2="15" y2="15" />
                                    </svg>
                                    Cancel Item
                                  </button>
                                  <% } %>
                          </div>
                        </div>
                        <% }) %>

                          <!-- Summary -->
                          <div class="order-summary">
                            <% const originalSubtotal=order.items.reduce((sum, item)=> sum + item.total, 0);

                              let refundedAmount = 0;
                              order.items.forEach(item => {
                              const netItemPaid = item.total - (item.couponDiscountLine || 0);
                              if (item.itemStatus === 'returned') {
                              refundedAmount += netItemPaid;
                              } else if (item.itemStatus === 'cancelled') {
                              if (order.paymentMethod !== 'cod' || order.paymentStatus === 'refunded') {
                              refundedAmount += netItemPaid;
                              }
                              }
                              });

                              const allInactive = order.items.every(item => item.itemStatus === 'cancelled' ||
                              item.itemStatus === 'returned');
                              if (allInactive && order.paymentStatus === 'refunded') {
                              refundedAmount = originalSubtotal + (order.deliveryCharge || 0) - (order.discount || 0);
                              }

                              const originalTotal = originalSubtotal + (order.deliveryCharge || 0) - (order.discount ||
                              0);
                              const displayNetTotal = allInactive ? 0 : Math.max(0, originalTotal - refundedAmount);
                              %>
                              <div class="summary-row"><span>Subtotal</span><span>₹<%=
                                    originalSubtotal.toLocaleString('en-IN') %></span></div>
                              <div class="summary-row"><span>Delivery Charge</span><span>₹<%= (order.deliveryCharge ||
                                    0).toLocaleString('en-IN') %></span></div>
                              <div class="summary-row"><span>Discount</span><span>– ₹<%= (order.discount ||
                                    0).toLocaleString('en-IN') %></span></div>
                              <% if (refundedAmount> 0) { %>
                                <div class="summary-row"><span>Original Total</span><span>₹<%=
                                      originalTotal.toLocaleString('en-IN') %></span></div>
                                <div class="summary-row" style="color: #c0392b; font-weight: 500;">
                                  <span>Refunded Amount</span>
                                  <span>– ₹<%= refundedAmount.toLocaleString('en-IN') %></span>
                                </div>
                                <% } %>
                                  <div class="summary-row total"><span>Total</span><span>₹<%=
                                        displayNetTotal.toLocaleString('en-IN') %></span></div>
                          </div>

            </main>
        </div>
    </div>

    <%- include('partials/user/footer') %>

      <!-- RETURN ITEM MODAL -->
      <div class="modal-overlay" id="returnModal" onclick="if(event.target===this) closeReturnModal()">
        <div class="modal">
          <div class="modal-header">
            <div class="modal-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <polyline points="1 4 1 10 7 10" />
                <path d="M3.51 15a9 9 0 102.13-9.36L1 10" />
              </svg>
              Return Item
            </div>
            <button class="modal-close" onclick="closeReturnModal()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </div>

          <div class="modal-item-card">
            <div class="modal-item-img"><img id="returnItemImg" src="" alt=""></div>
            <div class="modal-item-info">
              <h4 id="returnItemName"></h4>
              <p id="returnItemSub"></p>
            </div>
          </div>

          <p class="reasons-label">Select a reason for return:</p>
          <div class="reasons-list" id="returnReasonsList">
            <% ['Item is defective or damaged', 'Wrong item received' , "Item doesn't match description"
              , 'Changed my mind' , 'Item arrived too late' , 'Other' ].forEach(r=> { %>
              <div class="reason-option" onclick="selectReason(this, 'returnSubmitBtn')">
                <div class="radio-circle">
                  <div class="radio-dot"></div>
                </div>
                <%= r %>
              </div>
              <% }) %>
          </div>

          <label class="modal-label">Additional details <span>(optional)</span></label>
          <textarea class="modal-textarea" id="returnDetails" placeholder="Please provide more information…"></textarea>

          <div class="modal-actions">
            <button class="modal-btn-cancel" onclick="closeReturnModal()">Cancel</button>
            <button class="modal-btn-submit" id="returnSubmitBtn" disabled onclick="submitReturn()">Submit
              Return</button>
          </div>
        </div>
      </div>

      <!-- FULL ORDER CANCEL MODAL -->
      <div class="modal-overlay" id="fullCancelModal" onclick="if(event.target===this) closeFullCancelModal()">
        <div class="modal">
          <div class="modal-header">
            <div class="modal-title">Cancel Entire Order</div>
            <button class="modal-close" onclick="closeFullCancelModal()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </div>
          <p style="font-size:0.82rem;color:#aaa;margin-bottom:18px;">This will cancel all items in your order. This
            action cannot be undone.</p>
          <label class="modal-label">Reason <span
              style="font-weight:400;text-transform:none;letter-spacing:0;color:#888;">(optional, max 100 characters)</span></label>
          <textarea class="modal-textarea" id="fullCancelReason" maxlength="100"
            placeholder="Tell us why you're cancelling…"></textarea>
          <div class="modal-actions">
            <button class="modal-btn-cancel" onclick="closeFullCancelModal()">Keep Order</button>
            <button class="modal-btn-danger" onclick="submitFullCancel()">Yes, Cancel Order</button>
          </div>
        </div>
      </div>

      <!-- PARTIAL ITEM CANCEL MODAL -->
      <div class="modal-overlay" id="partialCancelModal" onclick="if(event.target===this) closePartialCancelModal()">
        <div class="modal">
          <div class="modal-header">
            <div class="modal-title">Cancel Item</div>
            <button class="modal-close" onclick="closePartialCancelModal()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </div>
          <div class="modal-item-card">
            <div class="modal-item-img"><img id="partialCancelImg" src="" alt=""></div>
            <div class="modal-item-info">
              <h4 id="partialCancelName"></h4>
              <p id="partialCancelSub"></p>
            </div>
          </div>
          <label class="modal-label">Reason <span
              style="font-weight:400;text-transform:none;letter-spacing:0;color:#888;">(optional, max 100 characters)</span></label>
          <textarea class="modal-textarea" id="partialCancelReason" maxlength="100"
            placeholder="Tell us why you're cancelling this item…"></textarea>
          <div class="modal-actions">
            <button class="modal-btn-cancel" onclick="closePartialCancelModal()">Keep Item</button>
            <button class="modal-btn-danger" onclick="submitPartialCancel()">Cancel Item</button>
          </div>
        </div>
      </div>

      <!-- COUPON BREACH CONFIRMATION MODAL -->
      <div class="modal-overlay" id="couponBreachModal" onclick="if(event.target===this) closeCouponBreachModal()">
        <div class="modal">
          <div class="modal-header">
            <div class="modal-title" style="color: #c0392b; display: flex; align-items: center; gap: 8px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#c0392b" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                <line x1="12" y1="9" x2="12" y2="13" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
              </svg>
              Coupon Requirement Warning
            </div>
            <button class="modal-close" onclick="closeCouponBreachModal()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </div>
          <p id="couponBreachMessage" style="font-size:0.85rem;color:#444;line-height:1.6;margin-bottom:20px;"></p>
          <div class="modal-actions" style="display:flex;gap:12px;">
            <button class="modal-btn-cancel" onclick="closeCouponBreachModal()">Cancel Request (Keep Item)</button>
            <button class="modal-btn-danger" id="confirmBreachCancelBtn"
              onclick="proceedFullCancelAfterBreach()">Proceed with Full Order Cancel</button>
          </div>
        </div>
      </div>

      <script>
        let returnItemId = null;
        let partialCancelItemId = null;

        const ORDER_ID = "<%= order._id %>";

        document.addEventListener('keydown', e => {
          if (e.key === 'Escape') {
            closeReturnModal();
            closeFullCancelModal();
            closePartialCancelModal();
          }
        });

        function selectReason(el, submitBtnId) {
          el.closest('.reasons-list').querySelectorAll('.reason-option').forEach(r => r.classList.remove('selected'));
          el.classList.add('selected');
          if (submitBtnId) document.getElementById(submitBtnId).disabled = false;
        }

        /* Return Modal */
        function openReturnModal(btn) {
          returnItemId = btn.dataset.id;
          document.getElementById('returnItemName').textContent = btn.dataset.name;
          document.getElementById('returnItemSub').textContent = btn.dataset.sub;
          document.getElementById('returnItemImg').src = btn.dataset.img || '';
          document.getElementById('returnDetails').value = '';
          document.getElementById('returnSubmitBtn').disabled = true;
          document.querySelectorAll('#returnReasonsList .reason-option').forEach(r => r.classList.remove('selected'));
          document.getElementById('returnModal').classList.add('active');
          document.body.style.overflow = 'hidden';
        }

        function closeReturnModal() {
          document.getElementById('returnModal').classList.remove('active');
          document.body.style.overflow = '';
        }

        async function submitReturn() {
          const selected = document.querySelector('#returnReasonsList .reason-option.selected');
          if (!selected) return;
          const reason = selected.textContent.trim();
          const details = document.getElementById('returnDetails').value.trim();
          const btn = document.getElementById('returnSubmitBtn');
          btn.disabled = true;
          btn.textContent = 'Submitting…';
          try {
            const res = await fetch('/return-item', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ orderId: ORDER_ID, itemId: returnItemId, reason: reason + (details ? ' - ' + details : '') })
            });
            const data = await res.json();
            if (data.success) {
              closeReturnModal();
              if (typeof window.showToast === 'function') window.showToast('Return request submitted!', 'success');
              setTimeout(() => location.reload(), 1000);
            } else {
              if (typeof window.showToast === 'function') window.showToast(data.message || 'Something went wrong.', 'error');
              btn.disabled = false;
              btn.textContent = 'Submit Return';
            }
          } catch {
            if (typeof window.showToast === 'function') window.showToast('Network error. Please try again.', 'error');
            btn.disabled = false;
            btn.textContent = 'Submit Return';
          }
        }

        /* Full Cancel Modal */
        function openFullCancelModal() {
          document.getElementById('fullCancelReason').value = '';
          document.getElementById('fullCancelModal').classList.add('active');
          document.body.style.overflow = 'hidden';
        }

        function closeFullCancelModal() {
          document.getElementById('fullCancelModal').classList.remove('active');
          document.body.style.overflow = '';
        }

        async function submitFullCancel() {
          const reason = document.getElementById('fullCancelReason').value.trim();
          const btn = document.querySelector('#fullCancelModal .modal-btn-danger');
          btn.disabled = true;
          btn.textContent = 'Cancelling…';
          try {
            const res = await fetch(`/orders/${ORDER_ID}/cancel`, {   // ← fixed URL, ID goes in the path
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ reason })                        // ← orderId no longer needed in body
            });
            const data = await res.json();
            if (data.success) {
              closeFullCancelModal();
              if (typeof window.showToast === 'function') window.showToast('Order cancelled successfully.', 'success');
              setTimeout(() => location.reload(), 1000);
            } else {
              if (typeof window.showToast === 'function') window.showToast(data.message || 'Failed to cancel order.', 'error');
              btn.disabled = false;
              btn.textContent = 'Yes, Cancel Order';
            }
          } catch {
            if (typeof window.showToast === 'function') window.showToast('Network error. Please try again.', 'error');
            btn.disabled = false;
            btn.textContent = 'Yes, Cancel Order';
          }
        }

        /* Partial Item Cancel Modal */
        function openPartialCancelModal(btn) {
          partialCancelItemId = btn.dataset.id;
          document.getElementById('partialCancelName').textContent = btn.dataset.name;
          document.getElementById('partialCancelSub').textContent = btn.dataset.sub;
          document.getElementById('partialCancelImg').src = btn.dataset.img || '';
          document.getElementById('partialCancelReason').value = '';
          document.getElementById('partialCancelModal').classList.add('active');
          document.body.style.overflow = 'hidden';
        }

        function closePartialCancelModal() {
          document.getElementById('partialCancelModal').classList.remove('active');
          document.body.style.overflow = '';
        }

        function closeCouponBreachModal() {
          document.getElementById('couponBreachModal').classList.remove('active');
          document.body.style.overflow = '';
        }

        async function submitPartialCancel(confirmFullCancel = false) {
          const reason = document.getElementById('partialCancelReason').value.trim();
          const btn = confirmFullCancel
            ? document.getElementById('confirmBreachCancelBtn')
            : document.querySelector('#partialCancelModal .modal-btn-danger');

          if (btn) {
            btn.disabled = true;
            btn.textContent = 'Processing…';
          }

          try {
            const res = await fetch('/cancel-item', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                orderId: ORDER_ID,
                itemId: partialCancelItemId,
                reason,
                confirmFullCancel
              })
            });
            const data = await res.json();

            if (data.requiresConfirmation && data.isCouponBreach) {
              closePartialCancelModal();
              document.getElementById('couponBreachMessage').textContent = data.message;
              document.getElementById('couponBreachModal').classList.add('active');
              document.body.style.overflow = 'hidden';
              return;
            }

            if (data.success) {
              closePartialCancelModal();
              closeCouponBreachModal();
              if (typeof window.showToast === 'function') {
                window.showToast(data.message || 'Item cancelled successfully.', 'success');
              }
              setTimeout(() => location.reload(), 1000);
            } else {
              if (typeof window.showToast === 'function') {
                window.showToast(data.message || 'Failed to cancel item.', 'error');
              }
            }
          } catch {
            if (typeof window.showToast === 'function') {
              window.showToast('Network error. Please try again.', 'error');
            }
          } finally {
            if (btn) {
              btn.disabled = false;
              btn.textContent = confirmFullCancel ? 'Proceed with Full Order Cancel' : 'Cancel Item';
            }
          }
        }

        function proceedFullCancelAfterBreach() {
          submitPartialCancel(true);
        }

        /* Download Invoice */
        function downloadInvoice() {
          const btn = document.getElementById('downloadInvoiceBtn');
          btn.disabled = true;
          const originalHTML = btn.innerHTML;
          btn.innerHTML = `Generating…`;

          const opt = {
            margin: [10, 10, 10, 10],
            filename: `Invoice_${ORDER_ID}.pdf`,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2, useCORS: true, logging: false },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
          };

          html2pdf().set(opt).from(document.getElementById('printableInvoice')).save().then(() => {
            btn.disabled = false;
            btn.innerHTML = originalHTML;
          }).catch((err) => {
            btn.disabled = false;
            btn.innerHTML = originalHTML;
            if (typeof window.showToast === 'function') {
              window.showToast('Failed to generate PDF. Please try again.', 'error');
            } else {
              alert('Failed to generate PDF. Please try again.');
            }
          });
        }
      </script>

      <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
      <script>
        // Retry Payment Flow (Order Detail Page)
        async function initiateRetryPaymentDetail(orderId) {
          const btn = document.getElementById('retryBtnDetail');
          if (!btn || btn.disabled) return;

          btn.disabled = true;
          const originalHtml = btn.innerHTML;
          btn.innerHTML = 'Validating…';

          try {
            // Step 1: Validate
            const validateRes = await fetch(`/orders/${orderId}/retry-validate`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'include'
            });
            const validateData = await validateRes.json();

            if (!validateRes.ok || !validateData.success) {
              const msg = validateData.errors
                ? validateData.errors.map(e => e.error).join('\n')
                : (validateData.message || 'Validation failed');
              if (typeof window.showToast === 'function') window.showToast(msg, 'error');
              else alert(msg);
              if (validateData.expired) setTimeout(() => window.location.reload(), 1500);
              btn.disabled = false;
              btn.innerHTML = originalHtml;
              return;
            }

            // Step 2: Create Razorpay order
            btn.innerHTML = 'Processing…';

            const retryRes = await fetch(`/orders/${orderId}/retry-payment`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'include'
            });
            const retryData = await retryRes.json();

            if (!retryRes.ok || !retryData.success) {
              if (typeof window.showToast === 'function') window.showToast(retryData.message || 'Failed to initiate payment', 'error');
              btn.disabled = false;
              btn.innerHTML = originalHtml;
              return;
            }

            // Step 3: Open Razorpay checkout
            const options = {
              key: retryData.key,
              amount: retryData.amount,
              currency: retryData.currency,
              name: "Elanora",
              description: "Retry Payment",
              order_id: retryData.orderId,
              theme: { color: "#c49a2a" },
              handler: async function(rpResponse) {
                try {
                  const verifyRes = await fetch(`/orders/${orderId}/verify-retry`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                      razorpay_order_id: rpResponse.razorpay_order_id,
                      razorpay_payment_id: rpResponse.razorpay_payment_id,
                      razorpay_signature: rpResponse.razorpay_signature
                    })
                  });
                  const verifyData = await verifyRes.json();

                  if (verifyRes.ok && verifyData.success) {
                    if (typeof window.showToast === 'function') window.showToast('Payment successful!', 'success');
                    setTimeout(() => window.location.reload(), 1000);
                  } else {
                    if (typeof window.showToast === 'function') window.showToast(verifyData.message || 'Payment verification failed', 'error');
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                  }
                } catch (verifyErr) {
                  if (typeof window.showToast === 'function') window.showToast('Payment verification error', 'error');
                  btn.disabled = false;
                  btn.innerHTML = originalHtml;
                }
              },
              modal: {
                ondismiss: function() {
                  fetch('/payment-failed', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ internalOrderId: orderId })
                  }).catch(() => {});
                  btn.disabled = false;
                  btn.innerHTML = originalHtml;
                }
              }
            };

            const rzp = new Razorpay(options);

            rzp.on('payment.failed', function(resp) {
              fetch('/payment-failed', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ internalOrderId: orderId })
              }).catch(() => {});
              if (typeof window.showToast === 'function') window.showToast(resp.error?.description || 'Payment failed. You can try again.', 'error');
              btn.disabled = false;
              btn.innerHTML = originalHtml;
            });

            rzp.open();

          } catch (err) {
            if (typeof window.showToast === 'function') window.showToast('Network error. Please try again.', 'error');
            btn.disabled = false;
            btn.innerHTML = originalHtml;
          }
        }
      </script>
      <!-- PREMIUM INVOICE TEMPLATE (OFFSCREEN) -->
