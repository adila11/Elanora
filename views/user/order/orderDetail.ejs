                <th style="text-align: right;">Total</th>
                <th style="text-align: center;">Status</th>
              </tr>
            </thead>
            <tbody>
              <% order.items.forEach(item=> { %>
                <%
                  const rrStatus = item.returnRequest ? item.returnRequest.status : null;
                  let _iStatus = 'delivered';
                  let _iLabel = 'Delivered';

                  if (item.itemStatus === 'cancelled') {
                    _iStatus = 'cancelled';
                    _iLabel = 'Cancelled';
                  } else if (item.itemStatus === 'returned' || rrStatus === 'approved') {
                    _iStatus = 'returned';
                    _iLabel = 'Returned';
                  } else if (item.itemStatus === 'return_requested' || rrStatus === 'pending') {
                    _iStatus = 'return_requested';
                    _iLabel = 'Return Requested';
                  } else if (item.itemStatus === 'return_rejected' || rrStatus === 'rejected') {
                    _iStatus = 'return_rejected';
                    _iLabel = 'Return Rejected';
                  } else if (item.itemStatus && item.itemStatus !== 'active') {
                    _iStatus = item.itemStatus;
                    _iLabel = item.itemStatus.replace(/_/g, ' ');
                  } else if (order.orderStatus) {
                    _iStatus = order.orderStatus;
                    _iLabel = order.orderStatus.replace(/_/g, ' ');
                  }
                %>
                  <tr>
                    <td>
                      <div class="invoice-item-name">
                        <%= item.productName %>
                      </div>
                      <% if (item.variantName) { %>
                        <div class="invoice-item-variant">Color: <%= item.variantName %>
                        </div>
                        <% } %>
                    </td>
                    <td style="text-align: right;">₹<%= item.price.toLocaleString('en-IN') %>
                    </td>
                    <td style="text-align: center;">
                      <%= item.qty %>
                    </td>
                    <td style="text-align: right;">₹<%= item.total.toLocaleString('en-IN') %>
                    </td>
                    <td style="text-align: center;">
                      <span class="invoice-item-status <%= _iStatus %>">
                        <%= _iLabel %>
                      </span>
                    </td>
                  </tr>
                  <% }) %>
            </tbody>
          </table>

          <!-- Summary Section -->
          <div class="invoice-total-section">
            <div class="invoice-notes">
              <h4>Terms &amp; Instructions:</h4>
              <p>This is a computer-generated tax invoice and does not require a physical signature. Returns/exchanges
                are accepted within 7 days in their original packaging and unused condition.</p>
            </div>
            <div>
              <% /* ── Invoice refund calculation ── */ const _inv_subtotal=order.items.reduce((s, it)=> s + it.total,
                0);

                let _inv_refunded = 0;
                order.items.forEach(it => {
                const netItPaid = it.total - (it.couponDiscountLine || 0);
                if (it.itemStatus === 'returned') {
                _inv_refunded += netItPaid;
                } else if (it.itemStatus === 'cancelled') {
                if (order.paymentMethod !== 'cod' || order.paymentStatus === 'refunded') {
                _inv_refunded += netItPaid;
                }
                }
                });

                const _inv_allGone = order.items.every(it => it.itemStatus === 'cancelled' || it.itemStatus ===
                'returned');
                if (_inv_allGone && order.paymentStatus === 'refunded') {
                _inv_refunded = _inv_subtotal + (order.deliveryCharge || 0) - (order.discount || 0);
                }

                const _inv_originalTotal = _inv_subtotal + (order.deliveryCharge || 0) - (order.discount || 0);
                const _inv_netTotal = _inv_allGone ? 0 : Math.max(0, _inv_originalTotal - _inv_refunded);
                %>
                <table class="invoice-summary-table">
                  <tr>
                    <td>Subtotal:</td>
                    <td style="text-align: right;">₹<%= _inv_subtotal.toLocaleString('en-IN') %>
                    </td>
                  </tr>
                  <tr>
                    <td>Shipping:</td>
                    <td style="text-align: right;">₹<%= (order.deliveryCharge || 0).toLocaleString('en-IN') %>
                    </td>
                  </tr>
                  <% if (order.discount && order.discount> 0) { %>
                    <tr>
                      <td>Discount:</td>
                      <td style="text-align: right; color: #2d7a4f;">-₹<%= order.discount.toLocaleString('en-IN') %>
                      </td>
                    </tr>
                    <% } %>
                      <% if (_inv_refunded> 0) { %>
                        <tr>
                          <td>Original Total:</td>
                          <td style="text-align: right;">₹<%= _inv_originalTotal.toLocaleString('en-IN') %>
                          </td>
                        </tr>
                        <tr>
                          <td style="color: #c0392b; font-weight: 600;">Refunded Amount:</td>
                          <td style="text-align: right; color: #c0392b; font-weight: 600;">-₹<%=
                              _inv_refunded.toLocaleString('en-IN') %>
                          </td>
                        </tr>
                        <% } %>
                          <tr class="grand-total">
                            <td>Total Amount:</td>
                            <td style="text-align: right;">₹<%= _inv_netTotal.toLocaleString('en-IN') %>
                            </td>
                          </tr>
                </table>
            </div>
          </div>

          <!-- Footer -->
          <div class="invoice-footer">
            Thank you for shopping with Elanora! We appreciate your business.<br>
            For inquiries, contact support@elanora.com or call +91 98765 43210
          </div>

        </div>
      </div>

</body>

