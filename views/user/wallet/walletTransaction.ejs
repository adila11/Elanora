<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Transaction History - Elanora</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap"
    rel="stylesheet">

  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: #fdfaf5;
      color: #2c2c2c;
    }

    .summary-card {
      background: #fdfaf5;
      border: 1px solid #e8e0d0;
      border-radius: 12px;
      padding: 18px 20px;
    }

    .summary-label {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #999;
      margin-bottom: 8px;
    }

    .summary-value {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.6rem;
      font-weight: 700;
      color: #2c2c2c;
    }

    .tab-link {
      font-size: 0.85rem;
      font-weight: 600;
      color: #999;
      padding-bottom: 12px;
      cursor: pointer;
      border-bottom: 2px solid transparent;
    }

    .tab-link.active {
      color: #c49a2a;
      border-bottom-color: #c49a2a;
    }

    .txn-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 24px;
      border-bottom: 1px solid #f0ece4;
    }

    .txn-row:last-child {
      border-bottom: none;
    }

    .txn-icon {
      width: 38px;
      height: 38px;
      border-radius: 9999px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .txn-icon.credit {
      background: #e4f4e8;
      color: #1f9d4b;
    }

    .txn-icon.debit {
      background: #fbe8e6;
      color: #d0483f;
    }

    .txn-source-badge {
      display: inline-block;
      background: #fdf8ee;
      color: #c49a2a;
      border: 1px solid #f0e2bd;
      padding: 2px 9px;
      border-radius: 20px;
      font-weight: 600;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.85rem;
      font-weight: 500;
      color: #999;
      text-decoration: none;
      margin-bottom: 14px;
      transition: color 0.15s;
    }

    .back-link:hover {
      color: #c49a2a;
    }
  </style>
</head>

<body>

  <%- include('partials/user/header') %>

    <div style="max-width:1200px; margin:0 auto; padding:90px 24px 80px;">

      <%- include('partials/user/profileBanner', { user }) %>

        <div style="display:grid; grid-template-columns:230px 1fr; gap:24px;">

          <%- include('partials/user/profileSidebar', { activePage: 'wallet' }) %>

            <main>
              <a href="/wallet" class="back-link">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
                Back to Wallet
              </a>

              <h3
                style="font-family:'Cormorant Garamond',serif; font-size:1.6rem; font-weight:700; color:#2c2c2c; margin-bottom:20px;">
                Transaction History
              </h3>

              <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:16px; margin-bottom:24px;">
                <div class="summary-card">
                  <div class="summary-label">Total Credits</div>
                  <div class="summary-value" style="color:#1f9d4b;">+₹<%=
                      Number(summary.totalCredits).toLocaleString('en-IN') %>
                  </div>
                </div>
                <div class="summary-card">
                  <div class="summary-label">Total Debits</div>
                  <div class="summary-value">-₹<%= Number(summary.totalDebits).toLocaleString('en-IN') %>
                  </div>
                </div>
                <div class="summary-card" style="background:#fdf8ee; border-color:#e8d9ab;">
                  <div class="summary-label" style="color:#a87820;">Current Balance</div>
                  <div class="summary-value" style="color:#a87820;">₹<%= Number(wallet.balance).toLocaleString('en-IN')
                      %>
                  </div>
                </div>
              </div>

              <% 
                function getSourceLabel(source) { 
                  switch (source) { 
                    case 'wallet_topup': return 'Wallet Top-up';
                    case 'order_payment': return 'Order Payment'; 
                    case 'order_cancel': return 'Order Cancelled';
                    case 'order_return': return 'Order Refund'; 
                    case 'referral': return 'Referral Reward';
                    default: return 'Transaction'; 
                  } 
                } 
                function formatDateTime(date) { 
                  if (!date) return 'N/A'; 
                  const d = new Date(date); 
                  if (isNaN(d.getTime())) return 'N/A'; // fallback if not a valid date 
                  const datePart = d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }); 
                  const timePart = d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }); 
                  return datePart + ', ' + timePart; 
                } 
              %>

                <div
                  style="background:#fff; border-radius:18px; border:1px solid #e8e0d0; box-shadow:0 2px 8px rgba(0,0,0,0.04); overflow:hidden;">
                  <div style="display:flex; gap:28px; padding:0 24px; border-bottom:1px solid #f0ece4;">
                    <div class="tab-link active">All Transactions</div>
                  </div>

                  <div>
                    <% if (transactions.length===0) { %>
                      <div style="padding: 28px; text-align: center; color: #999; font-size: 0.9rem;">
                        No transactions found.
                      </div>
                      <% } else { %>
                        <% transactions.forEach(function(txn) { %>
                          <div class="txn-row">
                            <div style="display:flex; align-items:center; gap:14px;">
                              <div class="txn-icon <%= txn.type === 'credit' ? 'credit' : 'debit' %>">
                                <% if (txn.type==='credit' ) { %>
                                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 7l10 10M7 17V7h10" />
                                  </svg>
                                  <% } else { %>
                                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"
                                      viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 7L7 17M7 7h10v10" />
                                    </svg>
                                    <% } %>
                              </div>
                              <div>
                                <div style="font-size:0.9rem; font-weight:600; color:#2c2c2c;">
                                  <%= txn.description || getSourceLabel(txn.source) %>
                                </div>
                                <div
                                  style="font-size:0.78rem; color:#999; margin-top:4px; display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                                  <span class="txn-source-badge">
                                    <%= getSourceLabel(txn.source) %>
                                  </span>
                                  <span>
                                    <%= formatDateTime(txn.createdAt || txn.date) %> &nbsp;•&nbsp; <%= txn.transactionId
                                        || txn.txnId %>
                                  </span>
                                </div>
                              </div>
                            </div>
                            <div
                              style="font-size:0.95rem; font-weight:700; color:<%= txn.type === 'credit' ? '#1f9d4b' : '#2c2c2c' %>;">
                              <%= txn.type==='credit' ? '+' : '-' %>₹<%= Number(txn.amount).toLocaleString('en-IN') %>
                            </div>
                          </div>
                          <% }); %>
                            <% } %>
                  </div>

                  <!-- Pagination Controls -->
                  <% if (totalPages> 1) { %>
                    <div class="flex items-center justify-between border-t border-gray-200 bg-white px-6 py-4">
                      <div class="flex flex-1 justify-between sm:hidden">
                        <% if (currentPage> 1) { %>
                          <a href="?page=<%= currentPage - 1 %>"
                            class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Previous</a>
                          <% } else { %>
                            <span
                              class="relative inline-flex items-center rounded-md border border-gray-300 bg-gray-100 px-4 py-2 text-sm font-medium text-gray-400 cursor-not-allowed">Previous</span>
                            <% } %>
                              <% if (currentPage < totalPages) { %>
                                <a href="?page=<%= currentPage + 1 %>"
                                  class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Next</a>
                                <% } else { %>
                                  <span
                                    class="relative inline-flex items-center rounded-md border border-gray-300 bg-gray-100 px-4 py-2 text-sm font-medium text-gray-400 cursor-not-allowed">Next</span>
                                  <% } %>
                      </div>
                      <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                        <div>
                          <p class="text-sm text-gray-500">
                            Showing page <span class="font-medium">
                              <%= currentPage %>
                            </span> of <span class="font-medium">
                              <%= totalPages %>
                            </span>
                          </p>
                        </div>
                        <div>
                          <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                            <% if (currentPage> 1) { %>
                              <a href="?page=<%= currentPage - 1 %>"
                                class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                <span class="sr-only">Previous</span>
                                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                  <path fill-rule="evenodd"
                                    d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z"
                                    clip-rule="evenodd" />
                                </svg>
                              </a>
                              <% } %>

                                <% for (let i=1; i <=totalPages; i++) { %>
                                  <% if (i===currentPage) { %>
                                    <span
                                      class="relative z-10 inline-flex items-center bg-[#c49a2a] px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#c49a2a]">
                                      <%= i %>
                                    </span>
                                    <% } else { %>
                                      <a href="?page=<%= i %>"
                                        class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                        <%= i %>
                                      </a>
                                      <% } %>
                                        <% } %>

                                          <% if (currentPage < totalPages) { %>
                                            <a href="?page=<%= currentPage + 1 %>"
                                              class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                              <span class="sr-only">Next</span>
                                              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"
                                                aria-hidden="true">
                                                <path fill-rule="evenodd"
                                                  d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
                                                  clip-rule="evenodd" />
                                              </svg>
                                            </a>
                                            <% } %>
                          </nav>
                        </div>
                      </div>
                    </div>
                    <% } %>
                </div>
            </main>
        </div>
    </div>

    <%- include('partials/user/footer') %>

</body>

</html>