<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Elanora Admin – Edit Product</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Serif+Display&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #f5f4f0;
      --sidebar-bg: #fafaf8;
      --card: #ffffff;
      --border: #e8e6e0;
      --text: #1a1a18;
      --muted: #7a7870;
      --accent: #c8a96e;
      --accent-light: #f5edd8;
      --accent-hover: #b38a4f;
      --red: #c0392b;
      --radius: 12px;
      --radius-sm: 8px;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
    .content { flex: 1; overflow-y: auto; padding: 32px 40px 60px; }

    /* Page Header */
    .page-header { display: flex; align-items: center; gap: 12px; margin-bottom: 28px; }
    .back-btn {
      background: none; border: none; cursor: pointer;
      color: var(--muted); padding: 4px; display: flex;
      align-items: center; border-radius: 6px; transition: background .15s;
    }
    .back-btn:hover { background: var(--border); color: var(--text); }
    .page-title { font-size: 22px; font-weight: 600; }

    /* Cards */
    .card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 28px 32px; margin-bottom: 20px;
    }
    .card-title { font-size: 15px; font-weight: 600; margin-bottom: 20px; color: var(--text); }

    /* Form */
    .form-group { margin-bottom: 20px; }
    label { display: block; font-size: 13px; font-weight: 500; color: var(--text); margin-bottom: 6px; }
    input[type="text"], input[type="number"], textarea, select {
      width: 100%; padding: 10px 14px;
      border: 1px solid var(--border); border-radius: var(--radius-sm);
      font-family: inherit; font-size: 14px; color: var(--text);
      background: var(--bg); outline: none;
      transition: border-color .2s, box-shadow .2s; appearance: none;
    }
    input[type="text"]:focus, input[type="number"]:focus, textarea:focus, select:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(200,169,110,.12);
    }
    textarea { resize: vertical; min-height: 100px; }
    .select-wrap { position: relative; }
    .select-wrap select { padding-right: 36px; }
    .select-wrap .select-arrow {
      position: absolute; right: 12px; top: 50%;
      transform: translateY(-50%); pointer-events: none; color: var(--muted);
    }
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

    /* Variants */
    .variants-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
    .add-variant-btn {
      display: flex; align-items: center; gap: 4px;
      background: none; border: none; cursor: pointer;
      color: var(--accent); font-family: inherit; font-size: 13.5px;
      font-weight: 500; padding: 6px 10px; border-radius: 6px; transition: background .15s;
    }
    .add-variant-btn:hover { background: var(--accent-light); }

    .variant-row { display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 16px; align-items: start; }
    .delete-btn {
      background: none; border: 1px solid var(--border); cursor: pointer;
      padding: 10px; color: var(--muted); border-radius: var(--radius-sm);
      display: flex; align-items: center; transition: background .15s, color .15s;
      height: 42px; width: 42px; justify-content: center; margin-top: 22px;
    }
    .delete-btn:hover { background: #fee2e2; color: #ef4444; border-color: #fca5a5; }
    .variant-divider { border: none; border-top: 1px dashed var(--border); margin: 20px 0; }

    /* Image Upload */
    .img-upload-area { grid-column: 1 / 4; margin-top: 4px; }
    .img-dropzone {
      border: 1.5px dashed var(--border); border-radius: var(--radius-sm);
      padding: 14px 16px; display: flex; flex-direction: column;
      align-items: center; gap: 6px; cursor: pointer;
      transition: border-color .2s, background .2s; background: var(--bg); position: relative;
    }
    .img-dropzone:hover { border-color: var(--accent); background: var(--accent-light); }
    .img-preview-grid { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
    .img-thumb {
      position: relative; width: 68px; height: 68px;
      border-radius: var(--radius-sm); border: 1px solid var(--border);
      overflow: hidden; background: #f3f4f6;
    }
    .img-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .img-thumb-remove {
      position: absolute; top: 3px; right: 3px; width: 18px; height: 18px;
      border-radius: 50%; background: rgba(0,0,0,0.55); border: none; cursor: pointer;
      display: flex; align-items: center; justify-content: center; color: #fff;
    }

    /* Action Bar */
    .action-bar { display: flex; justify-content: flex-end; gap: 12px; margin-top: 8px; }
    .btn { padding: 11px 24px; border-radius: var(--radius-sm); font-family: inherit; font-size: 14px; font-weight: 500; cursor: pointer; transition: all .2s; border: 1px solid transparent; }
    .btn-ghost { background: var(--card); border-color: var(--border); color: var(--text); }
    .btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
    .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }

    /* Cropper Modal */
    .crop-modal {
      position: fixed; inset: 0; background: rgba(0,0,0,0.8);
      display: none; align-items: center; justify-content: center; z-index: 2000;
      padding: 20px;
    }
    .crop-content {
      background: white; border-radius: 12px; width: 100%; max-width: 600px;
      padding: 20px; display: flex; flex-direction: column; gap: 15px;
    }
    .crop-area { min-height: 300px; max-height: 450px; overflow: hidden; background: #eee; border-radius: 8px; }
    .crop-area img { max-width: 100%; display: block; }
    .crop-footer { display: flex; justify-content: flex-end; gap: 10px; }
    /* Validation Styles */
    .error-text { color: var(--red); font-size: 11px; margin-top: 4px; display: none; font-weight: 500; }
    input.invalid, textarea.invalid, select.invalid { border-color: var(--red) !important; background: #fffaf9; }
    input.invalid:focus, textarea.invalid:focus, select.invalid:focus { box-shadow: 0 0 0 3px rgba(192,57,43,.1); }
  </style>
</head>
<body>

  <%- include('../partials/admin/sidebar') %>

  <div class="main">
    <%- include('../partials/admin/header') %>

    <div class="content">

      <div class="page-header">
        <button class="back-btn" onclick="location.href='/admin/products'" aria-label="Go back">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <h1 class="page-title">Edit Product</h1>
      </div>

      <form id="product-form">
        <div class="card">
          <div class="card-title">Product Information</div>
          <div class="form-group">
            <label for="productName">Product Name</label>
            <input type="text" id="productName" name="name" value="<%= product.name %>" />
            <div class="error-text">Product name is required</div>
          </div>
          <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="4"><%= product.description %></textarea>
            <div class="error-text">Description is required</div>
          </div>
          <div class="form-group">
            <label for="category">Category</label>
            <div class="select-wrap">
              <select id="category" name="category">
                <option value="" disabled>Select category</option>
                <% categories.forEach(cat => { %>
                  <% 
                    const currentCatId = product.category?._id ? String(product.category._id) : (product.category ? String(product.category) : '');
                  %>
                  <option value="<%= cat._id %>" <%= currentCatId === String(cat._id) ? 'selected' : '' %>><%= cat.name %></option>
                <% }) %>
              </select>
              <svg class="select-arrow" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </div>
            <div class="error-text">Please select a category</div>
          </div>
        </div>

        <div class="card">
          <div class="card-title">Pricing</div>
          <div class="two-col">
            <div class="form-group">
              <label for="base-price">Base Price (₹)</label>
              <input type="number" id="base-price" name="basePrice" value="<%= product.basePrice %>" step="0.01" />
              <div class="error-text">Valid base price required</div>
            </div>
            <div class="form-group">
              <label for="discount-price">Discount Price (₹)</label>
              <input type="number" id="discount-price" name="discountPrice" value="<%= product.discountPrice %>" step="0.01" />
              <div class="error-text"></div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="variants-header">
            <div class="card-title" style="margin-bottom:0">Variants</div>
            <button type="button" class="add-variant-btn" onclick="addVariant()">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Add Variant
            </button>
          </div>
          <div id="variants-container"></div>
        </div>

        <div class="action-bar">
          <button type="button" class="btn btn-ghost" onclick="location.href='/admin/products'">Cancel</button>
          <button type="submit" id="submit-btn" class="btn btn-primary">Update Product</button>
        </div>
      </form>
    </div>
  </div>

  <!-- CROP MODAL -->
  <div id="cropModal" class="crop-modal">
    <div class="crop-content">
      <div style="display:flex; justify-content:space-between; align-items:center">
        <h3 style="font-size:16px;font-weight:600">Crop Image</h3>
        <span id="cropCount" style="font-size:12px; color:var(--muted)"></span>
      </div>
      <div class="crop-area">
        <img id="cropTarget">
      </div>
      <div class="crop-footer">
        <button type="button" class="btn btn-ghost" onclick="cancelCrop()">Cancel</button>
        <button type="button" class="btn btn-primary" id="cropConfirmBtn" onclick="proceedCrop()">Crop & Save</button>
      </div>
    </div>
  </div>

  <script>
    const product = <%- JSON.stringify(product) %>;
    const variantFiles = {}; 
    const variantExistingImages = {};

    function addVariant(data = null) {
      const id = data ? 'v' + data._id : 'v' + Date.now();
      variantFiles[id] = [];
      variantExistingImages[id] = data ? data.images.map(img => img.url) : [];
      
      const container = document.getElementById('variants-container');
      const variantCount = container.querySelectorAll('.variant-wrapper').length;
      
      const div = document.createElement('div');
      div.className = 'variant-wrapper';
      div.id = 'wrapper-' + id;
      div.innerHTML = `
        ${variantCount > 0 ? '<hr class="variant-divider">' : ''}
        <div class="variant-row">
          <div class="form-group">
            <label>SKU</label>
            <input type="text" class="v-sku" placeholder="SKU001" value="${data ? data.sku : ''}">
            <div class="error-text">SKU required</div>
          </div>
          <div class="form-group">
            <label>Color</label>
            <input type="text" class="v-color" placeholder="e.g. Red" value="${data ? data.color : ''}">
            <div class="error-text">Color required</div>
          </div>
          <div class="form-group">
            <label>Stock</label>
            <input type="number" class="v-stock" placeholder="0" value="${data ? data.stock : ''}">
            <div class="error-text">Valid stock required</div>
          </div>
          <button type="button" class="delete-btn" onclick="removeVariant('${id}')">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
          </button>
          <div class="img-upload-area">
            <label>Variant Images (Exactly 4 Required)</label>
            <div class="img-dropzone" onclick="document.getElementById('file-${id}').click()">
              <input type="file" id="file-${id}" style="display:none" accept="image/*" multiple onchange="handleFiles('${id}', this.files)">
              <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              <div class="img-dropzone-text"><span>Click to upload 4 images</span></div>
            </div>
            <div id="preview-${id}" class="img-preview-grid"></div>
            <div class="error-text">Exactly 4 images required</div>
          </div>
        </div>
      `;
      container.appendChild(div);
      renderPreviews(id);
    }

    function removeVariant(id) {
      document.getElementById('wrapper-' + id).remove();
      delete variantFiles[id];
      delete variantExistingImages[id];
    }

    let cropper = null;
    let currentVariantId = null;
    let imageQueue = [];
    let totalInBatch = 0;

    function handleFiles(id, files) {
      const incoming = Array.from(files);
      const currentTotal = (variantExistingImages[id]?.length || 0) + (variantFiles[id]?.length || 0);
      
      if (currentTotal + incoming.length > 4) {
        Swal.fire('Error', 'Maximum 4 images allowed per variant', 'error');
        return;
      }
      
      // Prevent Submission While Cropping
      document.getElementById('submit-btn').disabled = true;
      document.getElementById('submit-btn').textContent = 'Processing Images...';
      
      currentVariantId = id;
      imageQueue = [...imageQueue, ...incoming];
      totalInBatch = imageQueue.length;
      
      if (!cropper) processNextInQueue();
      
      document.getElementById('file-' + id).value = '';
    }

    function processNextInQueue() {
      if (imageQueue.length === 0) {
        cropper = null;
        document.getElementById('submit-btn').disabled = false;
        document.getElementById('submit-btn').textContent = 'Update Product';
        return;
      }
      
      const currentIdx = totalInBatch - imageQueue.length + 1;
      document.getElementById('cropCount').textContent = `Image ${currentIdx} of ${totalInBatch}`;
      
      const file = imageQueue[0];
      if (!file.type.startsWith('image/')) {
        imageQueue.shift();
        processNextInQueue();
        return;
      }

      const reader = new FileReader();
      reader.onload = e => {
        console.log("File read successfully, showing modal...");
        const modal = document.getElementById('cropModal');
        const img = document.getElementById('cropTarget');
        
        modal.style.display = 'flex';
        
        img.onload = () => {
          console.log("Image loaded in modal, initializing Cropper...");
          if (cropper) cropper.destroy();
          cropper = new Cropper(img, {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1,
            responsive: true,
            restore: false,
          });
        };
        
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function cancelCrop() {
      console.log("Crop cancelled.");
      document.getElementById('cropModal').style.display = 'none';
      if (cropper) {
        cropper.destroy();
        cropper = null;
      }
      imageQueue.shift();
      processNextInQueue();
    }

    function proceedCrop() {
      if (!cropper) {
        console.warn("No cropper instance found!");
        return;
      }

      console.log("Generating cropped canvas...");
      const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });
      if (!canvas) {
        console.error("Canvas generation failed!");
        Swal.fire('Error', 'Could not crop image. Please try again.', 'error');
        return;
      }
      canvas.toBlob(blob => {
        console.log("Blob created, saving file...");
        const id = currentVariantId;
        const file = new File([blob], `cropped-${Date.now()}.jpg`, { type: 'image/jpeg' });
        
        variantFiles[id].push(file);
        renderPreviews(id);
        
        document.getElementById('cropModal').style.display = 'none';
        if (cropper) {
          cropper.destroy();
          cropper = null;
        }
        imageQueue.shift();
        processNextInQueue();
      }, 'image/jpeg', 0.9);
    }

    function renderPreviews(id) {
      const grid = document.getElementById('preview-' + id);
      
      // Clean Up Old Object Urls To Prevent Memory Leaks
      grid.querySelectorAll('img[data-new="true"]').forEach(img => {
        if (img.src.startsWith('blob:')) URL.revokeObjectURL(img.src);
      });
      
      grid.innerHTML = '';

      // Existing Images
      (variantExistingImages[id] || []).forEach((url, idx) => {
        const thumb = document.createElement('div');
        thumb.className = 'img-thumb';
        thumb.innerHTML = `
          <img src="${url}">
          <button type="button" class="img-thumb-remove" onclick="removeExistingImage('${id}', ${idx})">✕</button>
        `;
        grid.appendChild(thumb);
      });

      // New Files
      (variantFiles[id] || []).forEach((file, idx) => {
        const thumb = document.createElement('div');
        thumb.className = 'img-thumb';
        const url = URL.createObjectURL(file);
        thumb.innerHTML = `
          <img src="${url}" data-new="true">
          <button type="button" class="img-thumb-remove" onclick="removeNewImage('${id}', ${idx})">✕</button>
        `;
        grid.appendChild(thumb);
      });
    }

    function removeExistingImage(id, idx) {
      variantExistingImages[id].splice(idx, 1);
      renderPreviews(id);
    }

    function removeNewImage(id, idx) {
      variantFiles[id].splice(idx, 1);
      renderPreviews(id);
    }

    function showError(element, message) {
      if (!element) return;
      element.classList.add('invalid');
      const errorDiv = element.nextElementSibling;
      if (errorDiv && errorDiv.classList.contains('error-text')) {
        if (message) errorDiv.textContent = message;
        errorDiv.style.display = 'block';
      } else if (element.parentElement.classList.contains('img-dropzone')) {
        const dropzone = element.parentElement;
        dropzone.classList.add('invalid');
        const err = dropzone.parentElement.querySelector('.error-text');
        if (err) err.style.display = 'block';
      } else if (element.tagName === 'SELECT') {
        const wrap = element.parentElement;
        wrap.nextElementSibling.style.display = 'block';
      }
    }

    function clearErrors() {
      document.querySelectorAll('.invalid').forEach(el => el.classList.remove('invalid'));
      document.querySelectorAll('.error-text').forEach(el => el.style.display = 'none');
    }

    document.getElementById('product-form').onsubmit = async (e) => {
      e.preventDefault();
      clearErrors();

      const nameInput = document.getElementById('productName');
      const categorySelect = document.getElementById('category');
      const basePriceInput = document.getElementById('base-price');
      const discountPriceInput = document.getElementById('discount-price');
      const descriptionText = document.getElementById('description');

      let hasError = false;

      if (!nameInput.value.trim()) { showError(nameInput, "Product name is required"); hasError = true; }
      if (!descriptionText.value.trim()) { showError(descriptionText, "Description is required"); hasError = true; }
      if (!categorySelect.value) { showError(categorySelect, "Please select a category"); hasError = true; }
      
      const bPrice = parseFloat(basePriceInput.value);
      if (!basePriceInput.value || isNaN(bPrice) || bPrice <= 0) {
        showError(basePriceInput, "Enter a valid base price greater than 0"); hasError = true;
      }

      if (discountPriceInput.value !== "") {
        const dPrice = parseFloat(discountPriceInput.value);
        if (isNaN(dPrice) || dPrice <= 0) {
          showError(discountPriceInput, "Discount price must be greater than 0");
          hasError = true;
        } else if (!isNaN(bPrice) && dPrice > bPrice) {
          showError(discountPriceInput, "Discount price cannot be greater than base price");
          hasError = true;
        }
      }

      const variants = [];
      const wrappers = document.querySelectorAll('.variant-wrapper');
      
      // Collect And Check Duplicate Skus
      const skus = [];
      wrappers.forEach(wrapper => {
        const skuInput = wrapper.querySelector('.v-sku');
        skus.push(skuInput.value.trim().toLowerCase());
      });

      const duplicates = skus.filter((item, index) => skus.indexOf(item) !== index && item !== '');

      wrappers.forEach((wrapper, idx) => {
        const id = wrapper.id.replace('wrapper-', '');
        const skuInput = wrapper.querySelector('.v-sku');
        const colorInput = wrapper.querySelector('.v-color');
        const stockInput = wrapper.querySelector('.v-stock');
        
        if (!skuInput.value.trim()) {
          showError(skuInput, "SKU is required");
          hasError = true;
        } else if (duplicates.includes(skuInput.value.trim().toLowerCase())) {
          showError(skuInput, "Duplicate SKU in variants");
          hasError = true;
        }

        if (!colorInput.value.trim()) { showError(colorInput, "Color is required"); hasError = true; }
        
        const stockVal = parseFloat(stockInput.value);
        if (stockInput.value === "" || isNaN(stockVal) || stockVal < 0 || !Number.isInteger(stockVal)) {
          showError(stockInput, "Valid non-negative integer stock required");
          hasError = true;
        }
        
        const currentTotal = (variantExistingImages[id]?.length || 0) + (variantFiles[id]?.length || 0);
        if (currentTotal !== 4) {
          const dropzone = wrapper.querySelector('.img-dropzone');
          dropzone.classList.add('invalid');
          const err = dropzone.parentElement.querySelector('.error-text');
          if (err) {
            err.textContent = `Exactly 4 images required (Selected: ${currentTotal})`;
            err.style.display = 'block';
          }
          hasError = true;
        }

        variants.push({ 
          tempId: id, 
          sku: skuInput.value.trim(), 
          color: colorInput.value.trim(), 
          stock: stockInput.value, 
          existingImages: variantExistingImages[id] || [] 
        });
      });

      if (hasError) {
        return;
      }

      const submitBtn = document.getElementById('submit-btn');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Updating...';

      const formData = new FormData();
      formData.append('name', nameInput.value.trim());
      formData.append('description', descriptionText.value.trim());
      formData.append('category', categorySelect.value);
      formData.append('basePrice', basePriceInput.value);
      formData.append('discountPrice', document.getElementById('discount-price').value || basePriceInput.value);

      variants.forEach(v => {
        if (variantFiles[v.tempId]) {
          variantFiles[v.tempId].forEach(file => {
            formData.append(`images-${v.tempId}`, file);
          });
        }
      });

      formData.append('variants', JSON.stringify(variants));

      try {
        const res = await fetch(`/admin/products/edit/${product._id}`, {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        if (data.success) {
          Swal.fire('Success', data.message, 'success').then(() => {
            location.href = '/admin/products';
          });
        } else {
          Swal.fire('Error', data.message, 'error');
        }
      } catch (err) {
        Swal.fire('Error', 'Something went wrong', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Update Product';
      }
    };

    // Initialize With Existing Variants
    if (product.variants && product.variants.length > 0) {
      product.variants.forEach(v => addVariant(v));
    } else {
      addVariant();
    }
  </script>
</body>
</html>
