<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Elanora — Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Serif+Display&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #f5f4f0;
    --sidebar-bg: #fafaf8;
    --card: #ffffff;
    --border: #e8e6e0;
    --text: #1a1a18;
    --muted: #7a7870;
    --accent: #c8a96e;
    --accent-light: #f5edd8;
    --green: #2d7a4f;
    --green-bg: #e8f5ee;
    --red: #c0392b;
    --red-bg: #fcecea;
    --blue: #2563a8;
    --blue-bg: #e8f0fb;
    --purple: #6c3fa0;
    --purple-bg: #f2ecfa;
    --orange: #c05c1a;
    --orange-bg: #fdf0e5;
    --radius: 12px;
    --radius-sm: 8px;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  /* SIDEBAR */
  .sidebar {
    width: 220px;
    min-width: 220px;
    background: var(--sidebar-bg);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    padding: 24px 0;
    height: 100vh;
    overflow-y: auto;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 20px 28px;
    border-bottom: 1px solid var(--border);
  }

  .logo-icon {
    width: 34px;
    height: 34px;
    background: var(--accent-light);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-icon svg { width: 18px; height: 18px; }

  .logo-name {
    font-family: 'DM Serif Display', serif;
    font-size: 17px;
    color: var(--text);
    letter-spacing: 0.3px;
  }

  .nav-section {
    padding: 20px 12px 6px;
  }

  .nav-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0 8px;
    margin-bottom: 6px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: var(--muted);
    font-size: 14px;
    font-weight: 400;
    transition: all 0.15s ease;
    position: relative;
    text-decoration: none;
  }

  .nav-item:hover { background: var(--accent-light); color: var(--text); }

  .nav-item.active {
    background: var(--accent-light);
    color: #8a6830;
    font-weight: 500;
  }

  .nav-item.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 60%;
    background: var(--accent);
    border-radius: 0 3px 3px 0;
  }

  .nav-item svg { width: 16px; height: 16px; flex-shrink: 0; }

  .nav-badge {
    width: 7px;
    height: 7px;
    background: #e74c3c;
    border-radius: 50%;
    margin-left: auto;
  }

  .sidebar-bottom {
    margin-top: auto;
    padding: 16px 12px 0;
    border-top: 1px solid var(--border);
  }

  /* MAIN */
  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* TOPBAR */
  .topbar {
    background: var(--card);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 28px;
    gap: 20px;
  }

  .page-title {
    font-size: 20px;
    font-weight: 600;
    color: var(--text);
    min-width: 120px;
  }

  .search-wrap {
    flex: 1;
    max-width: 380px;
    position: relative;
  }

  .search-wrap svg {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 15px;
    height: 15px;
    color: var(--muted);
  }

  .search-input {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 9px 14px 9px 36px;
    font-family: inherit;
    font-size: 13.5px;
    color: var(--text);
    outline: none;
    transition: border-color 0.2s;
  }

  .search-input::placeholder { color: var(--muted); }
  .search-input:focus { border-color: var(--accent); }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .icon-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--card);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    transition: background 0.15s;
  }

  .icon-btn:hover { background: var(--bg); }
  .icon-btn svg { width: 16px; height: 16px; color: var(--muted); }

  .notif-dot {
    width: 8px;
    height: 8px;
    background: #e74c3c;
    border-radius: 50%;
    position: absolute;
    top: 6px;
    right: 6px;
    border: 2px solid var(--card);
  }

  .user-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px 6px 6px;
    border: 1px solid var(--border);
    border-radius: 40px;
    cursor: pointer;
    background: var(--card);
    transition: background 0.15s;
  }

  .user-pill:hover { background: var(--bg); }

  .avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #d4a843;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 600;
    color: white;
  }

  .user-info { line-height: 1.3; }
  .user-name { font-size: 13px; font-weight: 500; }
  .user-role { font-size: 11px; color: var(--muted); }

  .chevron { width: 14px; height: 14px; color: var(--muted); }

  /* CONTENT */
  .content {
    flex: 1;
    overflow-y: auto;
    padding: 28px;
  }

  .welcome-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .welcome-title {
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .welcome-sub {
    font-size: 13.5px;
    color: var(--muted);
  }

  .date-chip {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 9px 16px;
    font-size: 13px;
    color: var(--muted);
  }

  /* STATS GRID */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .stat-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(0,0,0,0.06);
  }

  .stat-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .stat-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-icon svg { width: 20px; height: 20px; }
  .stat-icon.blue { background: var(--blue-bg); color: var(--blue); }
  .stat-icon.green { background: var(--green-bg); color: var(--green); }
  .stat-icon.purple { background: var(--purple-bg); color: var(--purple); }
  .stat-icon.orange { background: var(--orange-bg); color: var(--orange); }

  .stat-badge {
    font-size: 12px;
    font-weight: 500;
    padding: 3px 8px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .stat-badge.up { color: var(--green); background: var(--green-bg); }
  .stat-badge.down { color: var(--red); background: var(--red-bg); }

  .stat-value {
    font-size: 26px;
    font-weight: 600;
    margin-bottom: 4px;
    letter-spacing: -0.5px;
  }

  .stat-label {
    font-size: 13px;
    color: var(--muted);
  }

  /* BOTTOM GRID */
  .bottom-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 20px;
    margin-bottom: 24px;
  }

  .chart-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .card-title {
    font-size: 15px;
    font-weight: 600;
  }

  .period-tabs {
    display: flex;
    gap: 4px;
    background: var(--bg);
    border-radius: var(--radius-sm);
    padding: 3px;
  }

  .period-tab {
    padding: 5px 11px;
    font-size: 12.5px;
    font-weight: 500;
    border-radius: 6px;
    cursor: pointer;
    color: var(--muted);
    transition: all 0.15s;
    border: none;
    background: none;
    font-family: inherit;
  }

  .period-tab.active {
    background: var(--card);
    color: var(--text);
    box-shadow: 0 1px 4px rgba(0,0,0,0.1);
  }

  .chart-wrap { height: 200px; }

  /* QUICK ACTIONS */
  .actions-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
  }

  .action-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text);
    background: var(--card);
    width: 100%;
    text-align: left;
    transition: all 0.15s;
    margin-bottom: 10px;
  }

  .action-btn:last-child { margin-bottom: 0; }

  .action-btn:hover {
    background: var(--accent-light);
    border-color: var(--accent);
    color: #7a5520;
  }

  .action-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* ORDERS TABLE */
  .orders-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
  }

  .view-all {
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
    cursor: pointer;
    text-decoration: none;
  }

  .view-all:hover { text-decoration: underline; }

  table { width: 100%; border-collapse: collapse; }

  thead th {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    text-align: left;
    padding: 0 0 12px;
    border-bottom: 1px solid var(--border);
    letter-spacing: 0.3px;
  }

  tbody tr {
    border-bottom: 1px solid var(--border);
    transition: background 0.1s;
  }

  tbody tr:last-child { border-bottom: none; }
  tbody tr:hover { background: #faf9f6; }

  tbody td {
    padding: 13px 0;
    font-size: 13.5px;
  }

  .order-id { font-weight: 600; color: var(--text); }

  .status-pill {
    display: inline-block;
    padding: 4px 11px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
  }

  .status-pill.delivered { background: var(--green-bg); color: var(--green); }
  .status-pill.processing { background: var(--blue-bg); color: var(--blue); }
  .status-pill.shipped,
  .status-pill.out_for_delivery { background: var(--purple-bg); color: var(--purple); }
  .status-pill.pending { background: #fef9e7; color: #b7860d; }
  .status-pill.cancelled,
  .status-pill.returned,
  .status-pill.return_rejected { background: var(--red-bg); color: var(--red); }
  .status-pill.return_requested { background: var(--orange-bg); color: var(--orange); }

  .eye-btn {
    width: 30px;
    height: 30px;
    border: 1px solid var(--border);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background: var(--card);
    transition: background 0.15s;
    text-decoration: none;
  }

  .eye-btn:hover { background: var(--bg); }
  .eye-btn svg { width: 14px; height: 14px; color: var(--muted); }

  .empty-row td {
    text-align: center;
    color: var(--muted);
    padding: 24px 0;
  }

  /* scrollbar */
  ::-webkit-scrollbar { width: 5px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 10px; }

  /* TOP SELLING GRID */
  .top-selling-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 24px;
  }
  .top-selling-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    display: flex;
    flex-direction: column;
  }
  .top-selling-list {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .top-selling-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13.5px;
    padding-bottom: 8px;
    border-bottom: 1px solid #f9f8f6;
  }
  .top-selling-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .item-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
  }
  .rank-badge {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    flex-shrink: 0;
  }
  .rank-badge.top1 { background: #fef5e7; color: #b7860d; }
  .rank-badge.top2 { background: #f2ecfa; color: #6c3fa0; }
  .rank-badge.top3 { background: #e8f0fb; color: #2563a8; }
  .item-name {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .item-right {
    text-align: right;
    font-size: 13px;
    color: var(--muted);
    flex-shrink: 0;
  }
  .units-sold {
    font-weight: 600;
    color: var(--text);
  }
</style>
</head>
<body>

    <%- include('partials/admin/sidebar') %>

<!-- MAIN -->
<div class="main">

  <!-- TOPBAR -->
  <%- include('partials/admin/header') %>

  <!-- CONTENT -->
  <div class="content">

    <%
      // formats "out_for_delivery" -> "Out For Delivery"
      function formatStatus(status) {
        if (!status) return "";
        return status.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
      }
    %>

    <!-- WELCOME -->
    <div class="welcome-row">
      <div>
        <div class="welcome-title">Welcome back, Admin</div>
        <div class="welcome-sub">Here's what's happening with your store today.</div>
      </div>
      <div class="date-chip"><%= currentDate %></div>
    </div>

    <!-- STATS -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-top">
          <div class="stat-icon blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 001.95-1.57l1.65-7.43H6"/></svg>
          </div>
          <span class="stat-badge <%= stats.ordersChange >= 0 ? 'up' : 'down' %>">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <% if (stats.ordersChange >= 0) { %><polyline points="18 15 12 9 6 15"/><% } else { %><polyline points="6 9 12 15 18 9"/><% } %>
            </svg>
            <%= stats.ordersChange >= 0 ? '+' : '' %><%= stats.ordersChange %>%
          </span>
        </div>
        <div class="stat-value"><%= stats.totalOrders.toLocaleString('en-IN') %></div>
        <div class="stat-label">Total Orders</div>
      </div>

      <div class="stat-card">
        <div class="stat-top">
          <div class="stat-icon green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          </div>
          <span class="stat-badge <%= stats.revenueChange >= 0 ? 'up' : 'down' %>">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <% if (stats.revenueChange >= 0) { %><polyline points="18 15 12 9 6 15"/><% } else { %><polyline points="6 9 12 15 18 9"/><% } %>
            </svg>
            <%= stats.revenueChange >= 0 ? '+' : '' %><%= stats.revenueChange %>%
          </span>
        </div>
        <div class="stat-value">₹<%= stats.totalRevenue.toLocaleString('en-IN') %></div>
        <div class="stat-label">Total Revenue</div>
      </div>

      <div class="stat-card">
        <div class="stat-top">
          <div class="stat-icon purple">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <span class="stat-badge <%= stats.customersChange >= 0 ? 'up' : 'down' %>">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <% if (stats.customersChange >= 0) { %><polyline points="18 15 12 9 6 15"/><% } else { %><polyline points="6 9 12 15 18 9"/><% } %>
            </svg>
            <%= stats.customersChange >= 0 ? '+' : '' %><%= stats.customersChange %>%
          </span>
        </div>
        <div class="stat-value"><%= stats.totalCustomers.toLocaleString('en-IN') %></div>
        <div class="stat-label">Total Customers</div>
      </div>

      <div class="stat-card">
        <div class="stat-top">
          <div class="stat-icon orange">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
          </div>
          <span class="stat-badge <%= stats.productsChange >= 0 ? 'up' : 'down' %>">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <% if (stats.productsChange >= 0) { %><polyline points="18 15 12 9 6 15"/><% } else { %><polyline points="6 9 12 15 18 9"/><% } %>
            </svg>
            <%= stats.productsChange >= 0 ? '+' : '' %><%= stats.productsChange %>%
          </span>
        </div>
        <div class="stat-value"><%= stats.totalProducts.toLocaleString('en-IN') %></div>
        <div class="stat-label">Total Products</div>
      </div>
    </div>

    <!-- CHART + ACTIONS -->
    <div class="bottom-grid">
      <div class="chart-card">
        <div class="card-header">
          <div class="card-title">Sales Analytics</div>
          <div class="period-tabs">
            <button class="period-tab" data-period="7d">7D</button>
            <button class="period-tab active" data-period="6m">6M</button>
            <button class="period-tab" data-period="1y">1Y</button>
            <button class="period-tab" data-period="all">ALL</button>
          </div>
        </div>
        <div class="chart-wrap">
          <canvas id="salesChart"></canvas>
        </div>
      </div>

      <div class="actions-card">
        <div class="card-header">
          <div class="card-title">Quick Actions</div>
        </div>

        <a href="/admin/products/add" class="action-btn">
          <div class="action-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </div>
          Add New Product
        </a>

        <a href="/admin/coupons/add" class="action-btn">
          <div class="action-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          </div>
          Create Coupon
        </a>

        <a href="/admin/reports" class="action-btn">
          <div class="action-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          </div>
          View Reports
        </a>

        <a href="/admin/returns" class="action-btn">
          <div class="action-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
          </div>
          Process Returns
        </a>

        <a href="/admin/dashboard/ledger" class="action-btn">
          <div class="action-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
          Generate Ledger Book
        </a>
      </div>
    </div>

    <!-- TOP SELLING LISTS -->
    <div class="top-selling-grid">
      <!-- TOP PRODUCTS -->
      <div class="top-selling-card">
        <div class="card-header">
          <div class="card-title">Top 10 Best Selling Products</div>
        </div>
        <div class="top-selling-list">
          <% if (locals.topProducts && topProducts.length > 0) { %>
            <% topProducts.forEach((prod, index) => { %>
              <div class="top-selling-item">
                <div class="item-left">
                  <span class="rank-badge top<%= index + 1 %>"><%= index + 1 %></span>
                  <span class="item-name" title="<%= prod.productName %>"><%= prod.productName %></span>
                </div>
                <div class="item-right">
                  <span class="units-sold"><%= prod.totalQty %></span> units
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div style="text-align:center; color:var(--muted); padding:20px 0;">No sales data available.</div>
          <% } %>
        </div>
      </div>

      <!-- TOP CATEGORIES -->
      <div class="top-selling-card">
        <div class="card-header">
          <div class="card-title">Top 10 Best Selling Categories</div>
        </div>
        <div class="top-selling-list">
          <% if (locals.topCategories && topCategories.length > 0) { %>
            <% topCategories.forEach((cat, index) => { %>
              <div class="top-selling-item">
                <div class="item-left">
                  <span class="rank-badge top<%= index + 1 %>"><%= index + 1 %></span>
                  <span class="item-name" title="<%= cat.categoryName %>"><%= cat.categoryName %></span>
                </div>
                <div class="item-right">
                  <span class="units-sold"><%= cat.totalQty %></span> units
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div style="text-align:center; color:var(--muted); padding:20px 0;">No sales data available.</div>
          <% } %>
        </div>
      </div>

      <!-- TOP VARIANTS -->
      <div class="top-selling-card">
        <div class="card-header">
          <div class="card-title">Top 5 Selling Variants</div>
        </div>
        <div class="top-selling-list">
          <% if (locals.topVariants && topVariants.length > 0) { %>
            <% topVariants.forEach((v, index) => { %>
              <div class="top-selling-item">
                <div class="item-left">
                  <span class="rank-badge top<%= index + 1 %>"><%= index + 1 %></span>
                  <div class="item-name-wrap" style="display:flex; flex-direction:column; line-height:1.2; overflow:hidden;">
                    <span class="item-name" style="font-weight:500;" title="<%= v.productName %>"><%= v.productName %></span>
                    <span class="item-variant-label" style="font-size:11px; color:var(--muted);"><%= v.variantName || 'Default Variant' %></span>
                  </div>
                </div>
                <div class="item-right">
                  <span class="units-sold"><%= v.totalQty %></span> units
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div style="text-align:center; color:var(--muted); padding:20px 0;">No sales data available.</div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ORDERS TABLE -->
    <div class="orders-card">
      <div class="card-header">
        <div class="card-title">Recent Orders</div>
        <a class="view-all" href="/admin/orders">View All</a>
      </div>

      <table>
        <thead>
          <tr>
            <th>Order ID</th>
            <th>Customer</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Date</th>
            <th style="text-align:right">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentOrders && recentOrders.length > 0) { %>
            <% recentOrders.forEach(order => { %>
              <tr>
                <td class="order-id">#<%= order.orderId %></td>
                <td><%= order.userId?.fullName || 'Guest' %></td>
                <td>₹<%= order.finalAmount.toLocaleString('en-IN') %></td>
                <td><span class="status-pill <%= order.orderStatus %>"><%= formatStatus(order.orderStatus) %></span></td>
                <td style="color:var(--muted)">
                  <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                </td>
                <td style="text-align:right">
                  <a href="/admin/orders/<%= order.orderId %>" class="eye-btn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr class="empty-row">
              <td colspan="6">No orders yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>
</div>

<script>
  const chartLabels = <%- JSON.stringify(chartLabels) %>;
  const chartData = <%- JSON.stringify(chartData) %>;

  const ctx = document.getElementById('salesChart').getContext('2d');
  const salesChartInstance = new Chart(ctx, {
    type: 'line',
    data: {
      labels: chartLabels,
      datasets: [{
        data: chartData,
        fill: true,
        backgroundColor: 'rgba(200, 169, 110, 0.12)',
        borderColor: '#c8a96e',
        borderWidth: 2,
        pointRadius: 0,
        pointHoverRadius: 5,
        pointHoverBackgroundColor: '#c8a96e',
        tension: 0.45
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#fff',
          titleColor: '#1a1a18',
          bodyColor: '#7a7870',
          borderColor: '#e8e6e0',
          borderWidth: 1,
          padding: 10,
          callbacks: {
            label: ctx => '₹' + ctx.parsed.y.toLocaleString()
          }
        }
      },
      scales: {
        x: {
          grid: { display: false },
          border: { display: false },
          ticks: { color: '#7a7870', font: { size: 12, family: 'DM Sans' } }
        },
        y: {
          grid: { color: '#f0ede6', drawBorder: false },
          border: { display: false },
          ticks: {
            color: '#7a7870',
            font: { size: 12, family: 'DM Sans' },
            callback: v => '₹' + (v >= 1000 ? (v / 1000) + 'k' : v)
          }
        }
      }
    }
  });

  // Period tab active state with dynamic fetching
  document.querySelectorAll('.period-tab').forEach(tab => {
    tab.addEventListener('click', async function() {
      document.querySelectorAll('.period-tab').forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      const period = this.getAttribute('data-period');
      
      try {
        const res = await fetch(`/admin/dashboard/chart-data?period=${period}`);
        const result = await res.json();
        if (result.success) {
          salesChartInstance.data.labels = result.labels;
          salesChartInstance.data.datasets[0].data = result.data;
          salesChartInstance.update();
        }
      } catch (err) {
        console.error("Failed to load chart data:", err);
      }
    });
  });
</script>
<%- include('../partials/user/flash') %>
</body>
</html>
