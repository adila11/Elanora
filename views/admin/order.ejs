<script>
  function openModal(name, sub, imgSrc) {
    document.getElementById('modalItemName').textContent = name;
    document.getElementById('modalItemSub').textContent = sub;
    document.getElementById('modalItemImg').src = imgSrc;
    document.getElementById('modalItemImg').alt = name;
    // reset
    document.querySelectorAll('.reason-option').forEach(r => r.classList.remove('selected'));
    document.querySelector('.additional-textarea').value = '';
    document.getElementById('submitBtn').disabled = true;
    document.getElementById('returnModal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('returnModal').classList.remove('active');
    document.body.style.overflow = '';
  }

  function handleOverlayClick(e) {
    if (e.target === document.getElementById('returnModal')) closeModal();
  }

  function selectReason(el) {
    document.querySelectorAll('.reason-option').forEach(r => r.classList.remove('selected'));
    el.classList.add('selected');
    document.getElementById('submitBtn').disabled = false;
  }

  function submitReturn() {
    const selected = document.querySelector('.reason-option.selected');
    if (!selected) return;
    const reason = selected.textContent.trim();
    const details = document.querySelector('.additional-textarea').value;
    alert(`Return request submitted!\n\nReason: ${reason}${details ? '\nDetails: ' + details : ''}`);
    closeModal();
  }

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeModal();
  });
</script>
