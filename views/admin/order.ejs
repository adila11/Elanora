<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Elanora – Order Detail</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #C9973A;
    --gold-light: #E8C97A;
    --gold-pale: #F5EDD8;
    --cream: #FAF6F0;
    --cream-dark: #F0E8DC;
    --text-dark: #1A1410;
    --text-mid: #5C4E3A;
    --text-light: #9A8A76;
    --white: #FFFFFF;
    --border: #E8DDD0;
    --green: #4CAF7D;
    --radius: 14px;
    --shadow: 0 4px 24px rgba(100,70,30,0.08);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Jost', sans-serif;
    background: var(--cream);
    color: var(--text-dark);
    min-height: 100vh;
  }

  /* ─── NAV ─── */
  nav {
    background: var(--white);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 60px;
    height: 64px;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--gold);
    text-decoration: none;
  }

  .logo svg { width: 26px; height: 26px; }

  .nav-links {
    display: flex;
    gap: 36px;
    list-style: none;
  }

  .nav-links a {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--text-mid);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }

  .nav-links a:hover { color: var(--gold); }

  .nav-icons {
    display: flex;
    align-items: center;
    gap: 18px;
    color: var(--text-mid);
  }

  .nav-icons svg { width: 20px; height: 20px; cursor: pointer; }
  .nav-icons .badge {
    position: relative;
  }
  .nav-icons .badge::after {
    content: '2';
    position: absolute;
    top: -6px;
    right: -6px;
    background: var(--gold);
    color: white;
    font-size: 0.6rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ─── MAIN LAYOUT ─── */
  .page-wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 24px 80px;
  }

  /* ─── PROFILE CARD ─── */
  .profile-card {
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 28px 32px;
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 32px;
  }

  .avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    color: white;
    font-weight: 600;
    flex-shrink: 0;
    position: relative;
  }

  .avatar-edit {
    position: absolute;
    bottom: 0; right: 0;
    width: 20px; height: 20px;
    background: white;
    border-radius: 50%;
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
  }

  .avatar-edit svg { width: 10px; height: 10px; color: var(--text-mid); }

  .profile-info h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 2px;
  }

  .profile-info p {
    font-size: 0.82rem;
    color: var(--text-light);
    margin-bottom: 10px;
  }

  .profile-tags {
    display: flex;
    gap: 10px;
  }

  .tag {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 5px 14px;
    font-size: 0.78rem;
    color: var(--text-mid);
  }

  .tag svg { width: 14px; height: 14px; color: var(--gold); }

  /* ─── BODY GRID ─── */
  .body-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
  }

  /* ─── SIDEBAR ─── */
  .sidebar {
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 16px 0;
    height: fit-content;
  }

  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 24px;
    font-size: 0.85rem;
    color: var(--text-mid);
    cursor: pointer;
    transition: all 0.2s;
    border-left: 3px solid transparent;
    text-decoration: none;
  }

  .sidebar-item:hover { background: var(--cream); color: var(--gold); }

  .sidebar-item.active {
    border-left-color: var(--gold);
    background: var(--gold-pale);
    color: var(--gold);
    font-weight: 500;
  }

  .sidebar-item svg { width: 16px; height: 16px; flex-shrink: 0; }

  /* ─── ORDER CARD ─── */
  .order-card {
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 32px;
  }

  .order-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
  }

  .back-btn {
    width: 32px; height: 32px;
    border-radius: 50%;
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    background: none;
  }

  .back-btn:hover { background: var(--cream); }
  .back-btn svg { width: 16px; height: 16px; color: var(--text-mid); }

  .order-header h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 600;
  }

  /* ─── ORDER META ─── */
  .order-meta {
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 20px 24px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr auto;
    gap: 16px;
    align-items: center;
    margin-bottom: 32px;
  }

  .meta-item label {
    display: block;
    font-size: 0.72rem;
    color: var(--text-light);
    letter-spacing: 0.05em;
    margin-bottom: 4px;
    text-transform: uppercase;
  }

  .meta-item span {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-dark);
  }

  .meta-address {
    font-size: 0.82rem;
    color: var(--text-mid);
    line-height: 1.5;
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }

  .meta-address svg { width: 14px; margin-top: 2px; color: var(--gold); flex-shrink: 0; }

  .status-badge {
    background: #EDF7FF;
    color: #2E7FBB;
    border: 1px solid #B8DCFA;
    border-radius: 20px;
    padding: 5px 14px;
    font-size: 0.78rem;
    font-weight: 500;
    white-space: nowrap;
  }

  /* ─── TRACKER ─── */
  .tracker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 36px;
    position: relative;
    padding: 0 12px;
  }

  .tracker-line {
    position: absolute;
    top: 20px;
    left: 32px;
    right: 32px;
    height: 2px;
    background: var(--border);
    z-index: 0;
  }

  .tracker-fill {
    position: absolute;
    top: 20px;
    left: 32px;
    width: 60%;
    height: 2px;
    background: linear-gradient(90deg, var(--gold), var(--gold-light));
    z-index: 1;
  }

  .tracker-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    z-index: 2;
  }

  .step-dot {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--border);
    display: flex; align-items: center; justify-content: center;
    border: 2px solid var(--border);
  }

  .step-dot.done {
    background: var(--gold);
    border-color: var(--gold);
  }

  .step-dot svg { width: 18px; height: 18px; color: white; }

  .tracker-step span {
    font-size: 0.72rem;
    color: var(--text-light);
    text-align: center;
    white-space: nowrap;
    font-weight: 400;
  }

  .tracker-step.done span { color: var(--gold); font-weight: 500; }

  /* ─── ITEMS ─── */
  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 16px;
    color: var(--text-dark);
  }

  .order-items { display: flex; flex-direction: column; gap: 16px; }

  .order-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: box-shadow 0.2s;
  }

  .order-item:hover { box-shadow: 0 2px 12px rgba(100,70,30,0.07); }

  .item-img {
    width: 72px; height: 72px;
    border-radius: 8px;
    object-fit: cover;
    background: var(--cream-dark);
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }

  .item-img img { width: 100%; height: 100%; object-fit: cover; }

  .item-details { flex: 1; }

  .item-details h4 {
    font-weight: 500;
    font-size: 0.92rem;
    margin-bottom: 3px;
  }

  .item-details p {
    font-size: 0.78rem;
    color: var(--text-light);
    margin-bottom: 6px;
  }

  .item-qty {
    font-size: 0.8rem;
    color: var(--text-mid);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .item-qty .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--text-light); }
  .item-qty strong { color: var(--text-dark); font-weight: 500; }

  .item-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .delivered-badge {
    background: #EDFBF3;
    color: var(--green);
    border: 1px solid #B2EDD0;
    border-radius: 20px;
    padding: 5px 14px;
    font-size: 0.78rem;
    font-weight: 500;
  }

  .return-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--gold);
    background: white;
    color: var(--gold);
    border-radius: 20px;
    padding: 6px 16px;
    font-size: 0.78rem;
    font-family: 'Jost', sans-serif;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .return-btn:hover { background: var(--gold); color: white; }
  .return-btn svg { width: 13px; height: 13px; }

  /* ─── SUMMARY ─── */
  .order-summary {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
    font-size: 0.85rem;
    color: var(--text-mid);
  }

  .summary-row.total {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-dark);
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }

  /* ─── FOOTER ─── */
  footer {
    background: var(--cream-dark);
    border-top: 1px solid var(--border);
    padding: 60px 60px 32px;
    margin-top: 80px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.5fr;
    gap: 40px;
    max-width: 1080px;
    margin: 0 auto 40px;
  }

  .footer-brand .logo { margin-bottom: 12px; font-size: 1.3rem; }

  .footer-brand p {
    font-size: 0.82rem;
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .social-icons {
    display: flex;
    gap: 10px;
  }

  .social-icon {
    width: 32px; height: 32px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: white;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .social-icon:hover { border-color: var(--gold); }
  .social-icon svg { width: 14px; height: 14px; color: var(--text-mid); }

  footer h4 {
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 16px;
    color: var(--text-dark);
    letter-spacing: 0.03em;
  }

  footer ul { list-style: none; }
  footer ul li { margin-bottom: 10px; }
  footer ul a {
    font-size: 0.82rem;
    color: var(--text-light);
    text-decoration: none;
    transition: color 0.2s;
  }
  footer ul a:hover { color: var(--gold); }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .newsletter-form input {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 0.82rem;
    font-family: 'Jost', sans-serif;
    background: white;
    color: var(--text-dark);
    outline: none;
  }

  .newsletter-form input:focus { border-color: var(--gold); }

  .subscribe-btn {
    background: var(--gold);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 11px;
    font-family: 'Jost', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
  }

  .subscribe-btn:hover { background: #B8862E; }

  .footer-bottom {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--border);
    padding-top: 20px;
    font-size: 0.75rem;
    color: var(--text-light);
  }

  .footer-bottom a { color: var(--text-light); text-decoration: none; }
  .footer-bottom a:hover { color: var(--gold); }
  .footer-legal { display: flex; gap: 20px; }

  /* ─── MODAL OVERLAY ─── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(20,14,8,0.45);
    backdrop-filter: blur(3px);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s;
  }

  .modal-overlay.active {
    opacity: 1;
    pointer-events: all;
  }

  /* ─── MODAL ─── */
  .modal {
    background: white;
    border-radius: 18px;
    width: 100%;
    max-width: 420px;
    padding: 28px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    transform: translateY(20px) scale(0.97);
    transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
    position: relative;
  }

  .modal-overlay.active .modal {
    transform: translateY(0) scale(1);
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .modal-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
    font-weight: 600;
  }

  .modal-title svg { width: 18px; height: 18px; color: var(--gold); }

  .modal-close {
    width: 30px; height: 30px;
    border-radius: 50%;
    border: none;
    background: var(--cream);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
  }

  .modal-close:hover { background: var(--cream-dark); }
  .modal-close svg { width: 14px; height: 14px; color: var(--text-mid); }

  .modal-item-card {
    background: var(--cream);
    border-radius: 10px;
    padding: 14px;
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
    border: 1px solid var(--border);
  }

  .modal-item-img {
    width: 52px; height: 52px;
    border-radius: 8px;
    background: var(--cream-dark);
    overflow: hidden;
    flex-shrink: 0;
  }

  .modal-item-img img { width: 100%; height: 100%; object-fit: cover; }

  .modal-item-info h4 {
    font-weight: 500;
    font-size: 0.88rem;
    margin-bottom: 3px;
  }

  .modal-item-info p {
    font-size: 0.75rem;
    color: var(--text-light);
  }

  .reasons-label {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-dark);
    margin-bottom: 12px;
  }

  .reasons-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
  }

  .reason-option {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.18s;
    font-size: 0.84rem;
    color: var(--text-mid);
  }

  .reason-option:hover {
    border-color: var(--gold-light);
    background: var(--gold-pale);
  }

  .reason-option.selected {
    border-color: var(--gold);
    background: var(--gold-pale);
    color: var(--text-dark);
  }

  .radio-circle {
    width: 18px; height: 18px;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    transition: border-color 0.18s;
  }

  .reason-option.selected .radio-circle {
    border-color: var(--gold);
    background: var(--gold);
  }

  .radio-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: white;
    display: none;
  }

  .reason-option.selected .radio-dot { display: block; }

  .additional-label {
    font-size: 0.82rem;
    font-weight: 500;
    margin-bottom: 8px;
    color: var(--text-dark);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .additional-label span {
    font-size: 0.75rem;
    color: var(--text-light);
    font-weight: 400;
  }

  .additional-textarea {
    width: 100%;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 0.82rem;
    font-family: 'Jost', sans-serif;
    color: var(--text-dark);
    resize: none;
    height: 80px;
    outline: none;
    transition: border-color 0.18s;
    margin-bottom: 20px;
  }

  .additional-textarea:focus { border-color: var(--gold); }
  .additional-textarea::placeholder { color: var(--text-light); }

  .modal-actions {
    display: flex;
    gap: 12px;
  }

  .cancel-btn {
    flex: 1;
    padding: 12px;
    border: 1.5px solid var(--gold);
    background: white;
    color: var(--gold);
    border-radius: 10px;
    font-family: 'Jost', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .cancel-btn:hover { background: var(--gold-pale); }

  .submit-btn {
    flex: 1;
    padding: 12px;
    border: none;
    background: var(--gold);
    color: white;
    border-radius: 10px;
    font-family: 'Jost', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
  }

  .submit-btn:hover { background: #B8862E; }
  .submit-btn:disabled { background: var(--border); color: var(--text-light); cursor: not-allowed; }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <a class="logo" href="#">
    <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <polygon points="20,2 36,12 36,28 20,38 4,28 4,12" stroke="#C9973A" stroke-width="2" fill="none"/>
      <polygon points="20,8 30,15 30,25 20,32 10,25 10,15" fill="#C9973A" opacity="0.3"/>
    </svg>
    Elanora
  </a>
  <ul class="nav-links">
    <li><a href="#">Home</a></li>
    <li><a href="#">Shop</a></li>
    <li><a href="#">About Us</a></li>
    <li><a href="#">Contact Us</a></li>
  </ul>
  <div class="nav-icons">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 10-16 0"/></svg>
    <div class="badge">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    </div>
    <div class="badge">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
    </div>
  </div>
</nav>

<div class="page-wrap">

  <!-- PROFILE CARD -->
  <div class="profile-card">
    <div class="avatar">
