<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Elanora — Returns</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@300;400;500;600&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --bg: #f5f4f0;
      --sidebar-bg: #fafaf8;
      --card: #ffffff;
      --card-bg: #ffffff;
      --border: #e8e6e0;
      --text: #1a1a18;
      --text-primary: #1a1a18;
      --text-secondary: #7a7870;
      --text-muted: #7a7870;
      --accent: #c8a96e;
      --accent-light: #f5edd8;
      --accent-hover: #b38a4f;
      --radius: 12px;
      --radius-sm: 8px;
      --shadow: 0 2px 16px rgba(26, 23, 20, 0.07);
      --shadow-lg: 0 8px 40px rgba(26, 23, 20, 0.13);

      --green: #2d7a4f;
      --green-bg: #e8f5ee;
      --red: #c0392b;
      --red-bg: #fcecea;
      --yellow: #9a7b2f;
      --yellow-bg: #fdf6e3;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text-primary);
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    .main {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* CONTENT */
    .content {
      padding: 28px 32px;
      flex: 1;
      overflow-y: auto;
    }

    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 22px;
    }

    .page-header h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 26px;
      font-weight: 600;
    }

    /* SEARCH */
    .search-returns {
      position: relative;
      width: 260px;
    }

    .search-returns input {
      width: 100%;
      padding: 7px 14px 7px 34px;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      font-size: 13px;
      font-family: 'DM Sans', sans-serif;
      color: var(--text-primary);
      background: var(--bg);
      outline: none;
      transition: border 0.18s;
    }

    .search-returns input:focus { border-color: var(--accent); }

    .search-returns svg {
      position: absolute;
      left: 10px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
    }

    /* TABLE CARD */
    .table-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .table-wrap { overflow-x: auto; }

    /* TABS */
    .tabs {
      display: flex;
      gap: 0;
      border-bottom: 1px solid var(--border);
      padding: 0 20px;
    }

    .tab {
      padding: 15px 18px 13px;
      font-size: 13.5px;
      color: var(--text-muted);
      cursor: pointer;
      border-bottom: 2px solid transparent;
      transition: color 0.15s, border-color 0.15s;
      margin-bottom: -1px;
      user-select: none;
    }

    .tab:hover { color: var(--accent); }

    .tab.active {
      color: var(--accent);
      border-bottom-color: var(--accent);
      font-weight: 500;
    }

    /* TABLE */
    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 720px;
    }

    thead tr {
      background: var(--bg);
      border-bottom: 2px solid var(--border);
    }

    th {
      padding: 13px 16px;
      text-align: left;
      font-size: 11.5px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.07em;
      white-space: nowrap;
    }

    tbody tr {
      border-bottom: 1px solid var(--border);
      transition: background 0.14s;
    }

    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: var(--accent-light); }

    td {
      padding: 14px 16px;
      font-size: 13.5px;
      vertical-align: middle;
    }

    .order-link {
      color: var(--accent);
      font-weight: 600;
      font-size: 13px;
      display: block;
      margin-bottom: 2px;
    }

    .customer-name { font-size: 12.5px; color: var(--text-muted); }

    .product-name {
      font-weight: 500;
      font-size: 13.5px;
      display: block;
      margin-bottom: 2px;
    }

    .product-reason { font-size: 12px; color: var(--text-muted); }
    .product-reason span { color: var(--text-secondary); margin-right: 4px; }
    .date-cell { color: var(--text-muted); font-size: 13px; }

    /* BADGES */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 4px 10px;
      border-radius: 50px;
      font-size: 12px;
      font-weight: 500;
      white-space: nowrap;
      gap: 5px;
    }

    .badge::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }

    .badge-pending  { background: var(--yellow-bg); color: var(--yellow); }
    .badge-approved { background: var(--green-bg);  color: var(--green);  }
    .badge-rejected { background: var(--red-bg);    color: var(--red);    }

    /* ACTIONS */
    .action-btn {
      background: none;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 6px 12px;
      font-size: 12px;
      font-family: 'DM Sans', sans-serif;
      font-weight: 500;
      color: var(--text-secondary);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all 0.18s;
      white-space: nowrap;
    }

    .action-btn:hover {
      background: var(--accent-light);
      border-color: var(--accent);
      color: var(--accent);
    }

    .action-btn svg { width: 13px; height: 13px; }

    .processed-text {
      font-size: 12.5px;
      color: var(--text-muted);
      font-style: italic;
    }

    /* PAGINATION */
    .pagination-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 20px;
      border-top: 1px solid var(--border);
      background: var(--card-bg);
    }

    .pagination-info {
      font-size: 12.5px;
      color: var(--text-muted);
    }

    .pagination-controls {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .page-btn {
      min-width: 32px;
      height: 32px;
      padding: 0 10px;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      background: none;
      font-size: 13px;
      font-family: 'DM Sans', sans-serif;
      font-weight: 500;
      color: var(--text-secondary);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      transition: all 0.18s;
      text-decoration: none;
    }

    .page-btn:hover:not(:disabled):not(.active) {
      border-color: var(--accent);
      color: var(--accent);
      background: var(--accent-light);
    }

    .page-btn.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
      cursor: default;
    }

    .page-btn:disabled {
      opacity: 0.38;
      cursor: not-allowed;
    }

    .page-btn svg { width: 13px; height: 13px; flex-shrink: 0; }

    .page-dots {
      font-size: 13px;
      color: var(--text-muted);
      padding: 0 4px;
      user-select: none;
    }

    /* MODAL OVERLAY */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(26, 26, 24, 0.6);
      z-index: 200;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(3px);
    }

    .modal-overlay.open { display: flex; }

    /* MODAL */
    .modal {
      background: var(--card-bg);
      border-radius: 16px;
      width: 100%;
      max-width: 440px;
      box-shadow: var(--shadow-lg);
      overflow: hidden;
      animation: slideUp 0.22s ease;
    }

    @keyframes slideUp {
      from { transform: translateY(20px); opacity: 0; }
      to   { transform: translateY(0);    opacity: 1; }
    }

    .modal-header {
      padding: 24px 28px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
    }

    .modal-tag {
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 4px;
    }

    .modal-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 22px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .modal-close {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 1.5px solid var(--border);
      background: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      font-size: 18px;
      line-height: 1;
      flex-shrink: 0;
      transition: all 0.15s;
    }

    .modal-close:hover {
      background: var(--red-bg);
      color: var(--red);
      border-color: var(--red-bg);
    }

    .modal-body {
      padding: 24px 28px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 13px 16px;
      background: var(--bg);
      border-radius: var(--radius-sm);
      border: 1px solid var(--border);
    }

    .detail-label {
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      font-weight: 500;
    }

    .detail-value {
      font-size: 14px;
      font-weight: 500;
      color: var(--text-primary);
      text-align: right;
    }

    .detail-value.reason {
      color: var(--text-muted);
      font-weight: 400;
      font-style: italic;
    }

    .detail-value.price {
      font-family: 'Cormorant Garamond', serif;
      font-size: 18px;
      color: var(--accent);
      font-weight: 600;
    }

    .modal-footer {
      padding: 20px 28px 24px;
      display: flex;
      gap: 12px;
      border-top: 1px solid var(--border);
    }

    .btn-approve, .btn-reject, .btn-cancel {
      flex: 1;
      padding: 11px;
      border-radius: var(--radius-sm);
      border: none;
      font-size: 13.5px;
      font-weight: 500;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      transition: opacity 0.15s, transform 0.1s;
    }

    .btn-approve:hover, .btn-reject:hover, .btn-cancel:hover { opacity: 0.88; }
    .btn-approve:active, .btn-reject:active, .btn-cancel:active { transform: scale(0.97); }

    .btn-approve { background: var(--green); color: white; }
    .btn-reject  { background: var(--red);   color: white; }
    .btn-cancel  {
      background: #f5f4f0;
      color: var(--text-muted);
      border: 1.5px solid var(--border);
      opacity: 1 !important;
    }
    .btn-cancel:hover { background: #ebe9e3; opacity: 1 !important; }

    /* REJECTION MODAL SPECIFICS */
    .warning-banner {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 12px 14px;
      background: #fff8f7;
      border: 1px solid #f5cdc9;
      border-radius: var(--radius-sm);
    }

    .warning-banner svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      color: var(--red);
      margin-top: 1px;
    }

    .warning-banner p { font-size: 13px; color: #7a2020; line-height: 1.55; }

    .field-label {
      font-size: 12px;
      font-weight: 500;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.07em;
      margin-bottom: 7px;
    }

    .field-label span {
      color: #b0ada6;
      font-weight: 400;
      text-transform: none;
      letter-spacing: 0;
    }

    .remark-textarea {
      width: 100%;
      padding: 11px 13px;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      font-size: 13.5px;
      font-family: 'DM Sans', sans-serif;
      color: var(--text);
      background: var(--bg);
      resize: vertical;
      min-height: 92px;
      outline: none;
      transition: border 0.18s;
      line-height: 1.5;
    }

    .remark-textarea:focus { border-color: var(--red); }
    .remark-textarea::placeholder { color: #b0ada6; }

    .char-count {
      font-size: 11.5px;
      color: var(--text-muted);
      text-align: right;
      margin-top: 5px;
    }

    /* TOAST */
    .toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 999;
      padding: 12px 18px;
      border-radius: var(--radius-sm);
      font-size: 13.5px;
      font-family: 'DM Sans', sans-serif;
      font-weight: 500;
      color: #fff;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.18);
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.22s, transform 0.22s;
      pointer-events: none;
    }

    .toast.show { opacity: 1; transform: translateY(0); }
    .toast.error   { background: var(--red);  }
    .toast.success { background: var(--green); }
  </style>
</head>

<body>

  <%- include('partials/admin/sidebar') %>

  <div class="main">

    <%- include('partials/admin/header') %>

    <div class="content">
      <div class="page-header">
        <h2>Returns &amp; Refunds</h2>
        <div class="search-returns">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input type="text" id="searchInp" placeholder="Search returns…" onkeyup="filterSearch(this.value)">
        </div>
      </div>

      <div class="table-card">
        <!-- TABS -->
        <div class="tabs">
          <div class="tab active" onclick="filterTab(this,'all')">All</div>
          <div class="tab"        onclick="filterTab(this,'pending')">Pending</div>
          <div class="tab"        onclick="filterTab(this,'approved')">Approved</div>
          <div class="tab"        onclick="filterTab(this,'rejected')">Rejected</div>
        </div>

        <!-- TABLE -->
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Order &amp; Customer</th>
                <th>Product &amp; Reason</th>
                <th>Date</th>
                <th>Status</th>
                <th style="text-align:right">Action</th>
              </tr>
            </thead>
            <tbody id="table-body">
              <% returns.forEach((r, idx) => { %>
              <tr data-status="<%= r.status %>" data-idx="<%= idx %>" data-return-id="<%= r._id %>" data-price="₹<%= r.price %>">
                <td>
                  <span class="order-link"><%= r.orderId %></span>
                  <span class="customer-name"><%= r.customerName %></span>
                </td>
                <td>
                  <span class="product-name"><%= r.product %></span>
                  <span class="product-reason"><span>Reason:</span><%= r.reason %></span>
                </td>
                <td class="date-cell">
                  <%= new Date(r.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </td>
                <td>
                  <span class="badge badge-<%= r.status %>">
                    <%= r.status.charAt(0).toUpperCase() + r.status.slice(1) %>
                  </span>
                </td>
                <td style="text-align:right">
                  <% if (r.status === 'pending') { %>
                  <button class="action-btn" onclick="openModal(<%= idx %>)">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      <path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                    View
                  </button>
                  <% } else { %>
                  <span class="processed-text">Processed</span>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- PAGINATION -->
        <% if (pagination.totalPages > 1) { %>
        <div class="pagination-bar">
          <span class="pagination-info">
            Showing
            <%= ((pagination.currentPage - 1) * pagination.limit) + 1 %>–<%= Math.min(pagination.currentPage * pagination.limit, pagination.totalCount) %>
            of <%= pagination.totalCount %> returns
          </span>
          <div class="pagination-controls">

            <!-- Prev -->
            <% if (pagination.hasPrev) { %>
            <a href="/admin/returns?page=<%= pagination.prevPage %>&limit=<%= pagination.limit %>" class="page-btn">
              <svg fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <polyline points="15 18 9 12 15 6"/>
              </svg>
            </a>
            <% } else { %>
            <button class="page-btn" disabled>
              <svg fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <polyline points="15 18 9 12 15 6"/>
              </svg>
            </button>
            <% } %>

            <!-- Page Numbers -->
            <%
              const cur   = pagination.currentPage;
              const total = pagination.totalPages;
              let pages   = [];

              if (total <= 7) {
                for (let i = 1; i <= total; i++) pages.push(i);
              } else {
                pages.push(1);
                if (cur > 3) pages.push('…');
                const start = Math.max(2, cur - 1);
                const end   = Math.min(total - 1, cur + 1);
                for (let i = start; i <= end; i++) pages.push(i);
                if (cur < total - 2) pages.push('…');
                pages.push(total);
              }
            %>

            <% pages.forEach(p => { %>
              <% if (p === '…') { %>
                <span class="page-dots">…</span>
              <% } else if (p === cur) { %>
                <button class="page-btn active"><%= p %></button>
              <% } else { %>
                <a href="/admin/returns?page=<%= p %>&limit=<%= pagination.limit %>" class="page-btn"><%= p %></a>
              <% } %>
            <% }) %>

            <!-- Next -->
            <% if (pagination.hasNext) { %>
            <a href="/admin/returns?page=<%= pagination.nextPage %>&limit=<%= pagination.limit %>" class="page-btn">
              <svg fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </a>
            <% } else { %>
            <button class="page-btn" disabled>
              <svg fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </button>
            <% } %>

          </div>
        </div>
        <% } %>
        <!-- END PAGINATION -->

      </div>
    </div>
  </div>

  <!-- REVIEW MODAL -->
  <div class="modal-overlay" id="returnModal" onclick="if(event.target===this) closeModal()">
    <div class="modal">
      <div class="modal-header">
        <div>
          <div class="modal-tag">Return Details</div>
          <div class="modal-title" id="modal-order"></div>
        </div>
        <button class="modal-close" onclick="closeModal()">✕</button>
      </div>
      <div class="modal-body">
        <div class="detail-row">
          <span class="detail-label">Product</span>
          <span class="detail-value" id="modal-product"></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Total Amount</span>
          <span class="detail-value price" id="modal-price"></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Return Reason</span>
          <span class="detail-value reason" id="modal-reason"></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Customer</span>
          <span class="detail-value" id="modal-customer"></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Date Filed</span>
          <span class="detail-value" id="modal-date"></span>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-approve" onclick="handleApprove()">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Approve
        </button>
        <button class="btn-reject" onclick="openRejectModal()">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
          Reject
        </button>
      </div>
    </div>
  </div>

  <!-- REJECTION MODAL -->
  <div class="modal-overlay" id="rejectModal" onclick="if(event.target===this) closeRejectModal()">
    <div class="modal">
      <div class="modal-header">
        <div>
          <div class="modal-tag">Reject Return</div>
          <div class="modal-title" id="reject-modal-order"></div>
        </div>
        <button class="modal-close" onclick="closeRejectModal()">✕</button>
      </div>
      <div class="modal-body">
        <div class="warning-banner">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8"  x2="12"    y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <p>This action cannot be undone. The customer will be notified that their return request has been rejected.</p>
        </div>
        <div>
          <div class="field-label">Reason for rejection <span>(optional)</span></div>
          <textarea
            id="rejectRemark"
            class="remark-textarea"
            maxlength="300"
            placeholder="e.g. Item shows signs of use beyond the return policy period…"
            oninput="document.getElementById('rejectCharCount').textContent = this.value.length + '/300'"
          ></textarea>
          <div class="char-count" id="rejectCharCount">0/300</div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-cancel" onclick="closeRejectModal()">Cancel</button>
        <button class="btn-reject" onclick="submitRejection()">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
          Confirm Reject
        </button>
      </div>
    </div>
  </div>

  <!-- TOAST -->
  <div class="toast" id="toast"></div>

  <script>
    let currentIdx    = null;
    let currentFilter = 'all';

    /* TABS & SEARCH */
    function filterTab(el, filter) {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      el.classList.add('active');
      currentFilter = filter;
      applyVisibility();
    }

    function filterSearch(val) { applyVisibility(val.toLowerCase()); }

    function applyVisibility(search = '') {
      document.querySelectorAll('#table-body tr').forEach(row => {
        const statusMatch = currentFilter === 'all' || row.dataset.status === currentFilter;
        const searchMatch = !search || row.textContent.toLowerCase().includes(search);
        row.style.display = statusMatch && searchMatch ? '' : 'none';
      });
    }

    /* REVIEW MODAL */
    function openModal(idx) {
      currentIdx = idx;
      const row   = getRow(idx);
      const cells = row.querySelectorAll('td');

      const orderId  = cells[0].querySelector('.order-link').textContent.trim();
      const customer = cells[0].querySelector('.customer-name').textContent.trim();
      const product  = cells[1].querySelector('.product-name').textContent.trim();
      const reason   = cells[1].querySelector('.product-reason').textContent.replace('Reason:', '').trim();
      const date     = cells[2].textContent.trim();

      document.getElementById('modal-order').textContent    = orderId + ' — ' + customer;
      document.getElementById('modal-product').textContent  = product;
      document.getElementById('modal-price').textContent    = row.dataset.price || '—';
      document.getElementById('modal-reason').textContent   = reason;
      document.getElementById('modal-customer').textContent = customer;
      document.getElementById('modal-date').textContent     = date;

      document.getElementById('returnModal').classList.add('open');
    }

    function closeModal() {
      document.getElementById('returnModal').classList.remove('open');
      currentIdx = null;
    }

    /* REJECTION MODAL */
    function openRejectModal() {
      const row   = getRow(currentIdx);
      const cells = row.querySelectorAll('td');
      const orderId  = cells[0].querySelector('.order-link').textContent.trim();
      const customer = cells[0].querySelector('.customer-name').textContent.trim();

      document.getElementById('reject-modal-order').textContent = orderId + ' — ' + customer;
      document.getElementById('rejectRemark').value             = '';
      document.getElementById('rejectCharCount').textContent    = '0/300';

      document.getElementById('returnModal').classList.remove('open');
      document.getElementById('rejectModal').classList.add('open');
    }

    function closeRejectModal() {
      document.getElementById('rejectModal').classList.remove('open');
      currentIdx = null;
    }

    async function submitRejection() {
      const row         = getRow(currentIdx);
      const adminRemark = document.getElementById('rejectRemark').value.trim();
      const success     = await sendAction(row.dataset.returnId, 'rejected', adminRemark);
      if (success) { closeRejectModal(); location.reload(); }
    }

    /* APPROVE */
    async function handleApprove() {
      if (currentIdx === null) return;
      const row     = getRow(currentIdx);
      const success = await sendAction(row.dataset.returnId, 'approved', '');
      if (success) { closeModal(); location.reload(); }
    }

    /* API CALL */
    async function sendAction(returnId, action, adminRemark) {
      const url = action === 'approved'
        ? `/admin/returns/${returnId}/approve`
        : `/admin/returns/${returnId}/reject`;
      try {
        const response = await fetch(url, {
          method:  'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ adminRemark })
        });
        const data = await response.json();
        if (data.success) return true;
        showToast(data.message || 'Something went wrong', 'error');
        return false;
      } catch (err) {
        console.error(err);
        showToast('Network error — please try again', 'error');
        return false;
      }
    }

    /* HELPERS */
    function getRow(idx) {
      return [...document.querySelectorAll('#table-body tr')].find(r => +r.dataset.idx === idx);
    }

    function showToast(msg, type = 'error') {
      const toast    = document.getElementById('toast');
      toast.textContent = msg;
      toast.className   = 'toast ' + type;
      requestAnimationFrame(() => toast.classList.add('show'));
      setTimeout(() => toast.classList.remove('show'), 3500);
    }
  </script>
</body>

</html>
