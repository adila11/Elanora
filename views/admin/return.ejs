<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Elanora — Returns</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@300;400;500&display=swap"
    rel="stylesheet">
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --gold: #C9944A;
      --gold-light: #F5ECD9;
      --gold-pale: #FBF6EE;
      --sidebar-bg: #FAFAF9;
      --border: #EEEBE5;
      --text-dark: #1A1714;
      --text-mid: #6B6560;
      --text-light: #A09890;
      --white: #FFFFFF;
      --green: #3A7D5C;
      --green-bg: #EBF5EF;
      --red: #C0392B;
      --red-bg: #FDECEA;
      --yellow: #B8860B;
      --yellow-bg: #FEF9EC;
      --radius: 10px;
      --shadow: 0 4px 24px rgba(60, 40, 10, 0.07);
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: #F7F4EF;
      color: var(--text-dark);
      display: flex;
      min-height: 100vh;
    }

    /* ── SIDEBAR ── */
    .sidebar {
      width: 240px;
      min-height: 100vh;
      background: var(--sidebar-bg);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      padding: 0 0 24px;
      flex-shrink: 0;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 28px 24px 32px;
      font-family: 'Cormorant Garamond', serif;
      font-size: 22px;
      font-weight: 600;
      color: var(--text-dark);
      letter-spacing: 0.02em;
    }

    .logo-icon {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, var(--gold) 0%, #E8B86D 100%);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 16px;
    }

    .nav-label {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-light);
      padding: 0 24px 8px;
      margin-top: 8px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 24px;
      font-size: 13.5px;
      color: var(--text-mid);
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      border-left: 3px solid transparent;
      text-decoration: none;
    }

    .nav-item:hover {
      background: var(--gold-light);
      color: var(--gold);
    }

    .nav-item.active {
      background: var(--gold-light);
      color: var(--gold);
      border-left-color: var(--gold);
      font-weight: 500;
    }

    .nav-item svg {
      opacity: 0.7;
      flex-shrink: 0;
    }

    .nav-item.active svg {
      opacity: 1;
    }

    .sidebar-spacer {
      flex: 1;
    }

    .logout {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 24px;
      color: var(--text-light);
      font-size: 13.5px;
      cursor: pointer;
      transition: color 0.15s;
    }

    .logout:hover {
      color: var(--red);
    }

    /* ── MAIN ── */
    .main {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    /* ── TOPBAR ── */
    .topbar {
      background: var(--white);
      border-bottom: 1px solid var(--border);
      padding: 0 32px;
      height: 64px;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .topbar-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 20px;
      font-weight: 600;
      color: var(--text-dark);
    }

    .topbar-search {
      flex: 1;
      max-width: 340px;
      margin-left: auto;
      position: relative;
    }

    .topbar-search input {
      width: 100%;
      padding: 8px 14px 8px 36px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 13px;
      background: var(--sidebar-bg);
      color: var(--text-mid);
      outline: none;
      font-family: 'DM Sans', sans-serif;
      transition: border 0.2s;
    }

    .topbar-search input:focus {
      border-color: var(--gold);
    }

    .topbar-search svg {
      position: absolute;
      left: 10px;
      top: 50%;
      transform: translateY(-50%);
      opacity: 0.4;
    }

    .topbar-bell {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
      color: var(--text-mid);
      transition: background 0.15s;
    }

    .topbar-bell:hover {
      background: var(--gold-light);
    }

    .bell-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--red);
      position: absolute;
      top: 6px;
      right: 6px;
      border: 1.5px solid white;
    }

    .topbar-user {
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
    }

    .user-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--gold) 0%, #E8B86D 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.02em;
    }

    .user-info {
      line-height: 1.3;
    }

    .user-name {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-dark);
    }

    .user-role {
      font-size: 11px;
      color: var(--text-light);
    }

    /* ── PAGE ── */
    .page {
      padding: 32px;
      flex: 1;
    }

    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
    }

    .page-heading {
      font-family: 'Cormorant Garamond', serif;
      font-size: 26px;
      font-weight: 600;
      color: var(--text-dark);
    }

    .search-returns {
      position: relative;
      width: 260px;
    }

    .search-returns input {
      width: 100%;
      padding: 9px 14px 9px 14px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 13px;
      background: var(--white);
      color: var(--text-mid);
      outline: none;
      font-family: 'DM Sans', sans-serif;
      transition: border 0.2s;
    }

    .search-returns input:focus {
      border-color: var(--gold);
    }

    .search-returns input::placeholder {
      color: var(--text-light);
    }

    /* ── TABLE CARD ── */
    .card {
      background: var(--white);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
      overflow: hidden;
    }

    /* ── TABS ── */
    .tabs {
      display: flex;
      gap: 0;
      border-bottom: 1px solid var(--border);
      padding: 0 24px;
    }

    .tab {
      padding: 16px 18px 14px;
      font-size: 13.5px;
      color: var(--text-mid);
      cursor: pointer;
      border-bottom: 2px solid transparent;
      transition: color 0.15s, border-color 0.15s;
      margin-bottom: -1px;
      user-select: none;
    }

    .tab:hover {
      color: var(--gold);
    }

    .tab.active {
      color: var(--gold);
      border-bottom-color: var(--gold);
      font-weight: 500;
    }

    /* ── TABLE ── */
    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead tr {
      border-bottom: 1px solid var(--border);
    }

    th {
      padding: 12px 20px;
      text-align: left;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-light);
    }

    tbody tr {
      border-bottom: 1px solid var(--border);
      transition: background 0.12s;
    }

    tbody tr:last-child {
      border-bottom: none;
    }

    tbody tr:hover {
      background: var(--gold-pale);
    }

    td {
      padding: 18px 20px;
      font-size: 13.5px;
      color: var(--text-dark);
      vertical-align: middle;
    }

    .order-link {
      color: var(--gold);
      font-weight: 500;
      font-size: 13px;
      display: block;
      margin-bottom: 2px;
    }

    .customer-name {
      font-size: 12.5px;
      color: var(--text-mid);
    }

    .product-name {
      font-weight: 500;
      font-size: 13.5px;
      display: block;
      margin-bottom: 2px;
    }

    .product-reason {
      font-size: 12px;
      color: var(--text-mid);
    }

    .product-reason span {
      color: var(--text-light);
      margin-right: 4px;
    }

    .date-cell {
      color: var(--text-mid);
      font-size: 13px;
    }

    /* ── BADGES ── */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.02em;
    }

    .badge-pending {
      background: var(--yellow-bg);
      color: var(--yellow);
    }

    .badge-approved {
      background: var(--green-bg);
      color: var(--green);
    }

    .badge-rejected {
      background: var(--red-bg);
      color: var(--red);
    }

    /* ── VIEW BUTTON ── */
    .btn-view {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 16px;
      border-radius: 7px;
      border: 1.5px solid var(--gold);
      background: transparent;
      color: var(--gold);
      font-size: 12.5px;
      font-weight: 500;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
      transition: background 0.15s, color 0.15s;
    }

    .btn-view:hover {
      background: var(--gold);
      color: white;
    }

    /* ── MODAL OVERLAY ── */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(26, 23, 20, 0.45);
      backdrop-filter: blur(3px);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.22s;
    }

    .overlay.open {
      opacity: 1;
      pointer-events: all;
    }

    /* ── MODAL ── */
    .modal {
      background: var(--white);
      border-radius: 14px;
      width: 100%;
      max-width: 440px;
      box-shadow: 0 20px 60px rgba(60, 40, 10, 0.18);
      overflow: hidden;
      transform: translateY(18px) scale(0.98);
      transition: transform 0.25s cubic-bezier(.22, .68, 0, 1.2);
    }

    .overlay.open .modal {
      transform: translateY(0) scale(1);
    }

    .modal-header {
      padding: 24px 28px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
    }

    .modal-header-left {}

    .modal-tag {
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-light);
      margin-bottom: 4px;
    }

    .modal-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 22px;
      font-weight: 600;
      color: var(--text-dark);
    }

    .modal-close {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-light);
      transition: background 0.15s, color 0.15s;
      font-size: 18px;
      line-height: 1;
      flex-shrink: 0;
    }

    .modal-close:hover {
      background: var(--red-bg);
      color: var(--red);
      border-color: var(--red-bg);
    }

    .modal-body {
      padding: 24px 28px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 16px;
      background: var(--gold-pale);
      border-radius: 8px;
      border: 1px solid var(--border);
    }

    .detail-label {
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-light);
      font-weight: 500;
    }

    .detail-value {
      font-size: 14px;
      font-weight: 500;
      color: var(--text-dark);
      text-align: right;
    }

    .detail-value.reason {
      color: var(--text-mid);
      font-weight: 400;
      font-style: italic;
    }

    .detail-value.price {
      font-family: 'Cormorant Garamond', serif;
      font-size: 18px;
      color: var(--gold);
      font-weight: 600;
    }

    .modal-footer {
      padding: 20px 28px 24px;
      display: flex;
      gap: 12px;
      border-top: 1px solid var(--border);
    }

    .btn-approve,
    .btn-reject {
      flex: 1;
      padding: 12px;
      border-radius: 8px;
      border: none;
      font-size: 13.5px;
      font-weight: 500;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      transition: opacity 0.15s, transform 0.1s;
    }

    .btn-approve:hover,
    .btn-reject:hover {
      opacity: 0.88;
    }

    .btn-approve:active,
    .btn-reject:active {
      transform: scale(0.97);
    }

    .btn-approve {
      background: var(--green);
      color: white;
    }

    .btn-reject {
      background: var(--red);
      color: white;
    }

    /* processed state in action */
    .processed-text {
      font-size: 12.5px;
      color: var(--text-light);
      font-style: italic;
    }
  </style>
</head>

<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="logo">
      <div class="logo-icon">◆</div>
      Elanora
    </div>

    <div class="nav-label">Main</div>

    <a class="nav-item" href="#">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
        <rect x="3" y="3" width="7" height="7" rx="1" />
        <rect x="14" y="3" width="7" height="7" rx="1" />
        <rect x="3" y="14" width="7" height="7" rx="1" />
        <rect x="14" y="14" width="7" height="7" rx="1" />
      </svg>
      Dashboard
    </a>
    <a class="nav-item" href="#">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
        <circle cx="9" cy="21" r="1" />
        <circle cx="20" cy="21" r="1" />
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
      </svg>
      Orders
    </a>
    <a class="nav-item" href="#">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
        <path
          d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
      </svg>
      Products
    </a>
    <a class="nav-item" href="#">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
      </svg>
      Categories
    </a>

    <div class="nav-label" style="margin-top:16px">Customers</div>
    <a class="nav-item" href="#">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
        <circle cx="12" cy="7" r="4" />
      </svg>
      Customers
    </a>
    <a class="nav-item" href="#">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
        <path
          d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
      </svg>
      Coupons
    </a>

    <div class="nav-label" style="margin-top:16px">Analytics</div>
    <a class="nav-item" href="#">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
        <line x1="18" y1="20" x2="18" y2="10" />
        <line x1="12" y1="20" x2="12" y2="4" />
        <line x1="6" y1="20" x2="6" y2="14" />
      </svg>
      Sales Reports
    </a>
    <a class="nav-item active" href="#">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
        <polyline points="1 4 1 10 7 10" />
        <path d="M3.51 15a9 9 0 1 0 .49-3.51" />
      </svg>
      Returns
    </a>

    <div class="sidebar-spacer"></div>

    <div class="logout">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
        <polyline points="16 17 21 12 16 7" />
        <line x1="21" y1="12" x2="9" y2="12" />
      </svg>
      Logout
    </div>
  </aside>

  <!-- MAIN -->
  <div class="main">
    <!-- TOPBAR -->
    <header class="topbar">
      <span class="topbar-title">Returns</span>
      <div class="topbar-search">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input type="text" placeholder="Search…">
      </div>
      <div class="topbar-bell">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
          <path d="M13.73 21a2 2 0 0 1-3.46 0" />
        </svg>
        <span class="bell-dot"></span>
      </div>
      <div class="topbar-user">
        <div class="user-avatar">EA</div>
        <div class="user-info">
          <div class="user-name">Elanora Admin</div>
          <div class="user-role">Store Manager</div>
        </div>
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </div>
    </header>

    <!-- PAGE -->
    <div class="page">
      <div class="page-header">
        <h1 class="page-heading">Returns &amp; Refunds</h1>
        <div class="search-returns">
          <input type="text" placeholder="Search returns…">
        </div>
      </div>

      <div class="card">
        <!-- TABS -->
        <div class="tabs">
          <div class="tab active" onclick="filterTab(this,'all')">All</div>
          <div class="tab" onclick="filterTab(this,'pending')">Pending</div>
          <div class="tab" onclick="filterTab(this,'approved')">Approved</div>
          <div class="tab" onclick="filterTab(this,'rejected')">Rejected</div>
        </div>

        <!-- TABLE -->
        <table id="returns-table">
          <thead>
            <tr>
              <th>Order &amp; Customer</th>
              <th>Product &amp; Reason</th>
              <th>Date</th>
              <th>Status</th>
              <th style="text-align:right">Action</th>
            </tr>
          </thead>
          <tbody id="table-body">

            <% returns.forEach((r)=> { %>

              <tr data-status="<%= r.status %>">

                <td>
                  <span class="order-link">
                    <%= r.orderId %>
                  </span>

                  <span class="customer-name">
                    <%= r.customer %>
                  </span>
                </td>

                <td>
                  <span class="product-name">
                    <%= r.product %>
                  </span>

                  <span class="product-reason">
                    <span>Reason:</span>
                    <%= r.reason %>
                  </span>
                </td>

                <td class="date-cell">

                  <%= new Date(r.date).toLocaleDateString('en-IN', { day: 'numeric' , month: 'short' , year: 'numeric'
                    }) %>

                </td>

                <td>

                  <span class="badge 
          <%= r.status === 'pending'
              ? 'badge-pending'
              : r.status === 'approved'
              ? 'badge-approved'
              : 'badge-rejected' %>">

                    <%= r.status.charAt(0).toUpperCase() + r.status.slice(1) %>

                  </span>

                </td>

                <td style="text-align:right">

                  <% if(r.status==='pending' ){ %>

                    <button class="btn-view" onclick="openModal(
              '<%= r.orderId %>',
              '<%= r.itemId %>',
              '<%= r.product %>',
              '<%= r.price %>',
              '<%= r.reason %>',
              '<%= r.customer %>',
              '<%= r.date %>'
            )">

                      View

                    </button>

                    <% } else { %>

                      <span class="processed-text">
                        Processed
                      </span>

                      <% } %>

                </td>

              </tr>

              <% }) %>

          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- MODAL OVERLAY -->
  <div class="overlay" id="modal-overlay" onclick="closeOnBackdrop(event)">
    <div class="modal" id="modal">
      <div class="modal-header">
        <div class="modal-header-left">
          <div class="modal-tag">Return Details</div>
          <div class="modal-title" id="modal-order"></div>
        </div>
        <button class="modal-close" onclick="closeModal()">✕</button>
      </div>
      <div class="modal-body">
        <div class="detail-row">
          <span class="detail-label">Product</span>
          <span class="detail-value" id="modal-product"></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Price</span>
          <span class="detail-value price" id="modal-price"></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Return Reason</span>
          <span class="detail-value reason" id="modal-reason"></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Customer</span>
          <span class="detail-value" id="modal-customer"></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Date Filed</span>
          <span class="detail-value" id="modal-date"></span>
        </div>
      </div>
      <div class="modal-footer" id="modal-footer">
        <button class="btn-approve" id="btn-approve" onclick="handleAction('approve')">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          Approve
        </button>
        <button class="btn-reject" id="btn-reject" onclick="handleAction('reject')">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
          Reject
        </button>
      </div>
    </div>
  </div>

  <script>

    let currentIdx = null;
    let currentFilter = 'all';

    function renderTable(filter) {
      const body = document.getElementById('table-body');
      body.innerHTML = '';
      const filtered = returns.filter(r => filter === 'all' || r.status === filter);

      filtered.forEach((r, i) => {
        const realIdx = returns.indexOf(r);
        const badgeClass = { pending: 'badge-pending', approved: 'badge-approved', rejected: 'badge-rejected' }[r.status];
        const badgeLabel = r.status.charAt(0).toUpperCase() + r.status.slice(1);

        const actionCell = r.status === 'pending'
          ? `<button class="btn-view" onclick="openModal(${realIdx})">
             <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
             View
           </button>`
          : `<span class="processed-text">Processed</span>`;

        body.innerHTML += `
        <tr data-status="${r.status}">
          <td>
            <span class="order-link">${r.order}</span>
            <span class="customer-name">${r.customer}</span>
          </td>
          <td>
            <span class="product-name">${r.product}</span>
            <span class="product-reason"><span>Reason:</span>${r.reason}</span>
          </td>
          <td class="date-cell">${r.date}</td>
          <td><span class="badge ${badgeClass}">${badgeLabel}</span></td>
          <td style="text-align:right">${actionCell}</td>
        </tr>`;
      });
    }

    function filterTab(el, filter) {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      el.classList.add('active');
      currentFilter = filter;
      renderTable(filter);
    }

    function openModal(idx) {
      currentIdx = idx;
      const r = returns[idx];
      document.getElementById('modal-order').textContent = r.order + ' — ' + r.customer;
      document.getElementById('modal-product').textContent = r.product;
      document.getElementById('modal-price').textContent = r.price;
      document.getElementById('modal-reason').textContent = r.reason;
      document.getElementById('modal-customer').textContent = r.customer;
      document.getElementById('modal-date').textContent = r.date;
      document.getElementById('modal-overlay').classList.add('open');
    }

    function closeModal() {
      document.getElementById('modal-overlay').classList.remove('open');
      currentIdx = null;
    }

    function closeOnBackdrop(e) {
      if (e.target === document.getElementById('modal-overlay')) closeModal();
    }

    function handleAction(action) {
      if (currentIdx === null) return;
      returns[currentIdx].status = action === 'approve' ? 'approved' : 'rejected';
      closeModal();
      renderTable(currentFilter);
    }

    // Init
    renderTable('all');
  </script>
</body>

</html>