<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sales Reports – Elanora Admin</title>
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Serif+Display&display=swap"
    rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #f5f4f0;
      --sidebar-bg: #fafaf8;
      --card: #ffffff;
      --border: #e8e6e0;
      --text: #1a1a18;
      --muted: #7a7870;
      --accent: #c8a96e;
      --accent-light: #f5edd8;
      --accent-hover: #b38a4f;
      --green: #2d7a4f;
      --green-bg: #e8f5ee;
      --red: #c0392b;
      --red-bg: #fcecea;
      --indigo: #5b52e8;
      --radius: 12px;
      --radius-sm: 8px;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    .main {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .page-content {
      flex: 1;
      overflow-y: auto;
      padding: 28px;
    }

    .reports-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 22px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .section-title {
      font-size: 22px;
      font-weight: 600;
    }

    .range-tabs {
      display: flex;
      align-items: center;
      gap: 4px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 4px;
    }

    .range-tab {
      border: none;
      background: none;
      font-family: inherit;
      font-size: 13px;
      font-weight: 500;
      color: var(--muted);
      padding: 7px 14px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s;
    }

    .range-tab:hover {
      color: var(--text);
    }

    .range-tab.active {
      background: var(--accent-light);
      color: var(--accent-hover);
    }

    .custom-range-bar {
      display: none;
      align-items: center;
      gap: 10px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 8px 12px;
      margin-bottom: 18px;
    }

    .custom-range-bar.visible {
      display: flex;
    }

    .custom-range-bar input[type="date"] {
      font-family: inherit;
      font-size: 13px;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 10px;
      color: var(--text);
    }

    .custom-range-bar button {
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 6px;
      padding: 7px 16px;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      font-family: inherit;
    }

    .custom-range-bar button:hover {
      background: var(--accent-hover);
    }

    /* Download Dropdown */
    .download-wrap {
      position: relative;
    }

    .btn-download {
      display: flex;
      align-items: center;
      gap: 8px;
      background: none;
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 10px 18px;
      font-size: 13.5px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      font-family: inherit;
    }

    .btn-download:hover {
      background: var(--card);
      border-color: var(--accent);
    }

    .download-menu {
      display: none;
      position: absolute;
      right: 0;
      top: calc(100% + 6px);
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      min-width: 160px;
      z-index: 20;
      overflow: hidden;
    }

    .download-menu.open {
      display: block;
    }

    .download-menu a {
      display: block;
      padding: 10px 14px;
      font-size: 13.5px;
      color: var(--text);
      text-decoration: none;
    }

    .download-menu a:hover {
      background: var(--accent-light);
    }

    /* Stat Cards */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-bottom: 22px;
    }

    .stat-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 22px;
    }

    .stat-label {
      font-size: 13.5px;
      color: var(--muted);
      margin-bottom: 12px;
    }

    .stat-value {
      font-size: 26px;
      font-weight: 600;
      letter-spacing: -0.3px;
      margin-bottom: 10px;
    }

    .stat-delta {
      font-size: 12.5px;
      font-weight: 500;
    }

    .stat-delta.up {
      color: var(--green);
    }

    .stat-delta.down {
      color: var(--red);
    }

    /* Chart Cards */
    .charts-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-bottom: 22px;
    }

    .chart-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
    }

    .chart-card-title {
      font-size: 15.5px;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .chart-wrap {
      position: relative;
      height: 280px;
    }

    /* Transactions Table */
    .table-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
    }

    .table-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }

    .table-card-title {
      font-size: 15.5px;
      font-weight: 600;
    }

    .table-scroll {
      overflow-x: auto;
    }

    table.tx-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      white-space: nowrap;
    }

    table.tx-table thead th {
      text-align: left;
      color: var(--muted);
      font-weight: 500;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      padding: 10px 12px;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      background: var(--card);
    }

    table.tx-table tbody td {
      padding: 11px 12px;
      border-bottom: 1px solid var(--border);
      color: var(--text);
    }

    table.tx-table tbody tr:hover {
      background: #fafaf8;
    }

    .badge {
      display: inline-block;
      padding: 3px 9px;
      border-radius: 20px;
      font-size: 11.5px;
      font-weight: 500;
      text-transform: capitalize;
    }

    .badge.delivered,
    .badge.paid,
    .badge.approved {
      background: var(--green-bg);
      color: var(--green);
    }

    .badge.pending,
    .badge.processing,
    .badge.shipped,
    .badge.out_for_delivery {
      background: var(--accent-light);
      color: var(--accent-hover);
    }

    .badge.cancelled,
    .badge.failed,
    .badge.return_rejected {
      background: var(--red-bg);
      color: var(--red);
    }

    .badge.returned,
    .badge.return_requested,
    .badge.refunded {
      background: #eef0fd;
      color: var(--indigo);
    }

    .empty-row td {
      text-align: center;
      color: var(--muted);
      padding: 30px 12px;
    }

    @media (max-width: 1100px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .charts-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 620px) {
      .stats-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <%- include('partials/admin/sidebar') %>

    <div class="main">
      <%- include('partials/admin/header') %>

        <div class="page-content">

          <div class="reports-toolbar">
            <div class="section-title">Sales Reports</div>
            <div style="display:flex; align-items:center; gap:14px;">
              <div class="range-tabs" id="rangeTabs">
                <button class="range-tab" data-range="today">Today</button>
                <button class="range-tab" data-range="7d">7D</button>
                <button class="range-tab" data-range="30d">30D</button>
                <button class="range-tab" data-range="1y">1Y</button>
                <button class="range-tab" data-range="custom">Custom</button>
              </div>
              <div class="download-wrap">
                <button class="btn-download" id="btnDownloadToggle">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 3v12" />
                    <path d="M7 10l5 5 5-5" />
                    <path d="M5 21h14" />
                  </svg>
                  Download
                </button>
                <div class="download-menu" id="downloadMenu">
                  <a href="#" id="downloadExcel">Download Excel</a>
                  <a href="#" id="downloadPdf">Download PDF</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Custom Range Picker (shown When "custom" Tab Is Active) -->
          <div class="custom-range-bar <%= currentRange === 'custom' ? 'visible' : '' %>" id="customRangeBar">
            <label style="font-size:13px; color:var(--muted);">From</label>
            <input type="date" id="customStart" value="<%= startDate %>" />
            <label style="font-size:13px; color:var(--muted);">To</label>
            <input type="date" id="customEnd" value="<%= endDate %>" />
            <button id="applyCustomRange">Apply</button>
            <span id="dateError" style="font-size:12.5px; color:var(--red); display:none; margin-left:4px;"></span>
          </div>

          <!-- Stat Cards -->
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-label">Total Revenue</div>
              <div class="stat-value">₹<%= totalRevenue.toLocaleString('en-IN') %></div>
              <div class="stat-delta <%= revenueDelta >= 0 ? 'up' : 'down' %>">
                <%= revenueDelta >= 0 ? '+' : '' %><%= revenueDelta %>% from last period
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Total Orders</div>
              <div class="stat-value"><%= totalOrders.toLocaleString('en-IN') %></div>
              <div class="stat-delta <%= ordersDelta >= 0 ? 'up' : 'down' %>">
                <%= ordersDelta >= 0 ? '+' : '' %><%= ordersDelta %>% from last period
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Average Order Value</div>
              <div class="stat-value">₹<%= avgOrderValue.toLocaleString('en-IN') %></div>
              <div class="stat-delta <%= aovDelta >= 0 ? 'up' : 'down' %>">
                <%= aovDelta >= 0 ? '+' : '' %><%= aovDelta %>% from last period
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Discount / Coupon Deductions</div>
              <div class="stat-value">₹<%= totalDiscount.toLocaleString('en-IN') %></div>
              <div class="stat-delta <%= discountDelta >= 0 ? 'up' : 'down' %>">
                <%= discountDelta >= 0 ? '+' : '' %><%= discountDelta %>% from last period · ₹<%= couponDiscount.toLocaleString('en-IN') %> via coupons
              </div>
            </div>
          </div>

          <!-- Charts -->
          <div class="charts-grid">
            <div class="chart-card">
              <div class="chart-card-title">Revenue Trend</div>
              <div class="chart-wrap">
                <canvas id="revenueChart"></canvas>
              </div>
            </div>
            <div class="chart-card">
              <div class="chart-card-title">Orders Volume</div>
              <div class="chart-wrap">
                <canvas id="ordersChart"></canvas>
              </div>
            </div>
          </div>

          <!-- Transactions Table -->
          <div class="table-card">
            <div class="table-card-header">
              <div class="table-card-title">Transactions</div>
              <div style="font-size:12.5px; color:var(--muted);"><%= transactions.length %> orders in range</div>
            </div>
            <div class="table-scroll">
              <table class="tx-table">
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Order Total</th>
                    <th>Discount</th>
                    <th>Coupon</th>
                    <th>Delivery</th>
                    <th>Final Amount</th>
                    <th>Payment</th>
                    <th>Payment Status</th>
                    <th>Order Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (transactions.length === 0) { %>
                    <tr class="empty-row">
                      <td colspan="12">No transactions found for this date range.</td>
                    </tr>
                  <% } else { %>
                    <% transactions.forEach(function(tx) { %>
                      <tr>
                        <td><%= tx.orderId %></td>
                        <td><%= new Date(tx.date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                        <td><%= tx.customer %></td>
                        <td><%= tx.itemsCount %></td>
                        <td>₹<%= tx.orderTotal.toLocaleString('en-IN') %></td>
                        <td>₹<%= tx.discount.toLocaleString('en-IN') %></td>
                        <td><%= tx.coupon %></td>
                        <td>₹<%= tx.deliveryCharge.toLocaleString('en-IN') %></td>
                        <td>₹<%= tx.finalAmount.toLocaleString('en-IN') %></td>
                        <td style="text-transform:uppercase; font-size:12px;"><%= tx.paymentMethod %></td>
                        <td><span class="badge <%= tx.paymentStatus %>"><%= tx.paymentStatus %></span></td>
                        <td><span class="badge <%= tx.orderStatus %>"><%= tx.orderStatus.replace(/_/g, ' ') %></span></td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
            
            <!-- Pagination Controls -->
            <% if (totalPages > 1) { %>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--border);">
                <div style="font-size: 13.5px; color: var(--muted);">
                  Showing page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong>
                </div>
                <div style="display: flex; align-items: center; gap: 6px;">
                  <% 
                    const getPageUrl = (p) => {
                      const params = new URLSearchParams();
                      if (currentRange) params.set('range', currentRange);
                      if (startDate) params.set('startDate', startDate);
                      if (endDate) params.set('endDate', endDate);
                      params.set('page', p);
                      return '?' + params.toString();
                    };
                  %>
                  <% if (currentPage > 1) { %>
                    <a href="<%= getPageUrl(currentPage - 1) %>" class="range-tab" style="text-decoration: none; padding: 6px 12px; border: 1px solid var(--border); border-radius: 6px; display: inline-block;">Previous</a>
                  <% } %>
                  
                  <% for (let i = 1; i <= totalPages; i++) { %>
                    <% if (i === currentPage) { %>
                      <span class="range-tab active" style="padding: 6px 12px; border-radius: 6px; border: 1px solid var(--accent); display: inline-block;"><%= i %></span>
                    <% } else { %>
                      <a href="<%= getPageUrl(i) %>" class="range-tab" style="text-decoration: none; padding: 6px 12px; border: 1px solid var(--border); border-radius: 6px; display: inline-block;"><%= i %></a>
                    <% } %>
                  <% } %>

                  <% if (currentPage < totalPages) { %>
                    <a href="<%= getPageUrl(currentPage + 1) %>" class="range-tab" style="text-decoration: none; padding: 6px 12px; border: 1px solid var(--border); border-radius: 6px; display: inline-block;">Next</a>
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>

        </div>
    </div>

    <script>
      const chartLabels = <%- JSON.stringify(chartLabels) %>;
      const revenueSeries = <%- JSON.stringify(revenueSeries) %>;
      const ordersSeries = <%- JSON.stringify(ordersSeries) %>;
      const currentRange = <%- JSON.stringify(currentRange) %>;

      // Revenue Trend (area / Line)
      const revenueCtx = document.getElementById('revenueChart').getContext('2d');
      const revenueGradient = revenueCtx.createLinearGradient(0, 0, 0, 280);
      revenueGradient.addColorStop(0, 'rgba(200, 169, 110, 0.35)');
      revenueGradient.addColorStop(1, 'rgba(200, 169, 110, 0)');

      new Chart(revenueCtx, {
        type: 'line',
        data: {
          labels: chartLabels,
          datasets: [{
            label: 'Revenue',
            data: revenueSeries,
            borderColor: '#c8a96e',
            backgroundColor: revenueGradient,
            borderWidth: 2.5,
            fill: true,
            tension: 0.45,
            pointRadius: 0,
            pointHoverRadius: 5,
            pointHoverBackgroundColor: '#c8a96e',
            pointHoverBorderColor: '#fff',
            pointHoverBorderWidth: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#1a1a18',
              padding: 10,
              cornerRadius: 8,
              displayColors: false,
              callbacks: {
                label: (ctx) => '₹' + ctx.parsed.y.toLocaleString('en-IN')
              }
            }
          },
          scales: {
            x: {
              grid: { display: false },
              border: { display: false },
              ticks: { color: '#7a7870', font: { family: 'DM Sans', size: 12 } }
            },
            y: {
              grid: { color: '#e8e6e0', drawTicks: false },
              border: { display: false },
              ticks: {
                color: '#7a7870',
                font: { family: 'DM Sans', size: 12 },
                callback: (v) => '₹' + (v >= 1000 ? (v / 1000) + 'k' : v)
              }
            }
          }
        }
      });

      // Orders Volume (bar)
      const ordersCtx = document.getElementById('ordersChart').getContext('2d');
      new Chart(ordersCtx, {
        type: 'bar',
        data: {
          labels: chartLabels,
          datasets: [{
            label: 'Orders',
            data: ordersSeries,
            backgroundColor: '#5b52e8',
            borderRadius: 6,
            maxBarThickness: 42
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#1a1a18',
              padding: 10,
              cornerRadius: 8,
              displayColors: false
            }
          },
          scales: {
            x: {
              grid: { display: false },
              border: { display: false },
              ticks: { color: '#7a7870', font: { family: 'DM Sans', size: 12 } }
            },
            y: {
              grid: { color: '#e8e6e0', drawTicks: false },
              border: { display: false },
              ticks: { color: '#7a7870', font: { family: 'DM Sans', size: 12 } }
            }
          }
        }
      });

      // ── Date helpers ──────────────────────────────────────────────────────
      function todayStr() {
        const d = new Date();
        return d.toISOString().slice(0, 10); // YYYY-MM-DD
      }

      const customStart = document.getElementById('customStart');
      const customEnd   = document.getElementById('customEnd');
      const dateError   = document.getElementById('dateError');

      // Clamp both inputs so the calendar never shows future dates
      customStart.max = todayStr();
      customEnd.max   = todayStr();

      // When 'From' changes → update 'To' minimum so To ≥ From
      customStart.addEventListener('change', function () {
        customEnd.min = this.value || '';
        // If current 'To' is before new 'From', clear it
        if (customEnd.value && customEnd.value < this.value) {
          customEnd.value = '';
        }
        dateError.style.display = 'none';
      });

      customEnd.addEventListener('change', function () {
        dateError.style.display = 'none';
      });

      // ── Range Tabs ────────────────────────────────────────────────────────
      const rangeTabs    = document.getElementById('rangeTabs');
      const customRangeBar = document.getElementById('customRangeBar');

      // Mark the active tab based on server-provided currentRange
      document.querySelectorAll('.range-tab').forEach(t => {
        t.classList.toggle('active', t.dataset.range === currentRange);
      });

      rangeTabs.addEventListener('click', function (e) {
        const btn = e.target.closest('.range-tab');
        if (!btn) return;
        document.querySelectorAll('.range-tab').forEach(t => t.classList.remove('active'));
        btn.classList.add('active');
        const range = btn.dataset.range;

        if (range === 'custom') {
          customRangeBar.classList.add('visible');
          return;
        }
        customRangeBar.classList.remove('visible');
        location.href = `?range=${range}`;
      });

      // ── Apply Custom Range (with validation) ──────────────────────────────
      document.getElementById('applyCustomRange').addEventListener('click', function () {
        const from  = customStart.value;
        const to    = customEnd.value;
        const today = todayStr();

        dateError.style.display = 'none';

        if (!from || !to) {
          dateError.textContent = 'Please select both From and To dates.';
          dateError.style.display = 'inline';
          return;
        }
        if (from > today) {
          dateError.textContent = 'From date cannot be in the future.';
          dateError.style.display = 'inline';
          return;
        }
        if (to > today) {
          dateError.textContent = 'To date cannot be in the future.';
          dateError.style.display = 'inline';
          return;
        }
        if (to < from) {
          dateError.textContent = '"To" date must be on or after the "From" date.';
          dateError.style.display = 'inline';
          return;
        }

        location.href = `?range=custom&startDate=${from}&endDate=${to}`;
      });

      // On page load: restore the min on 'To' if From already has a value
      if (customStart.value) {
        customEnd.min = customStart.value;
      }

      // Download Dropdown
      const btnDownloadToggle = document.getElementById('btnDownloadToggle');
      const downloadMenu = document.getElementById('downloadMenu');

      btnDownloadToggle.addEventListener('click', function (e) {
        e.stopPropagation();
        downloadMenu.classList.toggle('open');
      });
      document.addEventListener('click', () => downloadMenu.classList.remove('open'));

      function currentQueryString() {
        return new URLSearchParams(location.search).toString();
      }

      document.getElementById('downloadExcel').addEventListener('click', function (e) {
        e.preventDefault();
        window.location.href = `/admin/sales-reports/export?${currentQueryString()}`;
      });

      document.getElementById('downloadPdf').addEventListener('click', function (e) {
        e.preventDefault();
        window.location.href = `/admin/sales-reports/export/pdf?${currentQueryString()}`;
      });
    </script>
</body>

</html>
