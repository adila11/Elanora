<style>
  footer {
    background: #f9f5ef;
    border-top: 1px solid #e8ddd0;
    padding: 60px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }

  .footer-col h4 {
    font-size: 14px;
    margin-bottom: 10px;
  }

  .footer-col ul {
    list-style: none;
  }

  .footer-col ul li a {
    text-decoration: none;
    color: #8c7f70;
    font-size: 12px;
  }

  .footer-col ul li a:hover {
    color: #c8972a;
  }

  .footer-bottom {
    margin-top: 30px;
    font-size: 12px;
    color: #8c7f70;
    text-align: center;
  }
  footer {
      background: var(--cream);
      border-top: 1px solid var(--border);
      padding: 60px 60px 30px;
    }
    .footer-grid {
      display: grid; grid-template-columns: 2fr 1fr 1.2fr 1.6fr;
      gap: 40px; margin-bottom: 40px;
    }
    .footer-brand .nav-logo { margin-bottom: 14px; display: inline-flex; }
    .footer-brand p { font-size: 12.5px; color: var(--muted); line-height: 1.8; max-width: 220px; }
    .footer-socials { display: flex; gap: 12px; margin-top: 18px; }
    .social-icon {
      width: 32px; height: 32px; border-radius: 8px;
      border: 1px solid var(--border); display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: border-color .2s, background .2s;
    }
    .social-icon:hover { border-color: var(--gold); background: var(--gold-pale); }
    .social-icon svg { width: 14px; height: 14px; stroke: var(--muted); fill: none; stroke-width: 1.5; }
    .footer-col h4 { font-size: 13px; font-weight: 500; color: var(--dark); margin-bottom: 16px; }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .footer-col ul li a { font-size: 12.5px; color: var(--muted); text-decoration: none; transition: color .2s; }
    .footer-col ul li a:hover { color: var(--gold); }
    .newsletter-input-wrap { display: flex; margin-top: 6px; }
    .newsletter-input-wrap input {
      flex: 1; padding: 10px 14px; font-size: 12px;
      border: 1px solid var(--border); border-radius: 8px 0 0 8px;
      background: #fff; color: var(--text); outline: none;
    }
    .newsletter-input-wrap input::placeholder { color: var(--muted); }
    .newsletter-input-wrap button {
      padding: 10px 18px; background: var(--gold); color: #fff;
      border: none; border-radius: 0 8px 8px 0; font-size: 12px;
      cursor: pointer; font-weight: 500; transition: background .2s;
    }
    .newsletter-input-wrap button:hover { background: #a87820; }
    .footer-bottom {
      border-top: 1px solid var(--border); padding-top: 20px;
      display: flex; justify-content: space-between; align-items: center;
    }
    .footer-bottom p { font-size: 11.5px; color: var(--muted); }
    .footer-bottom-links { display: flex; gap: 20px; }
    .footer-bottom-links a { font-size: 11.5px; color: var(--muted); text-decoration: none; }
    .footer-bottom-links a:hover { color: var(--gold); }

</style>

<footer>
  <div class="footer-grid">
    <div class="footer-brand">
      <a class="nav-logo" href="#">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;fill:var(--gold)"><polygon points="12,2 15.5,8.5 22,9.3 17,14 18.4,21 12,17.8 5.6,21 7,14 2,9.3 8.5,8.5"/></svg>
        Elanora
      </a>
      <p>Crafting timeless elegance and radiant refinement for those who appreciate the finer things in life.</p>
      <div class="footer-socials">
        <div class="social-icon">
          <svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
        </div>
        <div class="social-icon">
          <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="var(--muted)"/></svg>
        </div>
        <div class="social-icon">
          <svg viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 01-3.14 1.53A4.48 4.48 0 0016 2.5a4.5 4.5 0 00-4.5 4.5v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
        </div>
        <div class="social-icon">
          <svg viewBox="0 0 24 24"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
        </div>
      </div>
    </div>
    <div class="footer-col">
      <h4>Quick Links</h4>
      <ul>
        <li><a href="#">Shop Collection</a></li>
        <li><a href="#">About Us</a></li>
        <li><a href="#">Our Story</a></li>
        <li><a href="#">Contact Us</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Customer Service</h4>
      <ul>
        <li><a href="#">FAQ</a></li>
        <li><a href="#">Shipping & Returns</a></li>
        <li><a href="#">Jewel Care</a></li>
        <li><a href="#">Terms & Conditions</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Newsletter</h4>
      <p style="font-size:12px;color:var(--muted);line-height:1.7;margin-bottom:12px;">Subscribe to receive updates, access to exclusive deals, and more.</p>
      <div class="newsletter-input-wrap">
        <input type="email" placeholder="Enter your email..."/>
        <button>Subscribe</button>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© 2026 Elanora Jewellery. All rights reserved.</p>
    <div class="footer-bottom-links">
      <a href="#">Privacy Policy</a>
      <a href="#">Terms of Service</a>
    </div>
  </div>
</footer>

<%- include('flash') %>