<script src="https://cdn.tailwindcss.com"></script>

<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          gold: '#c49a2a',
          border: '#e8e0d0',
          text: '#2c2c2c',
          cream: '#fdfaf5'
        }
      }
    }
  }
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&display=swap');

  .nav-logo {
    font-family: 'Cormorant Garamond', serif;
  }

  .dropdown {
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .dropdown.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: all;
  }

  .icon-btn svg {
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .icon-btn:hover svg {
    color: #c49a2a;
    transform: scale(1.08);
  }

  .badge {
    transform: translate(35%, -35%);
  }
</style>

<nav class="fixed top-0 left-0 w-full z-[100] bg-cream/95 backdrop-blur-lg border-b border-border">
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-16 h-[70px] flex items-center justify-between">

    <!-- Logo (wordmark Only) -->
    <a href="/"
      class="nav-logo text-2xl sm:text-[28px] font-semibold text-gold tracking-wide shrink-0 hover:opacity-80 transition-opacity">
      Elanora
    </a>

    <!-- Desktop Nav Links — Absolutely Centered -->
    <ul class="hidden md:flex items-center gap-8 absolute left-1/2 -translate-x-1/2">
      <li><a href="/" class="text-sm text-text hover:text-gold transition-colors">Home</a></li>
      <li><a href="/shop" class="text-sm text-text hover:text-gold transition-colors">Shop</a></li>
      <li><a href="/about" class="text-sm text-text hover:text-gold transition-colors">About</a></li>
      <li><a href="/contact" class="text-sm text-text hover:text-gold transition-colors">Contact</a></li>
    </ul>

    <!-- Right Actions -->
    <div class="flex items-center gap-5 shrink-0">

      <% if (locals.user) { %>

        <% const wishlistCount=locals.wishlistCount || 0 %>
          <% const cartCount=locals.cartCount || 0 %>

            <!-- Wishlist -->
            <button onclick="location.href='/wishlist'" class="icon-btn relative" aria-label="Wishlist">
              <svg class="w-5 h-5 text-text" fill="none" stroke="currentColor" stroke-width="1.6"
                stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path
                  d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78a5.5 5.5 0 000-7.78z" />
              </svg>
              <% if (wishlistCount> 0) { %>
                <span id="wishlist-badge"
                  class="badge absolute top-0 right-0 min-w-[16px] h-4 px-1 flex items-center justify-center rounded-full bg-gold text-white text-[10px] font-semibold leading-none">
                  <%= wishlistCount> 99 ? '99+' : wishlistCount %>
                </span>
                <% } %>
            </button>

            <!-- Cart -->
            <button onclick="location.href='/cart'" class="icon-btn relative" aria-label="Cart">
              <svg class="w-5 h-5 text-text" fill="none" stroke="currentColor" stroke-width="1.6"
                stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M2.5 5H5.5L7 8M7 8H21L18 17H9Z" />
                <circle cx="10" cy="19.3" r="1.5" />
                <circle cx="17" cy="19.3" r="1.5" />
              </svg>
              <% if (cartCount> 0) { %>
                <span id="cart-badge"
                  class="badge absolute top-0 right-0 min-w-[16px] h-4 px-1 flex items-center justify-center rounded-full bg-gold text-white text-[10px] font-semibold leading-none">
                  <%= cartCount> 99 ? '99+' : cartCount %>
                </span>
                <% } %>
            </button>

            <!-- Profile Dropdown -->
            <div class="relative" id="profileWrapper">
              <button id="profileBtn" class="icon-btn flex items-center gap-1 text-text focus:outline-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20 21a8 8 0 10-16 0" />
                  <circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="1.6" fill="none" />
                </svg>
                <svg class="w-3 h-3 transition-transform duration-200" id="profileChevron" fill="none"
                  stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <!-- Dropdown -->
              <div id="profileDropdown"
                class="dropdown absolute right-0 top-[calc(100%+12px)] w-44 bg-white border border-border rounded-xl shadow-lg overflow-hidden">
                <a href="/profile"
                  class="flex items-center gap-2.5 px-4 py-3 text-sm text-text hover:bg-cream hover:text-gold transition-colors">
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 21a8 8 0 10-16 0" />
                    <circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="1.6" fill="none" />
                  </svg>
                  Profile
                </a>
                <a href="/orders"
                  class="flex items-center gap-2.5 px-4 py-3 text-sm text-text hover:bg-cream hover:text-gold transition-colors">
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                  My Orders
                </a>
                <div class="h-px bg-border mx-3"></div>
                <button onclick="location.href='/logout'"
                  class="w-full flex items-center gap-2.5 px-4 py-3 text-sm text-red-500 hover:bg-red-50 transition-colors">
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2h5a2 2 0 012 2v1" />
                  </svg>
                  Logout
                </button>
              </div>
            </div>

            <% } else { %>

              <div class="hidden sm:flex gap-2">
                <button onclick="location.href='/login'"
                  class="px-4 py-1.5 text-xs border border-border rounded-md hover:text-gold hover:border-gold transition-colors">
                  Login
                </button>
                <button onclick="location.href='/signup'"
                  class="px-4 py-1.5 text-xs bg-gold text-white rounded-md hover:bg-[#a87820] transition-colors">
                  Sign Up
                </button>
              </div>

              <% } %>

                <!-- Hamburger (mobile) -->
                <button id="hamburgerBtn" class="md:hidden">
                  <svg id="hamburgerIcon" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                  </svg>
                </button>

    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobileMenu" class="hidden md:hidden bg-white border-t border-border px-6 py-5">
    <div class="flex flex-col gap-5 text-sm text-text">
      <a href="/" class="hover:text-gold transition-colors">Home</a>
      <a href="/shop" class="hover:text-gold transition-colors">Shop</a>
      <a href="/about" class="hover:text-gold transition-colors">About</a>
      <a href="/contact" class="hover:text-gold transition-colors">Contact</a>
      <% if (locals.user) { %>
        <div class="h-px bg-border"></div>
        <a href="/wishlist" class="flex items-center justify-between hover:text-gold transition-colors">
          Wishlist
          <% if ((locals.wishlistCount || 0)> 0) { %>
            <span class="text-xs bg-gold text-white rounded-full px-2 py-0.5">
              <%= locals.wishlistCount %>
            </span>
            <% } %>
        </a>
        <a href="/cart" class="flex items-center justify-between hover:text-gold transition-colors">
          Cart
          <% if ((locals.cartCount || 0)> 0) { %>
            <span class="text-xs bg-gold text-white rounded-full px-2 py-0.5">
              <%= locals.cartCount %>
            </span>
            <% } %>
        </a>
        <a href="/orders" class="hover:text-gold transition-colors">My Orders</a>
        <button onclick="location.href='/logout'" class="text-left text-red-500">Logout</button>
        <% } else { %>
          <div class="flex flex-col gap-3 pt-3">
            <button onclick="location.href='/login'" class="border border-border py-2 rounded-md">Login</button>
            <button onclick="location.href='/signup'" class="bg-gold text-white py-2 rounded-md">Sign Up</button>
          </div>
          <% } %>
    </div>
  </div>
</nav>

<div class="h-[70px]"></div>

<script>
  // Profile Dropdown Toggle
  const profileBtn = document.getElementById('profileBtn')
  const profileDropdown = document.getElementById('profileDropdown')
  const profileChevron = document.getElementById('profileChevron')

  if (profileBtn && profileDropdown && profileChevron) {
    profileBtn.addEventListener('click', (e) => {
      e.stopPropagation()
      const isOpen = profileDropdown.classList.contains('open')
      profileDropdown.classList.toggle('open', !isOpen)
      profileChevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)'
    })

    document.addEventListener('click', () => {
      profileDropdown.classList.remove('open')
      profileChevron.style.transform = 'rotate(0deg)'
    })
  }

  // Hamburger
  const hamburgerBtn = document.getElementById('hamburgerBtn')
  const mobileMenu = document.getElementById('mobileMenu')
  const hamburgerIcon = document.getElementById('hamburgerIcon')
  let menuOpen = false

  if (hamburgerBtn && mobileMenu && hamburgerIcon) {
    hamburgerBtn.addEventListener('click', () => {
      menuOpen = !menuOpen
      mobileMenu.classList.toggle('hidden', !menuOpen)
      hamburgerIcon.innerHTML = menuOpen
        ? `<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>`
        : `<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>`
    })
  }

  // Active Link Highlighting
  function highlightActiveNav() {
    const currentPath = window.location.pathname;
    const allNavLinks = document.querySelectorAll('nav a[href]');

    allNavLinks.forEach(link => {
      const href = link.getAttribute('href');
      if (!href || href === '#' || link.classList.contains('nav-logo')) return;

      let isActive = false;
      if (href === '/' && currentPath === '/') {
        isActive = true;
      } else if (href !== '/') {
        if (currentPath === href || currentPath.startsWith(href + '/')) {
          isActive = true;
        } else if (href === '/shop' && (currentPath.startsWith('/product') || currentPath.startsWith('/category'))) {
          isActive = true;
        }
      }

      if (isActive) {
        link.classList.remove('text-text');
        link.classList.add('text-gold', 'font-semibold');
      }
    });
  }

  // Dynamic Cart Badge Helper
  window.updateCartBadge = function(count) {
    const cartBtn = document.querySelector('button[aria-label="Cart"]');
    if (!cartBtn) return;
    let badge = document.getElementById('cart-badge');
    if (count > 0) {
      if (!badge) {
        badge = document.createElement('span');
        badge.id = 'cart-badge';
        badge.className = 'badge absolute top-0 right-0 min-w-[16px] h-4 px-1 flex items-center justify-center rounded-full bg-gold text-white text-[10px] font-semibold leading-none';
        cartBtn.appendChild(badge);
      }
      badge.textContent = count > 99 ? '99+' : count;
    } else if (badge) {
      badge.remove();
    }
  };

  highlightActiveNav();
  document.addEventListener('DOMContentLoaded', highlightActiveNav);
</script>