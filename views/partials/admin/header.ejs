<!-- partials/admin/header.ejs -->
<header class="topbar">
  <div class="page-title"><%= title || 'Dashboard' %></div>

  <div class="search-wrap">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"/>
      <line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <input class="search-input" type="text" placeholder="Search..." id="globalSearch">
  </div>

  <div class="topbar-right">
    <!-- Notification Button -->
    <div class="icon-btn" id="notificationBtn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 01-3.46 0"/>
      </svg>
      <span class="notif-dot" id="notifDot"></span>
    </div>

    <!-- User Profile -->
    <div class="user-pill" id="userProfile">
      <div class="avatar">EA</div>
      <div class="user-info">
        <div class="user-name">Elanora Admin</div>
        <div class="user-role">Store Manager</div>
      </div>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--muted)">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </div>
  </div>
</header>